{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vyberstredni",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-03-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "georgeduckling.com/vyberstredni*",
      "zone_name": "georgeduckling.com"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      // Unique integer per Cloudflare account.
      "namespace_id": "4201",
      // At most 5 admin login attempts per minute per IP (per Cloudflare location).
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vyberstredni",
      "database_id": "dd30d9b9-b8c3-43e0-8b30-c21a7ad480cc"
    }
  ]
}
