---
import { siteConfig } from "../../config/site";
import { withBase } from "../../lib/urls";
---

<aside
  id="support-panel"
  transition:persist="support-panel"
  aria-labelledby="support-panel-heading"
  aria-hidden="true"
  inert
  class="fixed right-0 top-1/2 z-50 max-h-[calc(100dvh-2rem)] w-[min(22rem,calc(100vw-1.5rem))] -translate-y-1/2 translate-x-full overflow-y-auto rounded-l-2xl border-2 border-r-0 border-ink bg-background p-6 shadow-2xl transition-transform duration-500 ease-out motion-reduce:transition-none data-[open]:translate-x-0"
>
  <button
    type="button"
    data-support-close
    class="absolute right-3 top-3 grid size-9 place-items-center rounded-full text-xl font-bold text-ink hover:bg-muted"
    aria-label="Zavřít"
  >
    ✕
  </button>
  <h2 id="support-panel-heading" class="pr-8 text-xl font-extrabold text-ink">Podpořte tento projekt</h2>
  <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
    Web vyberstřední vytváří a provozuje {siteConfig.author} jako nekomerční projekt. Pokud vám pomohl a chcete
    podpořit jeho další rozvoj, můžete přispět libovolnou částkou pomocí QR kódu.
  </p>
  <img
    src={withBase("/images/support-qr.jpg")}
    alt="QR kód pro platbu příspěvku"
    width="600"
    height="600"
    loading="lazy"
    class="mx-auto mt-4 w-48 rounded-lg border border-ink/20 bg-white"
  />
  <p class="mt-3 text-center text-sm font-semibold text-ink">Děkuji za každou podporu.</p>
</aside>

<script>
  const DISMISSED_KEY = "vyberstredni-support-dismissed";
  const SHOW_DELAY_MS = 4000;

  const panel = () => document.getElementById("support-panel");

  const setOpen = (open: boolean) => {
    const element = panel();
    if (!element) return;
    element.toggleAttribute("data-open", open);
    element.toggleAttribute("inert", !open);
    element.setAttribute("aria-hidden", String(!open));
  };

  const wasDismissed = () => {
    try {
      return window.sessionStorage.getItem(DISMISSED_KEY) === "1";
    } catch {
      return false;
    }
  };

  const rememberDismissed = () => {
    try {
      window.sessionStorage.setItem(DISMISSED_KEY, "1");
    } catch {
      // Without storage the panel may show again on the next visit; nothing else depends on it.
    }
  };

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    if (event.target.closest("[data-support-close]")) {
      setOpen(false);
      rememberDismissed();
    } else if (event.target.closest("[data-support-open]")) {
      setOpen(true);
    }
  });

  if (!wasDismissed()) window.setTimeout(() => setOpen(true), SHOW_DELAY_MS);
</script>
