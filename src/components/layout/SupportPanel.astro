---
import { siteConfig } from "../../config/site";
import { withBase } from "../../lib/urls";
---

<div id="support" transition:persist="support-panel" class="group">
  <!-- Small on phones and hidden there until the visitor has spent a minute on the site (see the script below). -->
  <button
    type="button"
    data-support-open
    data-support-tab
    hidden
    aria-controls="support-panel"
    aria-expanded="false"
    class="fixed right-0 top-1/2 z-40 -translate-y-1/2 rounded-l-md border border-r-0 border-ink bg-primary px-0.5 py-2 text-[0.5625rem] font-bold uppercase tracking-wider text-white opacity-80 shadow transition-transform duration-300 [writing-mode:vertical-rl] hover:pr-1 motion-reduce:transition-none group-data-[open]:translate-x-full sm:rounded-l-xl sm:border-2 sm:px-2 sm:py-4 sm:text-sm sm:tracking-widest sm:opacity-100 sm:shadow-lg sm:hover:pr-3"
  >
    <span class="inline-block rotate-180">Podpora projektu</span>
  </button>
  <aside
    id="support-panel"
    aria-labelledby="support-panel-heading"
    aria-hidden="true"
    inert
    class="fixed right-0 top-1/2 z-50 w-[min(17rem,calc(100vw-1.5rem))] -translate-y-1/2 translate-x-full overflow-y-auto rounded-l-2xl border-2 border-r-0 border-ink bg-background px-4 pb-4 shadow-2xl transition-transform duration-500 ease-out motion-reduce:transition-none group-data-[open]:translate-x-0"
    style="max-height: calc(100vh - 2rem); max-height: calc(100dvh - 2rem);"
  >
    <!-- Sticky, so the close button stays on screen even when the panel scrolls (in-app browsers, small phones). -->
    <div class="sticky top-0 z-10 -mr-2 flex h-0 justify-end overflow-visible pt-2">
      <button
        type="button"
        data-support-close
        class="grid size-10 place-items-center rounded-full border-2 border-ink bg-background text-lg font-bold text-ink hover:bg-muted"
        aria-label="Zavřít"
      >
        ✕
      </button>
    </div>
    <h2 id="support-panel-heading" class="mt-4 pr-11 text-lg font-extrabold text-ink">Podpoříte tento projekt?</h2>
    <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
      Web jaknaskolu.cz vytvářím a provozuji ze svých prostředků jako nekomerční projekt. Pokud vám pomohl a chcete podpořit
      jeho další rozvoj, budu rád za příspěvek v libovolné výši pomocí QR kódu nebo převodem na účet.
    </p>
    <img
      src={withBase(siteConfig.support.qrImage)}
      alt={`QR kód pro platbu příspěvku na účet ${siteConfig.support.account}`}
      width="600"
      height="600"
      loading="lazy"
      class="mx-auto mt-3 w-32 rounded-lg border border-ink/20 bg-white"
    />
    <p class="mt-2 text-center text-xs text-muted-foreground">
      Číslo účtu<br />
      <span class="select-all text-base font-bold text-ink">{siteConfig.support.account}</span>
    </p>
    <p class="mt-2 text-center text-sm font-semibold text-ink">Děkuji za každou podporu.</p>
    <p class="font-hand mt-1 text-center text-xl text-ink">{siteConfig.author}</p>
  </aside>
</div>

<script>
  /** After the quiz results appear, give the visitor time to read them before asking for support. */
  const OFFER_DELAY_MS = 8000;
  const OFFERED_KEY = "vyberstredni-support-offered";
  let offerTimer: number | undefined;

  const setOpen = (open: boolean) => {
    const root = document.getElementById("support");
    const panel = document.getElementById("support-panel");
    if (!root || !panel) return;
    window.clearTimeout(offerTimer);
    root.toggleAttribute("data-open", open);
    panel.toggleAttribute("inert", !open);
    panel.setAttribute("aria-hidden", String(!open));
    root.querySelector("[data-support-open]")?.setAttribute("aria-expanded", String(open));
  };

  const offeredThisVisit = () => {
    try {
      return sessionStorage.getItem(OFFERED_KEY) === "1";
    } catch {
      return false;
    }
  };

  const markOffered = () => {
    try {
      sessionStorage.setItem(OFFERED_KEY, "1");
    } catch {
      // Without storage the panel may be offered again after another finished quiz; that is acceptable.
    }
  };

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    if (event.target.closest("[data-support-close]")) setOpen(false);
    else if (event.target.closest("[data-support-open]")) setOpen(true);
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && document.getElementById("support")?.hasAttribute("data-open")) setOpen(false);
  });

  // Never opens by itself on page load (it covered the page for visitors from ads); the quiz page asks for it
  // once its results are shown, at most once per visit. The "Podpora projektu" tab is always there.
  document.addEventListener("support:offer", () => {
    if (offeredThisVisit()) return;
    markOffered();
    window.clearTimeout(offerTimer);
    offerTimer = window.setTimeout(() => setOpen(true), OFFER_DELAY_MS);
  });
  // A pending offer must not open the panel over the next page.
  document.addEventListener("astro:before-swap", () => window.clearTimeout(offerTimer));

  /**
   * The side tab: on phones it appears only after a minute on the site (counted from the first page of the visit,
   * so navigating does not restart it); on larger screens right away. The panel persists across navigations.
   */
  const TAB_DELAY_MS = 60_000;
  const TAB_SINCE_KEY = "vyberstredni-support-tab-since";
  const phone = window.matchMedia("(max-width: 639px)");

  const visitStart = () => {
    try {
      const stored = Number(sessionStorage.getItem(TAB_SINCE_KEY));
      if (stored > 0) return stored;
      const now = Date.now();
      sessionStorage.setItem(TAB_SINCE_KEY, String(now));
      return now;
    } catch {
      return Date.now();
    }
  };

  const showTab = () => document.querySelector<HTMLElement>("[data-support-tab]")?.removeAttribute("hidden");
  const tabDelay = Math.max(0, TAB_DELAY_MS - (Date.now() - visitStart()));
  if (!phone.matches || tabDelay === 0) showTab();
  else {
    window.setTimeout(showTab, tabDelay);
    phone.addEventListener("change", (event) => {
      if (!event.matches) showTab();
    });
  }
</script>
