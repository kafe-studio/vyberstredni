---
import { siteConfig } from "../../config/site";
import { withBase } from "../../lib/urls";
---

<div id="support" transition:persist="support-panel" class="group">
  <button
    type="button"
    data-support-open
    aria-controls="support-panel"
    aria-expanded="false"
    class="fixed right-0 top-1/2 z-40 -translate-y-1/2 rounded-l-xl border-2 border-r-0 border-ink bg-primary px-2 py-4 text-sm font-bold uppercase tracking-widest text-white shadow-lg transition-transform duration-300 [writing-mode:vertical-rl] hover:pr-3 motion-reduce:transition-none group-data-[open]:translate-x-full"
  >
    <span class="inline-block rotate-180">Podpora</span>
  </button>
  <aside
    id="support-panel"
    aria-labelledby="support-panel-heading"
    aria-hidden="true"
    inert
    class="fixed right-0 top-1/2 z-50 max-h-[calc(100dvh-2rem)] w-[min(22rem,calc(100vw-1.5rem))] -translate-y-1/2 translate-x-full overflow-y-auto rounded-l-2xl border-2 border-r-0 border-ink bg-background p-6 shadow-2xl transition-transform duration-500 ease-out motion-reduce:transition-none group-data-[open]:translate-x-0"
  >
    <button
      type="button"
      data-support-close
      class="absolute right-3 top-3 grid size-9 place-items-center rounded-full text-xl font-bold text-ink hover:bg-muted"
      aria-label="Zavřít"
    >
      ✕
    </button>
    <h2 id="support-panel-heading" class="pr-8 text-xl font-extrabold text-ink">Podpořte tento projekt</h2>
    <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
      Web jaknaskolu.cz vytváří a provozuje {siteConfig.author} ze svých prostředků jako nekomerční projekt. Pokud vám pomohl a chcete
      podpořit jeho další rozvoj, můžete přispět libovolnou částkou pomocí QR kódu nebo převodem na účet.
    </p>
    <img
      src={withBase(siteConfig.support.qrImage)}
      alt={`QR kód pro platbu příspěvku na účet ${siteConfig.support.account}`}
      width="600"
      height="600"
      loading="lazy"
      class="mx-auto mt-4 w-44 rounded-lg border border-ink/20 bg-white"
    />
    <p class="mt-3 text-center text-sm text-muted-foreground">
      Číslo účtu<br />
      <span class="select-all text-lg font-bold text-ink">{siteConfig.support.account}</span>
    </p>
    <p class="mt-3 text-center text-sm font-semibold text-ink">Děkuji za každou podporu.</p>
  </aside>
</div>

<script>
  const SHOW_DELAY_MS = 3000;
  let showTimer: number | undefined;

  const setOpen = (open: boolean) => {
    const root = document.getElementById("support");
    const panel = document.getElementById("support-panel");
    if (!root || !panel) return;
    window.clearTimeout(showTimer);
    root.toggleAttribute("data-open", open);
    panel.toggleAttribute("inert", !open);
    panel.setAttribute("aria-hidden", String(!open));
    root.querySelector("[data-support-open]")?.setAttribute("aria-expanded", String(open));
  };

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    if (event.target.closest("[data-support-close]")) setOpen(false);
    else if (event.target.closest("[data-support-open]")) setOpen(true);
  });

  // Slides out on every page, including client-side navigations; the tab stays once it is closed.
  document.addEventListener("astro:page-load", () => {
    window.clearTimeout(showTimer);
    showTimer = window.setTimeout(() => setOpen(true), SHOW_DELAY_MS);
  });
</script>
