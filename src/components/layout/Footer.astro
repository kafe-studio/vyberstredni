---
import { siteConfig } from "../../config/site";
import { withBase } from "../../lib/urls";
import Character from "../Character.astro";

interface Props {
  /** The banner advertises the quiz; pages like the quiz itself or the admin turn it off. */
  showQuizBanner?: boolean;
}

const { showQuizBanner = true } = Astro.props;
---

<footer class="mt-24">
  {showQuizBanner && (
    <section class="site-student-banner mb-16" aria-labelledby="site-student-banner-heading">
      <div>
        <span class="sticker-note -rotate-2 bg-lime">Nevíš, kam dál?</span>
        <h2 id="site-student-banner-heading" class="mt-4 text-3xl font-extrabold md:text-4xl">Zjisti, co ti sedí.</h2>
        <p class="mt-3 max-w-md text-muted-foreground">
          Pět krátkých otázek a hned uvidíš obory a školy, které by tě mohly bavit.
        </p>
        <a href={withBase(siteConfig.quizLink.href)} class="btn-primary mt-6">Udělat test zájmů →</a>
      </div>
      <div class="relative isolate mx-auto w-full max-w-[20rem]" aria-hidden="true">
        <div class="blob inset-x-4 inset-y-6 bg-mint"></div>
        <Character name="duo-vest-cap" class="character-float relative w-full" />
      </div>
    </section>
  )}
  <div class="border-t-2 border-ink bg-ink text-white">
    <div class="mx-auto grid max-w-7xl gap-10 px-6 py-12 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr] lg:px-8">
      <div>
        <p class="font-display text-xl font-extrabold">🎒 {siteConfig.name}</p>
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-white/70">{siteConfig.description}</p>
      </div>
      <address class="not-italic" aria-labelledby="footer-contact-heading">
        <h2 id="footer-contact-heading" class="text-xs font-bold uppercase tracking-widest text-white/50">Kontakt</h2>
        <ul class="mt-4 space-y-2 text-sm">
          <li class="font-semibold text-white">{siteConfig.author}</li>
          <li>
            <a href={siteConfig.operator.url} target="_blank" rel="noopener" class="text-sun hover:underline">{siteConfig.operator.name}</a>
          </li>
          <li><a href={`mailto:${siteConfig.email}`} class="text-white/80 hover:text-white hover:underline">✉️ {siteConfig.email}</a></li>
          <li><a href={`tel:${siteConfig.phone.replace(/\s+/g, "")}`} class="text-white/80 hover:text-white hover:underline">📞 {siteConfig.phone}</a></li>
          <li class="flex gap-4 pt-1">
            <a href={siteConfig.socialLinks.instagram} target="_blank" rel="noopener" class="text-white/80 hover:text-white hover:underline">Instagram</a>
            <a href={siteConfig.socialLinks.facebook} target="_blank" rel="noopener" class="text-white/80 hover:text-white hover:underline">Facebook</a>
          </li>
        </ul>
      </address>
      <section aria-labelledby="footer-projects-heading">
        <h2 id="footer-projects-heading" class="text-xs font-bold uppercase tracking-widest text-white/50">Další naše weby</h2>
        <ul class="mt-4 space-y-2 text-sm">
          {siteConfig.otherProjects.map((project) => (
            <li>
              {project.url
                ? <a href={project.url} target="_blank" rel="noopener" class="font-semibold text-white/90 hover:text-white hover:underline">{project.name}</a>
                : <span class="font-semibold text-white/90">{project.name}</span>}
              {project.description && <span class="block text-xs text-white/50">{project.description}</span>}
            </li>
          ))}
        </ul>
      </section>
      <nav aria-labelledby="footer-nav-heading">
        <h2 id="footer-nav-heading" class="text-xs font-bold uppercase tracking-widest text-white/50">Navigace</h2>
        <ul class="mt-4 space-y-2 text-sm font-semibold">
          <li><a href={withBase(siteConfig.quizLink.href)} class="text-sun hover:underline">{siteConfig.quizLink.text}</a></li>
          {siteConfig.navLinks.map((link) => (
            <li><a href={withBase(link.href)} class="text-white/80 hover:text-white hover:underline">{link.text}</a></li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="border-t border-white/10 px-6 py-5 text-center text-xs text-white/50">
      &copy; {new Date().getFullYear()} {siteConfig.author}, <a href={siteConfig.operator.url} target="_blank" rel="noopener" class="underline hover:text-white">{siteConfig.operator.name}</a> · Data: Rejstřík škol MŠMT ·
      Ilustrace: <a href="https://www.freepik.com" target="_blank" rel="noopener" class="underline hover:text-white">Designed by Freepik</a>
    </div>
  </div>
</footer>
