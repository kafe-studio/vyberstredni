---
import { siteConfig } from "../../config/site";
import { withBase } from "../../lib/urls";

const isAdminPage = Astro.url.pathname.includes("/admin");
---

<footer class="border-t border-border mt-32">
  {!isAdminPage && (
    <section class="site-student-banner" aria-labelledby="site-student-banner-heading">
      <div class="site-student-banner-copy">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">Pro další krok</p>
        <h2 id="site-student-banner-heading" class="mt-3 text-2xl font-black md:text-3xl">Vyber si školu po svém.</h2>
        <p class="mt-3 max-w-xl text-sm leading-6 text-muted-foreground">
          Zájmy, obory, skutečné školy — začni tím, co tě baví.
        </p>
        <a href={withBase("/test/")} class="btn-primary mt-5">Vyzkoušet test</a>
        <p class="mt-4 text-xs text-muted-foreground">
          Fotografie studentů: <a class="underline decoration-dotted underline-offset-2 hover:text-foreground" href="https://unsplash.com/license" target="_blank" rel="noreferrer">Unsplash – volně k použití</a>
        </p>
      </div>
      <div class="site-student-stickers" aria-label="Studenti společně studují a objevují své zájmy">
        <div class="site-student-sticker site-student-sticker-left">
          <img
            src="https://images.unsplash.com/photo-1517486808906-6ca8b3f04846?auto=format&fit=crop&w=700&q=85"
            alt="Studenti spolupracují na školním projektu"
            width="700"
            height="900"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="site-student-sticker site-student-sticker-main">
          <img
            src="https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=900&q=85"
            alt="Skupina studentů, kteří společně studují"
            width="900"
            height="1200"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="site-student-sticker site-student-sticker-right">
          <img
            src="https://images.unsplash.com/photo-1529390079861-591de354faf5?auto=format&fit=crop&w=700&q=85"
            alt="Student při studiu"
            width="700"
            height="900"
            loading="lazy"
            decoding="async"
          />
        </div>
        <span class="site-student-note" aria-hidden="true">Tvoje budoucnost ✦</span>
      </div>
    </section>
  )}
  <div class="mx-auto max-w-7xl px-6 py-12 md:py-16 lg:px-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <div>
        <p class="text-lg font-bold mb-4">{siteConfig.name}</p>
        <p class="text-sm text-muted-foreground max-w-sm leading-relaxed">{siteConfig.description}</p>
      </div>
      <nav aria-label="Navigace v paticce">
        <h3 class="text-xs font-bold uppercase tracking-widest text-muted-foreground mb-4">Navigace</h3>
        <ul class="space-y-3">
          {siteConfig.navLinks.map((link) => (
            <li><a href={withBase(link.href)} class="text-sm text-foreground/70 hover:text-primary transition-colors">{link.text}</a></li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="mt-12 border-t border-border pt-8 text-center text-xs text-muted-foreground">
      &copy; {new Date().getFullYear()} {siteConfig.author}
    </div>
  </div>
</footer>
