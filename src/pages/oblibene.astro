---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import Character from "../components/Character.astro";
import { withBase } from "../lib/urls";

const metadata = {
  title: "Oblíbené školy",
  description: "Školy, které sis uložil/a srdíčkem. Na jednom místě a připravené k porovnání.",
};
---

<BaseLayout {metadata}>
  <section class="px-6 pb-16 pt-28 md:pt-32">
    <div class="mx-auto max-w-6xl">
      <header class="mb-8 flex items-end justify-between gap-6">
        <div>
          <span class="sticker-note -rotate-2 bg-pink text-ink">♥ <span id="favorite-total">0</span> uložených</span>
          <h1 class="mt-4 text-4xl font-extrabold md:text-6xl">Moje oblíbené</h1>
          <p class="mt-3 text-lg text-muted-foreground">Školy, které sis uložil/a srdíčkem.</p>
        </div>
        <div class="relative isolate hidden w-36 shrink-0 sm:block md:w-44">
          <div class="blob inset-x-0 bottom-0 top-10 bg-pink/25"></div>
          <Character name="hoodie" class="character-float relative w-full" />
        </div>
      </header>

      <p id="favorite-status" class="mb-4 text-sm text-muted-foreground" aria-live="polite">Načítám…</p>

      <div id="favorite-empty" class="track-card grid items-center gap-6 bg-peach p-8 md:grid-cols-[1fr_auto]" hidden>
        <div>
          <h2 class="text-2xl font-extrabold">Zatím tu nic není</h2>
          <p class="mt-2 text-muted-foreground">U každé školy v katalogu klikni na srdíčko ♡ a objeví se tady.</p>
          <a href={withBase("/skoly/")} class="btn-primary mt-5">Projít katalog škol</a>
        </div>
        <Character name="bun" class="mx-auto h-44 w-auto md:h-52" />
      </div>

      <div id="favorite-grid" class="grid gap-4 md:grid-cols-2 xl:grid-cols-3"></div>
    </div>
  </section>

  <script>
    import { withBase } from "../lib/urls";
    import { escapeHtml, getFavorites, loadSchools, setFavorites, type SchoolSummary } from "../lib/school-data";

    document.addEventListener("astro:page-load", () => {
      const favoriteGrid = document.getElementById("favorite-grid");
      const emptyState = document.getElementById("favorite-empty");
      if (!favoriteGrid || !emptyState) return;

      const favoriteTotal = document.getElementById("favorite-total");
      const status = document.getElementById("favorite-status");
      let schools: SchoolSummary[] = [];
      // Show the stored count immediately, even if the school data fails to load.
      if (favoriteTotal) favoriteTotal.textContent = String(getFavorites().length);

      const renderCard = (school: SchoolSummary) => {
        const badge = school.founderCode === "5" ? "soukromá" : school.founderCode === "6" ? "církevní" : "";
        const href = withBase(`/skoly/${encodeURIComponent(school.id)}/`);
        return `
          <article class="school-card flex flex-col p-5">
            <div class="flex flex-wrap gap-2 text-xs">
              <span class="rounded-full bg-muted px-2.5 py-1 text-muted-foreground">${escapeHtml(school.region)}</span>
              ${badge ? `<span class="rounded-full bg-primary/10 px-2.5 py-1 text-primary">${badge}</span>` : ""}
            </div>
            <a href="${href}" class="mt-3 text-lg font-semibold leading-snug text-ink hover:text-primary">${escapeHtml(school.name)}</a>
            <p class="mt-1 flex-1 text-sm text-muted-foreground">${escapeHtml(school.address)}</p>
            <div class="mt-4 flex items-center justify-between gap-3">
              <a href="${href}" class="text-sm font-semibold text-primary hover:underline">Detail školy →</a>
              <button type="button" data-remove-school="${escapeHtml(school.id)}" class="rounded-full border-2 border-ink bg-white px-3 py-1 text-xs font-semibold hover:bg-pink">Odebrat</button>
            </div>
          </article>`;
      };

      const render = () => {
        const favorites = new Set(getFavorites());
        const items = schools.filter((school) => favorites.has(school.id));
        if (favoriteTotal) favoriteTotal.textContent = String(items.length);
        if (status) status.textContent = "";
        emptyState.hidden = items.length > 0;
        favoriteGrid.innerHTML = items.map(renderCard).join("");
      };

      favoriteGrid.addEventListener("click", (event) => {
        const target = event.target;
        const button = target instanceof Element ? target.closest<HTMLElement>("[data-remove-school]") : null;
        const id = button?.dataset.removeSchool;
        if (!id) return;
        setFavorites(getFavorites().filter((favorite) => favorite !== id));
        render();
      });

      loadSchools()
        .then((list) => {
          schools = list;
          render();
        })
        .catch(() => {
          if (status) status.textContent = "Seznam škol se nepodařilo načíst. Zkus stránku obnovit.";
        });
    });
  </script>
</BaseLayout>
