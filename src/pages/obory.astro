---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import Character from "../components/Character.astro";
import { currentProgramGroups, schoolSnapshotDate, schoolSource } from "../data/schools";
import { programLevel } from "../lib/interest-test";
import { REGIONS } from "../lib/regions";

/** Plain-language label for the level letter (and gymnázium length) in a program code. */
const programKind = (code: string) => {
  const level = programLevel(code);
  if (level === "K") return `gymnázium ${/\/(\d)/.exec(code)?.[1] ?? "4"}leté`;
  // L/5x is a two-year follow-on course after a vocational certificate; other L programs add practical training.
  if (level === "L") return /\/5/.test(code) ? "nástavba po výučním listu" : "s maturitou a odborným výcvikem";
  if (level === "M") return "s maturitou";
  if (level === "J") return "bez maturity a výučního listu";
  if (level === "P") return "konzervatoř";
  if (level === "H" || level === "E") return "výuční list";
  if (level === "C") return "praktická škola";
  return "";
};

const programGroups = currentProgramGroups();

// Only programs some school currently offers; the rendered list and the JSON payload share this order.
const programCatalog = [...programGroups.values()]
  .map((program) => ({ code: program.code, name: program.name, kind: programKind(program.code), schoolIds: [...program.schoolIds] }))
  .sort((left, right) => left.name.localeCompare(right.name, "cs") || left.code.localeCompare(right.code, "cs"));

const metadata = {
  title: "Obory",
  description: "Najdi studijní obor a podívej se, které střední školy v Česku ho nabízejí.",
};
---

<BaseLayout {metadata}>
  <section class="px-6 pb-16 pt-28 md:pt-32">
    <div class="mx-auto max-w-6xl">
      <header class="mb-8">
        <span class="sticker-note -rotate-2 bg-orange text-ink">{programCatalog.length} oborů</span>
        <h1 class="mt-4 text-4xl font-extrabold md:text-6xl">Obory</h1>
        <p class="mt-3 text-lg text-muted-foreground">Vyber obor a uvidíš, které školy ho nabízejí.</p>
      </header>

      <div class="grid gap-6 lg:grid-cols-[22rem_minmax(0,1fr)]">
        <section class="track-card p-4" aria-label="Seznam oborů">
          <label class="block">
            <span class="sr-only">Hledat obor</span>
            <input id="program-search" type="search" class="w-full rounded-[6px] border-2 border-ink/60 bg-card px-4 py-3 text-foreground placeholder:text-muted-foreground" placeholder="🔍 Hledej obor, např. kuchař" />
          </label>
          <select id="program-region" class="mt-3 w-full rounded-[6px] border-2 border-ink/60 bg-card px-3 py-2.5 text-foreground" aria-label="Kraj">
            <option value="">Celé Česko</option>
            {REGIONS.map((region) => <option value={region}>{region}</option>)}
          </select>
          <p id="program-count" class="mt-3 text-xs text-muted-foreground" aria-live="polite">{programCatalog.length} oborů</p>
          <ul id="program-list" class="mt-2 max-h-[32rem] space-y-1 overflow-y-auto pr-1">
            {programCatalog.map((program, index) => (
              <li>
                <button
                  type="button"
                  class="program-option flex w-full items-center justify-between gap-3 rounded-xl border-2 border-transparent px-3 py-2.5 text-left transition hover:bg-lilac aria-pressed:border-ink aria-pressed:bg-sun"
                  data-program-index={index}
                  aria-pressed="false"
                  title={program.code}
                >
                  <span>
                    <span class="block font-medium text-foreground">{program.name}</span>
                    <span class="text-xs text-muted-foreground">{program.kind ? `${program.kind} · ` : ""}{program.code}</span>
                  </span>
                  <span class="program-school-count shrink-0 rounded-full bg-muted px-2 py-0.5 text-xs text-muted-foreground">{program.schoolIds.length}</span>
                </button>
              </li>
            ))}
          </ul>
          <p id="program-empty" class="rounded-xl border border-dashed border-border p-4 text-sm text-muted-foreground" hidden>
            Žádný obor neodpovídá hledání.
          </p>
        </section>

        <section id="program-selection" class="scroll-mt-24 track-card p-5 md:p-6">
          <div id="program-placeholder" class="flex min-h-80 flex-col items-center justify-center gap-4 p-6 text-center">
            <div class="relative isolate w-40">
              <div class="blob inset-x-0 bottom-0 top-10 bg-peach"></div>
              <Character name="bun" class="character-float relative w-full" />
            </div>
            <p class="font-display text-xl font-extrabold">Vyber si obor ze seznamu</p>
            <p class="max-w-xs text-sm text-muted-foreground">Ukážu ti, které školy ho nabízejí a kde je najdeš na mapě.</p>
          </div>
          <div id="program-results" hidden>
            <div class="flex flex-wrap items-start justify-between gap-3">
              <h2 id="selected-program-name" class="text-2xl font-bold" tabindex="-1"></h2>
              <button id="favorite-program-btn" type="button" class="favorite-toggle inline-flex shrink-0 items-center gap-2 rounded-[3px] border border-border bg-card px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.12em] text-muted-foreground transition hover:border-primary/50 hover:text-primary" aria-pressed="false">
                <span class="favorite-icon text-sm" aria-hidden="true">♡</span><span>Oblíbené</span>
              </button>
            </div>
            <p id="selected-program-count" class="mt-1 text-muted-foreground"></p>
            <a href="#program-schools" class="mt-2 inline-block text-sm font-semibold text-primary underline underline-offset-2">↓ Školy s tímto oborem od nejbližší</a>
            <div id="program-outlook" class="mt-5 grid gap-4 md:grid-cols-2" aria-live="polite" hidden>
              <section class="rounded-[3px] border border-border bg-card p-4">
                <h3 class="font-display text-lg font-extrabold">💼 Uplatnění v praxi</h3>
                <p id="outlook-employment" class="mt-2 text-sm leading-6 text-foreground"></p>
                <p id="outlook-occupations-title" class="mt-3 text-xs font-semibold uppercase tracking-wide text-muted-foreground">Navazující povolání</p>
                <ul id="outlook-occupations" class="mt-1.5 flex flex-wrap gap-1.5"></ul>
              </section>
              <section class="rounded-[3px] border border-border bg-card p-4">
                <h3 class="font-display text-lg font-extrabold">📈 Poptávka na trhu práce</h3>
                <p id="outlook-demand-label" class="mt-2"></p>
                <p id="outlook-demand-summary" class="mt-2 text-sm leading-6 text-foreground"></p>
                <p class="mt-3 text-xs leading-5 text-muted-foreground">
                  Hodnocení vychází z nezaměstnanosti čerstvých absolventů evidovaných na úřadech práce v porovnání s průměrem stejného typu vzdělání.
                </p>
              </section>
              <section id="outlook-wages" class="rounded-[3px] border border-border bg-card p-4 md:col-span-2" hidden>
                <h3 class="font-display text-lg font-extrabold">💰 Mzda v typickém povolání</h3>
                <p id="outlook-wages-occupation" class="mt-1 text-sm text-muted-foreground"></p>
                <p id="outlook-wages-current" class="mt-2 text-sm leading-6 text-foreground"></p>
                <div id="outlook-wages-chart"></div>
                <p id="outlook-wages-forecast" class="mt-3 text-sm leading-6 text-foreground"></p>
                <p id="outlook-wages-caveats" class="mt-2 text-xs leading-5 text-muted-foreground"></p>
                <p id="outlook-wages-sources" class="mt-2 text-xs leading-5 text-muted-foreground"></p>
              </section>
              <p id="outlook-sources" class="text-xs leading-5 text-muted-foreground md:col-span-2"></p>
            </div>
            <p id="outlook-status" class="mt-3 text-xs text-muted-foreground" aria-live="polite"></p>
            <div id="program-schools" class="mt-5 scroll-mt-24 rounded-[3px] border border-border bg-card p-4">
              <p class="text-sm font-semibold text-foreground">📍 Odkud dojíždíš? Školy seřadím od nejbližší.</p>
              <div class="mt-2 grid gap-2 sm:grid-cols-[1fr_1fr_auto]">
                <select id="obory-home-region" class="rounded-[6px] border-2 border-ink/60 bg-card px-3 py-2 text-sm text-foreground" aria-label="Kraj, kde bydlíš">
                  <option value="">Vyber kraj…</option>
                  {REGIONS.map((region) => <option value={region}>{region}</option>)}
                </select>
                <select id="obory-home-town" class="rounded-[6px] border-2 border-ink/60 bg-card px-3 py-2 text-sm text-foreground disabled:opacity-60" aria-label="Obec, kde bydlíš" disabled>
                  <option value="">Nejdřív vyber kraj</option>
                </select>
                <button id="obory-geolocation" type="button" class="btn-outline px-3 py-2 text-sm">Moje poloha</button>
              </div>
              <p id="obory-home-status" class="mt-2 text-xs text-muted-foreground" aria-live="polite"></p>
            </div>
            <ul id="program-school-list" class="mt-3 divide-y divide-border overflow-hidden rounded-[3px] border border-border bg-card"></ul>
            <div id="program-map" class="mt-5 h-80 w-full overflow-hidden rounded-[3px] border border-border shadow-paper"></div>
            <p id="program-map-status" class="mt-2 text-xs text-muted-foreground" aria-live="polite"></p>
          </div>
        </section>
      </div>

      <p class="mt-10 text-xs leading-5 text-muted-foreground">
        Zdroj: <a class="underline" href={schoolSource} target="_blank" rel="noreferrer">Rejstřík škol MŠMT</a>, stav k {schoolSnapshotDate}.
        Obor zapsaný v rejstříku škola nemusí každý rok otevírat, ověř si to na jejím webu. Mapa: © OpenStreetMap.
      </p>
    </div>
  </section>

  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <div id="program-data" data-programs={JSON.stringify(programCatalog)} hidden></div>
  <script>
    import { withBase } from "../lib/urls";
    import { loadHome, saveHome, type SavedHome } from "../lib/quiz-storage";
    import { isInCzechRepublic } from "../lib/regions";
    import towns from "../data/towns.json";
    import {
      distanceKm,
      escapeHtml,
      formatDistance,
      getFavoritePrograms,
      loadProgramOutlook,
      loadSchools,
      paintFavoriteButton,
      toggleFavoriteProgram,
      type SchoolSummary,
    } from "../lib/school-data";
    import type { DemandLevel, ProgramOutlookData } from "../lib/program-outlook";
    import { sphereLabels, wageSummary, type ProgramWages } from "../lib/program-wages";
    import { wageChartHtml } from "../lib/wage-chart";
    import { enableWageChartHover } from "../lib/wage-chart-hover";
    import { track } from "../lib/analytics";

    type Program = { code: string; name: string; kind: string; schoolIds: string[] };
    /* eslint-disable no-unused-vars */
    type LeafletMap = {
      fitBounds: (...args: [Array<[number, number]>, { padding: [number, number]; maxZoom: number }]) => LeafletMap;
      invalidateSize(): void;
    };
    type Marker = {
      addTo: (...args: [LeafletMap]) => Marker;
      bindPopup: (...args: [string]) => Marker;
      remove(): Marker;
    };
    type Leaflet = {
      map: (...args: [string, { zoomControl: boolean; scrollWheelZoom: boolean }]) => LeafletMap;
      tileLayer: (...args: [string, { attribution: string; maxZoom: number }]) => { addTo: (...args: [LeafletMap]) => void };
      marker: (...args: [[number, number]]) => Marker;
    };
    /* eslint-enable no-unused-vars */
    type WindowWithLeaflet = Window & { L?: Leaflet };

    const pluralSchools = (count: number) => count === 1 ? "1 škola" : count > 1 && count < 5 ? `${count} školy` : `${count} škol`;
    const pluralPrograms = (count: number) => count === 1 ? "1 obor" : count > 1 && count < 5 ? `${count} obory` : `${count} oborů`;
    const pluralOccupations = (count: number) => count === 1 ? "1 další" : count > 1 && count < 5 ? `${count} další` : `${count} dalších`;
    const demandClasses: Record<DemandLevel, string> = {
      high: "bg-mint/50",
      average: "bg-sun/60",
      low: "bg-peach/70",
    };
    const czechDate = (isoDate: string) => {
      const [year, month, day] = isoDate.split("-").map(Number);
      return year && month && day ? `${day}. ${month}. ${year}` : isoDate;
    };
    const externalLink = (url: string, text: string) =>
      `<a class="underline" href="${escapeHtml(url)}" target="_blank" rel="noreferrer">${escapeHtml(text)}</a>`;

    document.addEventListener("astro:page-load", () => {
      const payload = document.getElementById("program-data");
      const programList = document.getElementById("program-list");
      if (!payload || !programList) return;

      const programs: Program[] = JSON.parse(payload.dataset.programs ?? "[]");
      const searchInput = document.getElementById("program-search") as HTMLInputElement | null;
      const regionSelect = document.getElementById("program-region") as HTMLSelectElement | null;
      const programCount = document.getElementById("program-count");
      const emptyState = document.getElementById("program-empty");
      const selection = document.getElementById("program-selection");
      const placeholder = document.getElementById("program-placeholder");
      const results = document.getElementById("program-results");
      const selectedName = document.getElementById("selected-program-name");
      const selectedCount = document.getElementById("selected-program-count");
      const schoolList = document.getElementById("program-school-list");
      const mapStatus = document.getElementById("program-map-status");
      const mapElement = document.getElementById("program-map");
      const leaflet = (window as WindowWithLeaflet).L;
      const outlookBox = document.getElementById("program-outlook");
      const outlookStatus = document.getElementById("outlook-status");
      const outlookEmployment = document.getElementById("outlook-employment");
      const outlookOccupationsTitle = document.getElementById("outlook-occupations-title");
      const outlookOccupations = document.getElementById("outlook-occupations");
      const outlookDemandLabel = document.getElementById("outlook-demand-label");
      const outlookDemandSummary = document.getElementById("outlook-demand-summary");
      const outlookSources = document.getElementById("outlook-sources");
      const wagesBox = document.getElementById("outlook-wages");
      const favoriteProgramButton = document.getElementById("favorite-program-btn");
      const paintProgramFavorite = () => {
        const program = selectedIndex === null ? undefined : programs[selectedIndex];
        if (favoriteProgramButton && program) paintFavoriteButton(favoriteProgramButton, getFavoritePrograms().includes(program.code));
      };
      enableWageChartHover();

      const renderWages = (program: Program, wages: ProgramWages | null) => {
        if (!wagesBox) return;
        wagesBox.hidden = wages === null;
        if (!wages) return;
        const summary = wageSummary(wages);
        const set = (id: string, html: string) => {
          const element = document.getElementById(id);
          if (element) element.innerHTML = html;
        };
        set("outlook-wages-occupation", `${escapeHtml(wages.occupation)} (CZ-ISCO ${escapeHtml(wages.isco)}), ${escapeHtml(sphereLabels[wages.sphere])}`);
        set("outlook-wages-current", escapeHtml(summary.current));
        set("outlook-wages-chart", wageChartHtml(wages, `Vývoj a prognóza mediánu mzdy: ${wages.occupation}`, "wide"));
        set("outlook-wages-forecast", escapeHtml(summary.forecast));
        set("outlook-wages-caveats", escapeHtml(summary.caveats));
        const units = wages.units.map((unit) => externalLink(unit.url, unit.title)).join(", ");
        set("outlook-wages-sources",
          `Zdroj: ${externalLink(wages.sources.ispv.url, wages.sources.ispv.label)}, ${externalLink(wages.sources.mf.url, wages.sources.mf.label)}. ` +
          `Povolání pro obor ${escapeHtml(program.code)} (${externalLink(wages.sources.nsp.url, wages.sources.nsp.label)}): ${units}.`);
      };

      let schoolsById = new Map<string, SchoolSummary>();
      let schoolsLoaded = false;
      let selectedIndex: number | null = null;
      let pendingIndex: number | null = null;
      let schoolCounts: number[] = programs.map((program) => program.schoolIds.length);
      let map: LeafletMap | null = null;
      let markers: Marker[] = [];

      // The home saved by the quiz or a school page; with one, schools are listed nearest first.
      let home: SavedHome | null = loadHome();
      const homeRegionSelect = document.getElementById("obory-home-region") as HTMLSelectElement | null;
      const homeTownSelect = document.getElementById("obory-home-town") as HTMLSelectElement | null;
      const homeStatus = document.getElementById("obory-home-status");
      const geolocationButton = document.getElementById("obory-geolocation") as HTMLButtonElement | null;
      let locationRequest = 0;

      const distanceTo = (school: SchoolSummary) =>
        home && school.latitude !== null && school.longitude !== null
          ? distanceKm(home.latitude, home.longitude, school.latitude, school.longitude)
          : null;

      const schoolsFor = (program: Program) => {
        const region = regionSelect?.value ?? "";
        return program.schoolIds
          .map((id) => schoolsById.get(id))
          .filter((school): school is SchoolSummary => school !== undefined && (!region || school.region === region))
          .map((school) => ({ school, distance: distanceTo(school) }))
          // Nearest first; schools without a known position go last, then by name.
          .sort((left, right) => (left.distance ?? Infinity) - (right.distance ?? Infinity) ||
            left.school.name.localeCompare(right.school.name, "cs"));
      };

      const fillTowns = (region: string) => {
        if (!homeTownSelect) return;
        const regionTowns = towns
          .filter((town) => town.region === region)
          .sort((left, right) => left.name.localeCompare(right.name, "cs", { numeric: true }));
        homeTownSelect.replaceChildren(
          new Option(region ? (region === "Praha" ? "Vyber obvod…" : "Vyber obec…") : "Nejdřív vyber kraj", ""),
          ...regionTowns.map((town) => {
            const option = new Option(town.name, `${town.region}|${town.name}`);
            option.dataset.latitude = String(town.latitude);
            option.dataset.longitude = String(town.longitude);
            return option;
          }),
        );
        homeTownSelect.disabled = regionTowns.length === 0;
      };

      const paintHomeStatus = () => {
        if (!homeStatus) return;
        homeStatus.textContent = home
          ? `Školy jsou seřazené podle vzdálenosti (vzdušnou čarou) od: ${home.label}. Bydliště si pamatuje jen tvůj prohlížeč.`
          : "Bez bydliště jsou školy seřazené podle abecedy.";
      };

      const setHome = (next: SavedHome) => {
        home = next;
        saveHome(next);
        paintHomeStatus();
        if (selectedIndex !== null) selectProgram(selectedIndex, false);
      };

      if (home?.region) {
        if (homeRegionSelect) homeRegionSelect.value = home.region;
        fillTowns(home.region);
        if (homeTownSelect) homeTownSelect.value = home.town;
      }
      paintHomeStatus();

      homeRegionSelect?.addEventListener("change", () => {
        locationRequest += 1;
        fillTowns(homeRegionSelect.value);
      });
      homeTownSelect?.addEventListener("change", () => {
        locationRequest += 1;
        const option = homeTownSelect.selectedOptions[0];
        const latitude = Number(option?.dataset.latitude);
        const longitude = Number(option?.dataset.longitude);
        if (!option?.value || !Number.isFinite(latitude) || !Number.isFinite(longitude)) return;
        setHome({ label: option.textContent ?? "", latitude, longitude, region: homeRegionSelect?.value ?? "", town: option.value });
      });
      geolocationButton?.addEventListener("click", () => {
        if (!navigator.geolocation) {
          if (homeStatus) homeStatus.textContent = "Tenhle prohlížeč polohu neumí. Vyber kraj a obec.";
          return;
        }
        if (homeStatus) homeStatus.textContent = "Zjišťuji polohu…";
        locationRequest += 1;
        const request = locationRequest;
        navigator.geolocation.getCurrentPosition(
          ({ coords }) => {
            if (request !== locationRequest) return;
            if (!isInCzechRepublic(coords.latitude, coords.longitude)) {
              if (homeStatus) homeStatus.textContent = "Podle polohy nejsi v Česku. Vyber kraj a obec.";
              return;
            }
            if (homeRegionSelect) homeRegionSelect.value = "";
            fillTowns("");
            setHome({ label: "tvoje poloha", latitude: coords.latitude, longitude: coords.longitude, region: "", town: "" });
          },
          () => {
            if (request !== locationRequest || !homeStatus) return;
            homeStatus.textContent = "Polohu se nepovedlo zjistit. Vyber kraj a obec.";
          },
          { timeout: 10000, maximumAge: 300000 },
        );
      });

      const updateCounts = () => {
        const region = regionSelect?.value ?? "";
        schoolCounts = programs.map((program) => region
          ? program.schoolIds.filter((id) => schoolsById.get(id)?.region === region).length
          : program.schoolIds.length);
      };

      const renderList = () => {
        const query = searchInput?.value.trim().toLocaleLowerCase("cs") ?? "";
        let visible = 0;
        programList.querySelectorAll<HTMLButtonElement>(".program-option").forEach((button) => {
          const index = Number(button.dataset.programIndex);
          const program = programs[index];
          const count = schoolCounts[index] ?? 0;
          const matches = Boolean(program) && count > 0 && `${program.name} ${program.code}`.toLocaleLowerCase("cs").includes(query);
          const item = button.closest("li");
          if (item) item.hidden = !matches;
          const badge = button.querySelector(".program-school-count");
          if (badge) badge.textContent = String(count);
          button.setAttribute("aria-pressed", String(index === selectedIndex));
          if (matches) visible += 1;
        });
        if (programCount) programCount.textContent = pluralPrograms(visible);
        if (emptyState) emptyState.hidden = visible > 0;
      };

      const renderMap = (matching: SchoolSummary[]) => {
        if (!mapElement || !leaflet) {
          if (mapStatus) mapStatus.textContent = "Mapu se nepodařilo načíst.";
          return;
        }
        if (!map) {
          map = leaflet.map("program-map", { zoomControl: true, scrollWheelZoom: false });
          leaflet.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
            maxZoom: 19,
          }).addTo(map);
        }
        markers.forEach((marker) => marker.remove());
        markers = [];
        const points: Array<[number, number]> = [];
        for (const school of matching) {
          if (school.latitude === null || school.longitude === null) continue;
          const point: [number, number] = [school.latitude, school.longitude];
          points.push(point);
          markers.push(leaflet.marker(point).bindPopup(`<strong>${escapeHtml(school.name)}</strong>`).addTo(map));
        }
        const missing = matching.length - points.length;
        if (mapStatus) mapStatus.textContent = missing > 0 ? `${pluralSchools(missing)} bez polohy na mapě.` : "";
        map.invalidateSize();
        if (points.length) map.fitBounds(points, { padding: [24, 24], maxZoom: 12 });
      };

      const renderOutlook = (program: Program, data: ProgramOutlookData) => {
        if (!outlookBox || !outlookEmployment || !outlookOccupationsTitle || !outlookOccupations || !outlookDemandLabel ||
          !outlookDemandSummary || !outlookSources) return;
        const outlook = data.programs[program.code];
        if (!outlook) {
          outlookBox.hidden = true;
          if (outlookStatus) outlookStatus.textContent = "";
          return;
        }
        outlookEmployment.textContent = outlook.employment ||
          "Popis uplatnění absolventů pro tento obor zatím Národní pedagogický institut nezveřejnil.";
        outlookOccupationsTitle.hidden = outlook.occupations.length === 0;
        outlookOccupations.innerHTML = [
          ...outlook.occupations.map((name) => `<li class="rounded-full bg-lilac/50 px-2.5 py-1 text-xs text-ink">${escapeHtml(name)}</li>`),
          ...(outlook.moreOccupations > 0
            ? [`<li class="px-1 py-1 text-xs text-muted-foreground">a ${pluralOccupations(outlook.moreOccupations)}</li>`]
            : []),
        ].join("");
        if (outlook.demand) {
          outlookDemandLabel.innerHTML =
            `<span class="inline-flex rounded-full ${demandClasses[outlook.demand.level]} px-3 py-1.5 text-sm font-semibold text-ink">${escapeHtml(outlook.demand.label)}</span>`;
          outlookDemandSummary.textContent = outlook.demand.summary;
        } else {
          outlookDemandLabel.innerHTML =
            `<span class="inline-flex rounded-full bg-muted px-3 py-1.5 text-sm font-semibold text-muted-foreground">Bez hodnocení</span>`;
          outlookDemandSummary.textContent = outlook.demandNote;
        }
        const links = [
          outlook.cardUrl ? externalLink(outlook.cardUrl, "karta oboru") : "",
          outlook.statsUrl ? externalLink(outlook.statsUrl, "nezaměstnanost absolventů") : "",
        ].filter(Boolean);
        outlookSources.innerHTML = `Zdroj uplatnění a poptávky: ${externalLink(data.sourceUrl, data.source)}${links.length ? ` – ${links.join(", ")}` : ""}, staženo ${escapeHtml(czechDate(data.fetchedAt))}.`;
        outlookBox.hidden = false;
        renderWages(program, outlook.wages);
        if (outlookStatus) outlookStatus.textContent = "";
      };

      const showOutlook = (program: Program) => {
        if (outlookBox) outlookBox.hidden = true;
        if (outlookStatus) outlookStatus.textContent = "Načítám uplatnění absolventů…";
        loadProgramOutlook()
          .then((data) => {
            // A slower response must not overwrite a program picked in the meantime.
            if (selectedIndex === null || programs[selectedIndex] !== program) return;
            renderOutlook(program, data);
          })
          .catch(() => {
            if (outlookStatus) outlookStatus.textContent = "Údaje o uplatnění se nepodařilo načíst.";
          });
      };

      const selectProgram = (index: number, scroll: boolean) => {
        if (!schoolsLoaded) {
          pendingIndex = index;
          if (programCount) programCount.textContent = "Načítám školy…";
          return;
        }
        const program = programs[index];
        if (!program || !results || !placeholder || !selectedName || !selectedCount || !schoolList) return;
        selectedIndex = index;
        const matching = schoolsFor(program);
        // Only a click counts as interest; region changes re-render the same program.
        if (scroll) track("program_view", { program: program.name, code: program.code, schools: matching.length });
        selectedName.textContent = program.name;
        selectedCount.textContent = `${program.kind ? `${program.kind[0]?.toLocaleUpperCase("cs")}${program.kind.slice(1)} · ` : ""}${program.code} · nabízí ${pluralSchools(matching.length)}`;
        schoolList.innerHTML = matching.map(({ school, distance }) => `
          <li>
            <a class="flex items-start justify-between gap-3 px-4 py-3 hover:bg-muted" href="${withBase(`/skoly/${encodeURIComponent(school.id)}/`)}">
              <span class="flex min-w-0 flex-col gap-0.5">
                <span class="font-medium text-foreground">${escapeHtml(school.name)}</span>
                <span class="text-sm text-muted-foreground">${escapeHtml(school.address)}</span>
              </span>
              ${distance !== null ? `<span class="shrink-0 rounded-full bg-sun/50 px-2.5 py-1 text-xs font-bold text-ink">${escapeHtml(formatDistance(distance))}</span>` : ""}
            </a>
          </li>`).join("");
        placeholder.hidden = true;
        results.hidden = false;
        paintProgramFavorite();
        // Region changes keep the program, so only a new pick reloads its outlook.
        if (scroll) showOutlook(program);
        renderList();
        window.setTimeout(() => renderMap(matching.map(({ school }) => school)), 0);
        // Only move focus/scroll for an explicit pick, not when the region select changes.
        if (!scroll) return;
        if (selection && window.matchMedia("(max-width: 1023px)").matches) {
          selection.scrollIntoView({ behavior: "smooth", block: "start" });
        }
        selectedName.focus({ preventScroll: true });
      };

      programList.addEventListener("click", (event) => {
        const target = event.target;
        const button = target instanceof Element ? target.closest<HTMLButtonElement>(".program-option") : null;
        if (button) selectProgram(Number(button.dataset.programIndex), true);
      });
      favoriteProgramButton?.addEventListener("click", () => {
        const program = selectedIndex === null ? undefined : programs[selectedIndex];
        if (!program) return;
        toggleFavoriteProgram(program.code);
        paintProgramFavorite();
      });
      // /obory/?obor=65-51-H/01 (links from favorites and school pages) opens that program.
      const linkedCode = new URLSearchParams(window.location.search).get("obor");
      const linkedIndex = linkedCode ? programs.findIndex((program) => program.code === linkedCode) : -1;
      if (linkedIndex >= 0) selectProgram(linkedIndex, true);
      let searchTimer: number | null = null;
      searchInput?.addEventListener("input", () => {
        renderList();
        if (searchTimer !== null) window.clearTimeout(searchTimer);
        searchTimer = window.setTimeout(() => {
          const query = searchInput.value.trim();
          if (query.length < 2) return;
          const results = programList.querySelectorAll("li:not([hidden])").length;
          track("search", { where: "obory", q: query, results });
        }, 1500);
      });
      regionSelect?.addEventListener("change", () => {
        updateCounts();
        renderList();
        if (selectedIndex !== null) selectProgram(selectedIndex, false);
      });

      loadSchools()
        .then((schools) => {
          schoolsById = new Map(schools.map((school) => [school.id, school]));
          schoolsLoaded = true;
          updateCounts();
          renderList();
          if (pendingIndex !== null) selectProgram(pendingIndex, true);
        })
        .catch(() => {
          if (programCount) programCount.textContent = "Seznam škol se nepodařilo načíst. Zkus stránku obnovit.";
        });
    });
  </script>
</BaseLayout>
