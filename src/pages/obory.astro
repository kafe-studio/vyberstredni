---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import Character from "../components/Character.astro";
import { currentProgramGroups, schoolSnapshotDate, schoolSource } from "../data/schools";
import { programLevel } from "../lib/interest-test";
import { REGIONS } from "../lib/regions";

/** Plain-language label for the level letter (and gymnázium length) in a program code. */
const programKind = (code: string) => {
  const level = programLevel(code);
  if (level === "K") return `gymnázium ${/\/(\d)/.exec(code)?.[1] ?? "4"}leté`;
  if (level === "M" || level === "L") return "s maturitou";
  if (level === "P") return "konzervatoř";
  if (level === "H" || level === "E") return "výuční list";
  if (level === "C") return "praktická škola";
  return "";
};

const programGroups = currentProgramGroups();

// Only programs some school currently offers; the rendered list and the JSON payload share this order.
const programCatalog = [...programGroups.values()]
  .map((program) => ({ code: program.code, name: program.name, kind: programKind(program.code), schoolIds: [...program.schoolIds] }))
  .sort((left, right) => left.name.localeCompare(right.name, "cs") || left.code.localeCompare(right.code, "cs"));

const metadata = {
  title: "Obory",
  description: "Najdi studijní obor a podívej se, které střední školy v Česku ho nabízejí.",
};
---

<BaseLayout {metadata}>
  <section class="px-6 pb-16 pt-28 md:pt-32">
    <div class="mx-auto max-w-6xl">
      <header class="mb-8">
        <span class="sticker-note -rotate-2 bg-orange text-ink">{programCatalog.length} oborů</span>
        <h1 class="mt-4 text-4xl font-extrabold md:text-6xl">Obory</h1>
        <p class="mt-3 text-lg text-muted-foreground">Vyber obor a uvidíš, které školy ho nabízejí.</p>
      </header>

      <div class="grid gap-6 lg:grid-cols-[22rem_minmax(0,1fr)]">
        <section class="track-card p-4" aria-label="Seznam oborů">
          <label class="block">
            <span class="sr-only">Hledat obor</span>
            <input id="program-search" type="search" class="w-full rounded-xl border-2 border-ink bg-white px-4 py-3 text-foreground placeholder:text-muted-foreground" placeholder="🔍 Hledej obor, např. kuchař" />
          </label>
          <select id="program-region" class="mt-3 w-full rounded-xl border-2 border-ink bg-white px-3 py-2.5 text-foreground" aria-label="Kraj">
            <option value="">Celé Česko</option>
            {REGIONS.map((region) => <option value={region}>{region}</option>)}
          </select>
          <p id="program-count" class="mt-3 text-xs text-muted-foreground" aria-live="polite">{programCatalog.length} oborů</p>
          <ul id="program-list" class="mt-2 max-h-[32rem] space-y-1 overflow-y-auto pr-1">
            {programCatalog.map((program, index) => (
              <li>
                <button
                  type="button"
                  class="program-option flex w-full items-center justify-between gap-3 rounded-xl border-2 border-transparent px-3 py-2.5 text-left transition hover:bg-lilac aria-pressed:border-ink aria-pressed:bg-sun"
                  data-program-index={index}
                  aria-pressed="false"
                  title={program.code}
                >
                  <span>
                    <span class="block font-medium text-foreground">{program.name}</span>
                    {program.kind && <span class="text-xs text-muted-foreground">{program.kind}</span>}
                  </span>
                  <span class="program-school-count shrink-0 rounded-full bg-muted px-2 py-0.5 text-xs text-muted-foreground">{program.schoolIds.length}</span>
                </button>
              </li>
            ))}
          </ul>
          <p id="program-empty" class="rounded-xl border border-dashed border-border p-4 text-sm text-muted-foreground" hidden>
            Žádný obor neodpovídá hledání.
          </p>
        </section>

        <section id="program-selection" class="scroll-mt-24 track-card p-5 md:p-6">
          <div id="program-placeholder" class="flex min-h-80 flex-col items-center justify-center gap-4 p-6 text-center">
            <div class="relative isolate w-40">
              <div class="blob inset-x-0 bottom-0 top-10 bg-peach"></div>
              <Character name="bun" class="character-float relative w-full" />
            </div>
            <p class="font-display text-xl font-extrabold">Vyber si obor ze seznamu</p>
            <p class="max-w-xs text-sm text-muted-foreground">Ukážu ti, které školy ho nabízejí a kde je najdeš na mapě.</p>
          </div>
          <div id="program-results" hidden>
            <h2 id="selected-program-name" class="text-2xl font-bold" tabindex="-1"></h2>
            <p id="selected-program-count" class="mt-1 text-muted-foreground"></p>
            <ul id="program-school-list" class="mt-5 divide-y-2 divide-ink/10 overflow-hidden rounded-xl border-2 border-ink bg-white"></ul>
            <div id="program-map" class="mt-5 h-80 w-full overflow-hidden rounded-xl border-2 border-ink"></div>
            <p id="program-map-status" class="mt-2 text-xs text-muted-foreground" aria-live="polite"></p>
          </div>
        </section>
      </div>

      <p class="mt-10 text-xs leading-5 text-muted-foreground">
        Zdroj: <a class="underline" href={schoolSource} target="_blank" rel="noreferrer">Rejstřík škol MŠMT</a>, stav k {schoolSnapshotDate}.
        Obor zapsaný v rejstříku škola nemusí každý rok otevírat, ověř si to na jejím webu. Mapa: © OpenStreetMap.
      </p>
    </div>
  </section>

  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <div id="program-data" data-programs={JSON.stringify(programCatalog)} hidden></div>
  <script>
    import { withBase } from "../lib/urls";
    import { escapeHtml, loadSchools, type SchoolSummary } from "../lib/school-data";

    type Program = { code: string; name: string; kind: string; schoolIds: string[] };
    /* eslint-disable no-unused-vars */
    type LeafletMap = {
      fitBounds: (...args: [Array<[number, number]>, { padding: [number, number]; maxZoom: number }]) => LeafletMap;
      invalidateSize(): void;
    };
    type Marker = {
      addTo: (...args: [LeafletMap]) => Marker;
      bindPopup: (...args: [string]) => Marker;
      remove(): Marker;
    };
    type Leaflet = {
      map: (...args: [string, { zoomControl: boolean; scrollWheelZoom: boolean }]) => LeafletMap;
      tileLayer: (...args: [string, { attribution: string; maxZoom: number }]) => { addTo: (...args: [LeafletMap]) => void };
      marker: (...args: [[number, number]]) => Marker;
    };
    /* eslint-enable no-unused-vars */
    type WindowWithLeaflet = Window & { L?: Leaflet };

    const pluralSchools = (count: number) => count === 1 ? "1 škola" : count > 1 && count < 5 ? `${count} školy` : `${count} škol`;
    const pluralPrograms = (count: number) => count === 1 ? "1 obor" : count > 1 && count < 5 ? `${count} obory` : `${count} oborů`;

    document.addEventListener("astro:page-load", () => {
      const payload = document.getElementById("program-data");
      const programList = document.getElementById("program-list");
      if (!payload || !programList) return;

      const programs: Program[] = JSON.parse(payload.dataset.programs ?? "[]");
      const searchInput = document.getElementById("program-search") as HTMLInputElement | null;
      const regionSelect = document.getElementById("program-region") as HTMLSelectElement | null;
      const programCount = document.getElementById("program-count");
      const emptyState = document.getElementById("program-empty");
      const selection = document.getElementById("program-selection");
      const placeholder = document.getElementById("program-placeholder");
      const results = document.getElementById("program-results");
      const selectedName = document.getElementById("selected-program-name");
      const selectedCount = document.getElementById("selected-program-count");
      const schoolList = document.getElementById("program-school-list");
      const mapStatus = document.getElementById("program-map-status");
      const mapElement = document.getElementById("program-map");
      const leaflet = (window as WindowWithLeaflet).L;

      let schoolsById = new Map<string, SchoolSummary>();
      let schoolsLoaded = false;
      let selectedIndex: number | null = null;
      let pendingIndex: number | null = null;
      let schoolCounts: number[] = programs.map((program) => program.schoolIds.length);
      let map: LeafletMap | null = null;
      let markers: Marker[] = [];

      const schoolsFor = (program: Program) => {
        const region = regionSelect?.value ?? "";
        return program.schoolIds
          .map((id) => schoolsById.get(id))
          .filter((school): school is SchoolSummary => school !== undefined && (!region || school.region === region))
          .sort((left, right) => left.name.localeCompare(right.name, "cs"));
      };

      const updateCounts = () => {
        const region = regionSelect?.value ?? "";
        schoolCounts = programs.map((program) => region
          ? program.schoolIds.filter((id) => schoolsById.get(id)?.region === region).length
          : program.schoolIds.length);
      };

      const renderList = () => {
        const query = searchInput?.value.trim().toLocaleLowerCase("cs") ?? "";
        let visible = 0;
        programList.querySelectorAll<HTMLButtonElement>(".program-option").forEach((button) => {
          const index = Number(button.dataset.programIndex);
          const program = programs[index];
          const count = schoolCounts[index] ?? 0;
          const matches = Boolean(program) && count > 0 && `${program.name} ${program.code}`.toLocaleLowerCase("cs").includes(query);
          const item = button.closest("li");
          if (item) item.hidden = !matches;
          const badge = button.querySelector(".program-school-count");
          if (badge) badge.textContent = String(count);
          button.setAttribute("aria-pressed", String(index === selectedIndex));
          if (matches) visible += 1;
        });
        if (programCount) programCount.textContent = pluralPrograms(visible);
        if (emptyState) emptyState.hidden = visible > 0;
      };

      const renderMap = (matching: SchoolSummary[]) => {
        if (!mapElement || !leaflet) {
          if (mapStatus) mapStatus.textContent = "Mapu se nepodařilo načíst.";
          return;
        }
        if (!map) {
          map = leaflet.map("program-map", { zoomControl: true, scrollWheelZoom: false });
          leaflet.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
            maxZoom: 19,
          }).addTo(map);
        }
        markers.forEach((marker) => marker.remove());
        markers = [];
        const points: Array<[number, number]> = [];
        for (const school of matching) {
          if (school.latitude === null || school.longitude === null) continue;
          const point: [number, number] = [school.latitude, school.longitude];
          points.push(point);
          markers.push(leaflet.marker(point).bindPopup(`<strong>${escapeHtml(school.name)}</strong>`).addTo(map));
        }
        const missing = matching.length - points.length;
        if (mapStatus) mapStatus.textContent = missing > 0 ? `${pluralSchools(missing)} bez polohy na mapě.` : "";
        map.invalidateSize();
        if (points.length) map.fitBounds(points, { padding: [24, 24], maxZoom: 12 });
      };

      const selectProgram = (index: number, scroll: boolean) => {
        if (!schoolsLoaded) {
          pendingIndex = index;
          if (programCount) programCount.textContent = "Načítám školy…";
          return;
        }
        const program = programs[index];
        if (!program || !results || !placeholder || !selectedName || !selectedCount || !schoolList) return;
        selectedIndex = index;
        const matching = schoolsFor(program);
        selectedName.textContent = program.name;
        selectedCount.textContent = `${program.kind ? `${program.kind[0]?.toLocaleUpperCase("cs")}${program.kind.slice(1)} · ` : ""}nabízí ${pluralSchools(matching.length)}`;
        schoolList.innerHTML = matching.map((school) => `
          <li>
            <a class="flex flex-col gap-0.5 px-4 py-3 hover:bg-muted" href="${withBase(`/skoly/${encodeURIComponent(school.id)}/`)}">
              <span class="font-medium text-foreground">${escapeHtml(school.name)}</span>
              <span class="text-sm text-muted-foreground">${escapeHtml(school.address)}</span>
            </a>
          </li>`).join("");
        placeholder.hidden = true;
        results.hidden = false;
        renderList();
        window.setTimeout(() => renderMap(matching), 0);
        // Only move focus/scroll for an explicit pick, not when the region select changes.
        if (!scroll) return;
        if (selection && window.matchMedia("(max-width: 1023px)").matches) {
          selection.scrollIntoView({ behavior: "smooth", block: "start" });
        }
        selectedName.focus({ preventScroll: true });
      };

      programList.addEventListener("click", (event) => {
        const target = event.target;
        const button = target instanceof Element ? target.closest<HTMLButtonElement>(".program-option") : null;
        if (button) selectProgram(Number(button.dataset.programIndex), true);
      });
      searchInput?.addEventListener("input", renderList);
      regionSelect?.addEventListener("change", () => {
        updateCounts();
        renderList();
        if (selectedIndex !== null) selectProgram(selectedIndex, false);
      });

      loadSchools()
        .then((schools) => {
          schoolsById = new Map(schools.map((school) => [school.id, school]));
          schoolsLoaded = true;
          updateCounts();
          renderList();
          if (pendingIndex !== null) selectProgram(pendingIndex, true);
        })
        .catch(() => {
          if (programCount) programCount.textContent = "Seznam škol se nepodařilo načíst. Zkus stránku obnovit.";
        });
    });
  </script>
</BaseLayout>
