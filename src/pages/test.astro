---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import Character, { type CharacterName } from "../components/Character.astro";
import { QUESTIONS as questions } from "../lib/quiz-questions";
import { REGIONS } from "../lib/regions";
import { withBase } from "../lib/urls";
import { sortLabels, type SortKey } from "../lib/school-sort";

const resultSorts: SortKey[] = ["match", "distance", "maturita", "easiest", "popular"];

const metadata = {
  title: "Test zájmů",
  description: "Pár krátkých otázek o tom, co tě baví. Na konci uvidíš obory a střední školy po celém Česku, které odpovídají tvým zájmům.",
};


const totalSteps = questions.length + 1;
/** One companion per step, cycling through the four students (shown next to the quiz on wide screens). */
const companionCycle: CharacterName[] = ["hoodie", "bun", "vest", "cap"];
const backgroundCycle = ["bg-lilac", "bg-peach", "bg-mint", "bg-sky/25", "bg-sun/40", "bg-lime/40"];
const stepCharacters = Array.from({ length: totalSteps }, (_, index) => companionCycle[index % companionCycle.length]);
const stepBackgrounds = Array.from({ length: totalSteps }, (_, index) => backgroundCycle[index % backgroundCycle.length]);
---

<BaseLayout {metadata} showQuizBanner={false}>
  <section class="px-6 pb-20 pt-28 md:pt-32">
    <div class="mx-auto max-w-2xl">
      <header class="mb-8 text-center">
        <span class="sticker-note -rotate-2 bg-lime">6 otázek, zabere to asi 2 minuty</span>
        <h1 class="mt-4 text-4xl font-extrabold md:text-5xl">Test zájmů</h1>
        <p class="mt-3 text-muted-foreground">Žádné šprtání, žádné špatné odpovědi. Prostě klikej, co tě láká.</p>
      </header>

      <div class="relative">
      <div id="step-companions" class="pointer-events-none absolute -right-60 bottom-0 hidden w-52 xl:block" aria-hidden="true">
        {stepCharacters.map((name, index) => (
          <div class="step-character relative isolate" data-step-character={index} hidden={index !== 0}>
            <div class:list={["blob inset-x-2 bottom-0 top-16", stepBackgrounds[index]]}></div>
            <Character name={name} class="character-float relative w-full" />
          </div>
        ))}
      </div>

      <div id="quiz" class="track-card scroll-mt-24 p-6 md:p-8" data-question-count={questions.length}>
        <div class="mb-6">
          <div class="mb-2 flex items-center justify-between text-sm text-muted-foreground">
            <span id="step-label" aria-live="polite">Otázka 1 z {questions.length}</span>
            <span class="flex gap-4">
              <button id="reset-quiz" type="button" class="font-semibold text-muted-foreground hover:text-primary hover:underline" hidden>🔄 Reset</button>
              <button id="back-button" type="button" class="font-semibold text-primary hover:underline disabled:invisible" disabled>← Zpět</button>
              <button id="next-button" type="button" class="font-semibold text-primary hover:underline disabled:invisible" disabled>Další →</button>
            </span>
          </div>
          <div class="h-3 overflow-hidden rounded-[3px] border border-border bg-card">
            <div id="progress-bar" class="h-full rounded-full bg-primary transition-all duration-300" style={`width: ${100 / totalSteps}%`}></div>
          </div>
        </div>

        {questions.map((question, index) => (
          <section class="quiz-step" data-question={question.id} hidden={index !== 0}>
            <h2 class="text-2xl font-bold" tabindex="-1">{question.prompt}</h2>
            {question.hint && <p class="mt-1 text-sm text-muted-foreground">{question.hint}</p>}
            <div class:list={["mt-5 grid gap-2 sm:gap-3", question.options.length > 8 ? "grid-cols-2 lg:grid-cols-3" : "sm:grid-cols-2"]}>
              {question.options.map((option) => (
                <button
                  type="button"
                  class="quiz-option flex items-center gap-2 rounded-[4px] border border-border bg-card p-3 text-left text-sm sm:gap-3 sm:p-4 sm:text-base shadow-paper transition hover:-translate-x-0.5 hover:-translate-y-0.5 hover:bg-lilac hover:shadow-paper-lift aria-pressed:bg-sun"
                  data-value={option.value}
                  aria-pressed="false"
                >
                  <span class="shrink-0 text-xl sm:text-2xl" aria-hidden="true">{option.icon}</span>
                  <span class="min-w-0 font-semibold leading-snug text-ink">{option.label}</span>
                </button>
              ))}
            </div>
          </section>
        ))}

        <section class="quiz-step" hidden>
          <h2 class="text-2xl font-bold" tabindex="-1">Odkud budeš dojíždět?</h2>
          <p class="mt-1 text-sm text-muted-foreground">Nepovinné. Školy ti pak seřadíme podle toho, jak daleko to máš.</p>
          <p id="home-missing-note" class="mt-3 rounded-[3px] bg-sun/50 px-3 py-2 text-sm font-semibold text-ink">
            ⚠️ Když nevybereš, kde bydlíš, školy nebudou seřazené podle vzdálenosti.
          </p>
          <div class="mt-5 space-y-4">
            <div class="grid gap-3 sm:grid-cols-2">
              <label class="block">
                <span class="mb-2 block text-sm font-medium">Kraj</span>
                <select id="home-region" class="w-full rounded-[6px] border-2 border-ink/60 bg-card px-3 py-3 text-ink">
                  <option value="">Vyber kraj…</option>
                  {REGIONS.map((region) => <option value={region}>{region}</option>)}
                </select>
              </label>
              <label class="block">
                <span id="home-town-label" class="mb-2 block text-sm font-medium">Obec</span>
                <select id="home-select" class="w-full rounded-[6px] border-2 border-ink/60 bg-card px-3 py-3 text-ink disabled:opacity-60" disabled>
                  <option value="">Nejdřív vyber kraj</option>
                </select>
              </label>
            </div>
            <button id="geolocation-button" type="button" class="btn-outline w-full">📍 Použít moji polohu</button>
            <p id="home-status" class="text-sm text-muted-foreground" aria-live="polite"></p>
            <label id="distance-field" class="block" hidden>
              <span class="mb-2 block text-sm font-medium">Kolik max chceš dojíždět?</span>
              <select id="max-distance" class="w-full rounded-[6px] border-2 border-ink/60 bg-card px-3 py-3 text-ink">
                <option value="">Nezáleží</option>
                <option value="10">Do 10 km</option>
                <option value="20">Do 20 km</option>
                <option value="30">Do 30 km</option>
                <option value="50">Do 50 km</option>
              </select>
            </label>
          </div>
          <button id="show-results" type="button" class="btn-primary mt-6 w-full">Ukaž moje školy</button>
        </section>
      </div>
      </div>

      <div id="results" class="scroll-mt-24" hidden>
        <div class="track-card relative overflow-hidden bg-lilac p-6 md:p-8 md:pr-56">
          <div class="pointer-events-none absolute -bottom-6 -right-6 hidden w-56 md:block" aria-hidden="true">
            <Character name="duo-hoodie-bun" class="w-full" />
          </div>
          <span class="sticker-note -rotate-2 bg-sun">Hotovo!</span>
          <h2 class="mt-3 text-3xl font-extrabold">Tohle tě nejvíc baví</h2>
          <div id="top-interests" class="mt-4 flex flex-wrap gap-2" role="group" aria-label="Tvoje zájmy"></div>
          <p id="interest-hint" class="mt-2 text-xs text-muted-foreground" aria-live="polite" hidden>
            Klepnutím zájem vypneš nebo zase zapneš a školy se hned přepočítají.
          </p>
          <p id="results-note" class="mt-4 text-sm text-muted-foreground"></p>
          <div id="track-hint" class="mt-4 rounded-[3px] bg-sun/60 p-4 text-sm font-semibold text-ink" hidden>
            <p id="track-hint-text"></p>
            <button id="switch-track" type="button" class="btn-primary mt-3 px-4 py-2 text-sm">Ukázat všechny typy škol</button>
          </div>
          <div class="mt-5 flex flex-wrap gap-3">
            <button id="edit-answers" type="button" class="btn-outline">Změnit odpovědi</button>
            <button id="restart" type="button" class="btn-outline">🔄 Začít úplně od nuly</button>
          </div>
          <p class="mt-3 text-xs text-muted-foreground">Odpovědi i bydliště si pamatuje jen tvůj prohlížeč, dokud je nesmažeš.</p>
        </div>

        <section id="recommended-programs" class="mt-10" hidden>
          <h2 class="text-2xl font-extrabold">Obory, které ti doporučuju</h2>
          <p class="mt-1 text-sm text-muted-foreground">Klikni na obor a uvidíš všechny školy, které ho nabízejí, seřazené od nejbližší.</p>
          <ul id="recommended-programs-list" class="mt-4 grid gap-2 sm:grid-cols-2"></ul>
        </section>

        <div class="mb-4 mt-10 flex flex-wrap items-end justify-between gap-3">
          <h2 class="text-2xl font-extrabold">Školy, které by ti mohly sednout</h2>
          <label class="flex items-center gap-2 text-sm">
            <span class="font-medium text-muted-foreground">Řadit podle</span>
            <select id="results-sort" class="rounded-[6px] border-2 border-ink/60 bg-card px-2 py-1.5 font-semibold text-foreground">
              {resultSorts.map((key) => <option value={key}>{sortLabels[key]}</option>)}
            </select>
          </label>
        </div>
        <div id="recommendations" class="space-y-4"></div>
        <button id="more-results" type="button" class="btn-outline mt-6 w-full" hidden>Zobrazit další školy</button>
        <p class="mt-8 text-xs leading-5 text-muted-foreground">
          Orientační doporučení podle oborů zapsaných v rejstříku MŠMT, nejde o psychologický test ani odhad šance na přijetí.
          Vzdálenost je vzdušnou čarou. Otevření oboru a přijímací podmínky si ověř na webu školy.
          Školy určené žákům se zdravotním postižením, praktické školy a obory pro žáky se speciálními vzdělávacími potřebami
          (kategorie E a C) v doporučení neukazujeme – najdeš je v <a class="underline" href={withBase("/skoly/")}>katalogu škol</a>.
        </p>
      </div>
    </div>
  </section>

  <script>
    import { withBase } from "../lib/urls";
    import { escapeHtml, loadSchoolPrograms, loadSchoolStats, loadSchools, programPageUrl, type SchoolStatsById } from "../lib/school-data";
    import { compareSchools, isSortKey, schoolFacts, type SortKey } from "../lib/school-sort";
    import {
      categoryLabels,
      matchedInterests,
      rankInterests,
      rankSchools,
      recommendedPrograms,
      withoutInterests,
      type Category,
      type Recommendation,
    } from "../lib/interest-test";
    import { computeTotals, primaryInterest, studyTrack, supportNeed } from "../lib/quiz-questions";
    import { isInCzechRepublic } from "../lib/regions";
    import { supportLabels } from "../lib/special-needs";
    import { clearQuiz, clearResultsView, loadQuiz, loadResultsView, saveQuiz, saveResultsView, type SavedHome } from "../lib/quiz-storage";
    import { clickedSchoolLink } from "../lib/return-link";
    import { tuitionChipHtml } from "../lib/tuition";
    import { localToday, openDayChipHtml } from "../lib/school-extras";
    import { track as trackEvent } from "../lib/analytics";
    import towns from "../data/towns.json";

    const PAGE_SIZE = 6;
    const ADVANCE_DELAY_MS = 220;

    document.addEventListener("astro:page-load", () => {
      const quiz = document.getElementById("quiz");
      const results = document.getElementById("results");
      if (!quiz || !results) return;

      const steps = [...quiz.querySelectorAll<HTMLElement>(".quiz-step")];
      const totalSteps = steps.length;
      const questionCount = Number(quiz.dataset.questionCount) || totalSteps - 1;
      const stepLabel = document.getElementById("step-label");
      const progressBar = document.getElementById("progress-bar");
      const backButton = document.getElementById("back-button") as HTMLButtonElement | null;
      const nextButton = document.getElementById("next-button") as HTMLButtonElement | null;
      const homeSelect = document.getElementById("home-select") as HTMLSelectElement | null;
      const homeRegionSelect = document.getElementById("home-region") as HTMLSelectElement | null;
      const geolocationButton = document.getElementById("geolocation-button") as HTMLButtonElement | null;
      const homeStatus = document.getElementById("home-status");
      const distanceField = document.getElementById("distance-field");
      const maxDistanceSelect = document.getElementById("max-distance") as HTMLSelectElement | null;
      const showResultsButton = document.getElementById("show-results") as HTMLButtonElement | null;
      const topInterests = document.getElementById("top-interests");
      const resultsNote = document.getElementById("results-note");
      const recommendationsList = document.getElementById("recommendations");
      const moreButton = document.getElementById("more-results") as HTMLButtonElement | null;

      const answers = new Map<string, string>();
      let currentStep = 0;
      let home: SavedHome | null = null;
      // Whether the results were shown for the current answers; restored results reopen on the next visit.
      let completed = false;
      // Interests the student switched off on the results page; they drop out of the ranking until switched back on.
      let offInterests = new Set<Category>();
      let ranked: Recommendation[] = [];
      // The quiz's own order (best fit first); other sorts reorder this list.
      let rankedByFit: Recommendation[] = [];
      let statsById: SchoolStatsById = {};
      void loadSchoolStats().then((stats) => { statsById = stats; }).catch(() => undefined);
      const resultsSort = document.getElementById("results-sort") as HTMLSelectElement | null;
      let shown = 0;
      let advanceTimer: number | null = null;
      let answersVersion = 0;
      // Bumped on every location change, so a late geolocation answer cannot override a newer choice.
      let locationRequest = 0;

      const cancelAdvance = () => {
        if (advanceTimer !== null) window.clearTimeout(advanceTimer);
        advanceTimer = null;
      };

      // Loads are cached in school-data; start downloading while the user answers.
      const loadData = () => Promise.all([loadSchools(), loadSchoolPrograms()]);
      void loadData().catch(() => undefined);

      const showStep = (index: number, moveFocus = true) => {
        cancelAdvance();
        currentStep = Math.max(0, Math.min(index, totalSteps - 1));
        steps.forEach((step, stepIndex) => { step.hidden = stepIndex !== currentStep; });
        if (stepLabel) {
          stepLabel.textContent = currentStep >= questionCount
            ? "Poslední krok: odkud dojíždíš"
            : `Otázka ${currentStep + 1} z ${questionCount}`;
        }
        if (progressBar) progressBar.style.width = `${((currentStep + 1) / totalSteps) * 100}%`;
        document.querySelectorAll<HTMLElement>("[data-step-character]").forEach((element) => {
          element.hidden = Number(element.dataset.stepCharacter) !== currentStep;
        });
        if (backButton) backButton.disabled = currentStep === 0;
        if (nextButton) {
          const questionId = steps[currentStep]?.dataset.question;
          nextButton.disabled = !questionId || !answers.has(questionId);
        }
        if (!moveFocus) return;
        steps[currentStep]?.querySelector<HTMLElement>("h2")?.focus({ preventScroll: true });
        // On phones the option list is long; bring the start of the next question back into view.
        const navbarHeight = document.querySelector("nav")?.getBoundingClientRect().height ?? 0;
        if (quiz.getBoundingClientRect().top < navbarHeight) quiz.scrollIntoView({ behavior: "smooth", block: "start" });
      };

      const resetQuizButton = document.getElementById("reset-quiz");

      /** Stores the quiz in this browser until the student resets it. */
      const persist = () => {
        if (answers.size === 0 && !home) {
          clearQuiz();
        } else {
          saveQuiz({
            answers: Object.fromEntries(answers),
            home,
            maxDistance: maxDistanceSelect?.value ?? "",
            completed,
            offInterests: [...offInterests],
          });
        }
        if (resetQuizButton) resetQuizButton.hidden = answers.size === 0 && !home;
      };

      const homeMissingNote = document.getElementById("home-missing-note");
      const homeTownLabel = document.getElementById("home-town-label");
      /** Prague is picked by district, other regions by municipality. */
      const townWord = (region: string) => region === "Praha" ? "obvod" : "obec";

      const setHome = (location: SavedHome | null, message: string) => {
        home = location;
        if (homeStatus) homeStatus.textContent = message;
        if (distanceField) distanceField.hidden = location === null;
        if (homeMissingNote) homeMissingNote.hidden = location !== null;
        homeSelect?.classList.remove("border-error!");
        persist();
      };

      /** A chosen region without a municipality (or Prague district) is not a home; ask for the rest. */
      const homeIncomplete = () => Boolean(homeRegionSelect?.value) && home === null;

      const resetResultsButton = () => {
        if (!showResultsButton) return;
        showResultsButton.disabled = false;
        showResultsButton.textContent = "Ukaž moje školy";
      };

      quiz.addEventListener("click", (event) => {
        const target = event.target;
        const option = target instanceof Element ? target.closest<HTMLButtonElement>(".quiz-option") : null;
        const step = option?.closest<HTMLElement>(".quiz-step");
        const questionId = step?.dataset.question;
        const value = option?.dataset.value;
        if (!option || !step || !questionId || !value) return;

        if (answers.size === 0) trackEvent("quiz_start");
        answers.set(questionId, value);
        answersVersion += 1;
        completed = false;
        persist();
        step.querySelectorAll(".quiz-option").forEach((button) => {
          button.setAttribute("aria-pressed", String(button === option));
        });
        cancelAdvance();
        const nextStep = currentStep + 1;
        advanceTimer = window.setTimeout(() => showStep(nextStep), ADVANCE_DELAY_MS);
      });

      backButton?.addEventListener("click", () => showStep(currentStep - 1));
      nextButton?.addEventListener("click", () => showStep(currentStep + 1));

      /** Fills the municipality select with the towns of the chosen region (towns that have a secondary school). */
      const fillTowns = (region: string) => {
        if (!homeSelect) return;
        const regionTowns = towns
          .filter((town) => town.region === region)
          .sort((left, right) => left.name.localeCompare(right.name, "cs", { numeric: true }));
        if (homeTownLabel) homeTownLabel.textContent = region === "Praha" ? "Obvod" : "Obec";
        homeSelect.replaceChildren(
          new Option(region ? `Vyber ${townWord(region)}…` : "Nejdřív vyber kraj", ""),
          ...regionTowns.map((town) => {
            const option = new Option(town.name, `${town.region}|${town.name}`);
            option.dataset.latitude = String(town.latitude);
            option.dataset.longitude = String(town.longitude);
            return option;
          }),
        );
        homeSelect.disabled = regionTowns.length === 0;
      };

      homeRegionSelect?.addEventListener("change", () => {
        locationRequest += 1;
        fillTowns(homeRegionSelect.value);
        setHome(null, "");
      });

      homeSelect?.addEventListener("change", () => {
        locationRequest += 1;
        const option = homeSelect.selectedOptions[0];
        const latitude = Number(option?.dataset.latitude);
        const longitude = Number(option?.dataset.longitude);
        if (!option?.value || !Number.isFinite(latitude) || !Number.isFinite(longitude)) {
          setHome(null, "");
          return;
        }
        setHome({ label: option.textContent ?? "", latitude, longitude, region: homeRegionSelect?.value ?? "", town: option.value }, "");
      });

      maxDistanceSelect?.addEventListener("change", persist);

      geolocationButton?.addEventListener("click", () => {
        if (!navigator.geolocation) {
          if (homeStatus) homeStatus.textContent = "Tenhle prohlížeč polohu neumí. Vyber místo ze seznamu.";
          return;
        }
        if (homeStatus) homeStatus.textContent = "Zjišťuji polohu…";
        locationRequest += 1;
        const request = locationRequest;
        navigator.geolocation.getCurrentPosition(
          ({ coords }) => {
            if (request !== locationRequest) return;
            if (!isInCzechRepublic(coords.latitude, coords.longitude)) {
              if (homeStatus) homeStatus.textContent = "Podle polohy nejsi v Česku. Vyber kraj a obec ze seznamu.";
              return;
            }
            if (homeRegionSelect) homeRegionSelect.value = "";
            fillTowns("");
            setHome(
              { label: "tvoje poloha", latitude: coords.latitude, longitude: coords.longitude, region: "", town: "" },
              "✓ Bereme tvoji aktuální polohu.",
            );
          },
          () => {
            // Keep whatever location was chosen before; only explain what happened.
            if (request !== locationRequest || !homeStatus) return;
            homeStatus.textContent = "Polohu se nepovedlo zjistit. Vyber místo ze seznamu.";
          },
          { timeout: 10000, maximumAge: 300000 },
        );
      });

      const pluralPrograms = (count: number) => count === 1 ? "další obor" : count < 5 ? "další obory" : "dalších oborů";
      /** "Našli jsme 1 školu, která…", "3 školy, které…", "12 škol, které…". */
      const foundSchools = (count: number) => count === 1
        ? "Našli jsme 1 školu, která ti může sednout."
        : `Našli jsme ${count} ${count < 5 ? "školy" : "škol"}, které ti můžou sednout.`;
      const pluralSchools = (count: number) => count === 1 ? "škola" : count > 1 && count < 5 ? "školy" : "škol";

      /** The student's interests in order of strength (all of them, also those switched off) and the ones left on. */
      let allInterests: Category[] = [];
      let activeInterests: Category[] = [];
      let mainCategory: Category | null = null;
      // One colour per interest, by its place among all the student's interests, so a colour stays with its interest
      // when others are switched off, and a card's tags match the switches at the top.
      const INTEREST_COLORS = [
        "bg-primary text-white",
        "bg-sun text-ink",
        "bg-mint text-ink",
        "bg-sky/50 text-ink",
        "bg-peach text-ink",
        "bg-pink/50 text-ink",
        "bg-lime/50 text-ink",
        "bg-orange/40 text-ink",
      ];
      const interestColor = (category: Category) => INTEREST_COLORS[allInterests.indexOf(category)] ?? "bg-muted text-ink";
      const interestTag = (category: Category, size: "card" | "program") => {
        const main = category === mainCategory;
        const sizing = size === "card" ? "px-2.5 py-1 text-xs" : "px-2 py-0.5 text-[11px]";
        return `<span class="inline-flex items-center rounded-full font-bold ${sizing} ${interestColor(category)}${main ? " ring-2 ring-ink/70" : ""}">${main ? "🎯 " : ""}${escapeHtml(categoryLabels[category])}</span>`;
      };

      const renderCard = (school: Recommendation) => {
        const programs = school.programs.slice(0, 2);
        // The interests behind the school's place in the list: those its best program serves (a combination when
        // there are several), main interest first.
        const bestMatch = matchedInterests(school.programs[0]?.categories ?? [], activeInterests);
        const more = school.programs.length - programs.length;
        const href = withBase(`/skoly/${encodeURIComponent(school.id)}/`);
        const facts = schoolFacts(sortable(school), currentSort());
        return `
          <article class="school-card p-5" data-school-id="${escapeHtml(school.id)}">
            <a class="font-display text-xl font-extrabold leading-snug text-ink hover:text-primary" href="${href}">${escapeHtml(school.name)}</a>
            <p class="mt-1 text-sm text-muted-foreground">${escapeHtml(school.region)}</p>
            <p class="mt-2 flex flex-wrap gap-2 text-xs">
              ${tuitionChipHtml(school.founderCode)}
              ${school.dormitory ? `<span class="rounded-full bg-mint/40 px-2.5 py-1 font-bold text-ink">🛏️ Má internát: ${escapeHtml(school.dormitory)}</span>` : ""}
              ${openDayChipHtml(school.openDays, localToday())}
            </p>
            ${facts.length ? `<p class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs font-semibold text-ink/80">${facts.map((fact) => `<span>${escapeHtml(fact)}</span>`).join("")}</p>` : ""}
            ${school.supportMatch && school.support
              ? `<p class="mt-3 mr-2 inline-block rounded-full bg-sky/25 px-3 py-1 text-xs font-bold text-ink">🤝 Škola ${escapeHtml(supportLabels[school.support])}</p>`
              : ""}
            ${bestMatch.length
              ? `<p class="mt-3 flex flex-wrap items-center gap-1.5 text-xs">
                  <span class="font-semibold text-muted-foreground">${bestMatch.length > 1 ? "Sedí ke kombinaci:" : "Sedí k zájmu:"}</span>
                  ${bestMatch.map((category, index) => `${index > 0 ? `<span class="font-bold text-muted-foreground" aria-hidden="true">+</span>` : ""}${interestTag(category, "card")}`).join("")}
                </p>`
              : ""}
            <ul class="mt-3 space-y-1.5 text-sm">
              ${programs.map((program) => {
                const matched = matchedInterests(program.categories, activeInterests);
                // Tags only where a program differs from the school's combination above; repeating it adds noise.
                const tags = matched.join() === bestMatch.join() ? [] : matched;
                return `<li class="flex gap-2"><span class="text-primary" aria-hidden="true">✓</span><span><a class="underline decoration-primary/40 underline-offset-2 hover:text-primary" href="${programPageUrl(program.code)}" title="Všechny školy s tímto oborem">${escapeHtml(program.name)}</a>${tags.length
                  ? ` <span class="ml-1 inline-flex flex-wrap gap-1 align-middle">${tags.map((category) => interestTag(category, "program")).join("")}</span>`
                  : ""}</span></li>`;
              }).join("")}
            </ul>
            ${more > 0 ? `<p class="mt-1 text-xs text-muted-foreground">+ ${more} ${pluralPrograms(more)}</p>` : ""}
            <a class="btn-primary mt-4 w-full sm:w-auto" href="${href}">Detail školy →</a>
          </article>`;
      };

      let mainLabel: string | null = null;

      const programsSection = document.getElementById("recommended-programs");
      const programsList = document.getElementById("recommended-programs-list");
      /** The programs behind the recommendations, each linking to all schools that offer it. */
      const renderPrograms = () => {
        if (!programsSection || !programsList) return;
        // Gymnázium-track results also list lyceums that only fit the track; recommend those tied to an interest.
        const fitting = rankedByFit.map((school) => ({
          ...school,
          programs: school.programs.filter((program) => matchedInterests(program.categories, activeInterests).length > 0),
        }));
        const programs = recommendedPrograms(fitting);
        programsSection.hidden = programs.length === 0;
        // Same name, different program (4- and 8-year gymnázium): tell them apart by the code.
        const names = programs.map((program) => program.name);
        programsList.innerHTML = programs.map((program) => {
          const duplicate = names.filter((name) => name === program.name).length > 1;
          const matched = matchedInterests(program.categories, activeInterests);
          return `<li>
            <a class="flex h-full flex-col gap-1.5 rounded-[3px] border border-border bg-card p-3 shadow-paper transition hover:-translate-y-0.5 hover:shadow-paper-lift" href="${programPageUrl(program.code)}">
              <span class="font-semibold text-foreground">${escapeHtml(program.name)}${duplicate ? ` <span class="text-xs font-normal text-muted-foreground">${escapeHtml(program.code)}</span>` : ""}</span>
              ${matched.length ? `<span class="flex flex-wrap gap-1">${matched.map((category) => interestTag(category, "program")).join("")}</span>` : ""}
              <span class="text-xs font-semibold text-primary">Školy s tímto oborem →</span>
            </a>
          </li>`;
        }).join("");
      };

      const interestHint = document.getElementById("interest-hint");
      /** The student's interests as switches: on ones in their colour, off ones faded and struck through. */
      const renderInterestSwitches = () => {
        if (!topInterests) return;
        if (interestHint) interestHint.hidden = allInterests.length < 2;
        if (allInterests.length === 0) {
          topInterests.innerHTML = `<span class="font-hand rounded-[2px] bg-white px-3 py-0.5 text-2xl font-bold text-ink">Zatím nic jasného, a to je v pohodě</span>`;
          return;
        }
        topInterests.innerHTML = allInterests.map((category) => {
          const on = !offInterests.has(category);
          const look = on
            ? `${interestColor(category)} odd:-rotate-1 even:rotate-1`
            : "bg-white/60 text-muted-foreground line-through decoration-2 opacity-70";
          return `<button type="button" data-interest="${category}" aria-pressed="${on}" class="font-hand rounded-[2px] px-3 py-0.5 text-2xl font-bold transition hover:scale-105 ${look}">${on ? "" : "＋ "}${escapeHtml(categoryLabels[category])}</button>`;
        }).join("");
      };

      topInterests?.addEventListener("click", (event) => {
        const target = event.target;
        const button = target instanceof Element ? target.closest<HTMLButtonElement>("[data-interest]") : null;
        const category = allInterests.find((item) => item === button?.dataset.interest);
        if (!category) return;
        if (offInterests.has(category)) {
          offInterests.delete(category);
        } else if (activeInterests.length > 1) {
          offInterests.add(category);
        } else {
          if (interestHint) interestHint.textContent = "Aspoň jeden zájem musí zůstat zapnutý.";
          return;
        }
        if (interestHint) interestHint.textContent = "Klepnutím zájem vypneš nebo zase zapneš a školy se hned přepočítají.";
        // The switches are redrawn; keep keyboard focus on the one just pressed.
        void showResults(false, true).then(() => {
          topInterests.querySelector<HTMLButtonElement>(`[data-interest="${category}"]`)?.focus();
        });
      });

      const sortable = (school: Recommendation) => ({
        name: school.name,
        capacity: school.capacity,
        interestScore: school.score,
        distanceKm: school.distanceKm,
        stats: statsById[school.id] ?? null,
      });
      const currentSort = (): SortKey => {
        const value = resultsSort?.value ?? "match";
        return isSortKey(value) ? value : "match";
      };
      const applySort = () => {
        const key = currentSort();
        const compare = compareSchools(key);
        ranked = key === "match" ? rankedByFit : [...rankedByFit].sort((left, right) => compare(sortable(left), sortable(right)));
      };
      resultsSort?.addEventListener("change", () => {
        applySort();
        clearResultsView();
        if (recommendationsList && ranked.length) recommendationsList.innerHTML = "";
        shown = 0;
        renderMore();
        trackEvent("search", { where: "vysledky-razeni", q: "", sort: currentSort(), results: ranked.length });
      });

      const renderMore = () => {
        if (!recommendationsList) return;
        const next = ranked.slice(shown, shown + PAGE_SIZE);
        recommendationsList.insertAdjacentHTML("beforeend", next.map((school) => renderCard(school)).join(""));
        shown += next.length;
        if (moreButton) {
          const remaining = ranked.length - shown;
          moreButton.hidden = remaining <= 0;
          moreButton.textContent = `Zobrazit další školy (${remaining})`;
        }
      };

      /**
       * Ranks and shows the schools. `restoring` reopens saved results (back from a school, reload); `rerank` redraws
       * them after an interest was switched on or off, without leaving the results or scrolling.
       */
      const showResults = async (restoring = false, rerank = false) => {
        // New results from the quiz start with every interest on.
        if (!restoring && !rerank) offInterests = new Set();
        if (showResultsButton) {
          showResultsButton.disabled = true;
          showResultsButton.textContent = "Hledám ti školy…";
        }

        // Same scoring as the unit tests: weights and questions come from src/lib/quiz-questions.ts.
        const answerRecord = Object.fromEntries(answers);
        const totals = computeTotals(answerRecord);
        const primary = primaryInterest(answerRecord);
        const interests = rankInterests(totals, primary);
        // Switching off every interest would leave nothing to rank by; then all of them count again.
        if (interests.every((category) => offInterests.has(category))) offInterests = new Set();
        const activeTotals = withoutInterests(totals, offInterests);
        const activePrimary = primary && !offInterests.has(primary) ? primary : null;
        const track = studyTrack(answerRecord);
        const support = supportNeed(answerRecord);
        const maxDistance = home && maxDistanceSelect?.value ? Number(maxDistanceSelect.value) : null;
        const requestedVersion = answersVersion;
        // Back from a school detail (or a reload): reopen the same sort, the same number of cards and that school.
        // The card count and the school only make sense in the order they were saved with.
        const savedView = restoring ? loadResultsView() : null;
        const view = savedView && resultsSort && isSortKey(savedView.sort) && !(savedView.sort === "distance" && !home) ? savedView : null;
        if (!restoring) clearResultsView();
        let withoutLocation: number;
        let mainInterest: Category | null;

        try {
          const [schools, programsById] = await loadData();
          // CERMAT sorts need the figures, which load separately; without them the saved order would differ.
          if (view && view.sort !== "match" && view.sort !== "distance") {
            statsById = await loadSchoolStats().catch(() => statsById);
          }
          if (requestedVersion !== answersVersion || (!rerank && (currentStep !== totalSteps - 1 || quiz.hidden))) {
            resetResultsButton();
            return;
          }
          const result = rankSchools({
            schools,
            programsById,
            totals: activeTotals,
            track,
            home,
            maxDistanceKm: maxDistance,
            primaryInterest: activePrimary,
            support,
          });
          rankedByFit = result.schools;
          // Sorting by distance needs a home; without one fall back to the quiz order.
          const distanceOption = resultsSort?.querySelector<HTMLOptionElement>('option[value="distance"]');
          if (distanceOption) distanceOption.disabled = !home;
          if (resultsSort && !home && resultsSort.value === "distance") resultsSort.value = "match";
          if (view && resultsSort) resultsSort.value = view.sort;
          applySort();
          if (!restoring && !rerank) {
            trackEvent("quiz_complete", {
              interest: primary ?? "",
              track: track ?? "",
              support: support ?? "none",
              homeRegion: home ? home.region || "poloha" : null,
              maxDistance: maxDistance ?? "",
              results: result.schools.length,
              mainMatches: result.schools.filter((school) => school.matchesMain).length,
            });
          }
          withoutLocation = result.withoutLocation;
          mainInterest = result.mainInterest;
        } catch {
          if (homeStatus) homeStatus.textContent = "Školy se nepovedlo načíst. Mrkni na připojení a zkus to znovu.";
          resetResultsButton();
          return;
        }

        // The badge and note describe rankSchools' own main interest, so they cannot drift from matchesMain.
        mainLabel = mainInterest ? categoryLabels[mainInterest] : null;
        mainCategory = mainInterest;
        allInterests = interests;
        activeInterests = interests.filter((category) => !offInterests.has(category));
        renderInterestSwitches();
        renderPrograms();
        if (resultsNote) {
          // With no results at all the empty-state message in the list explains it; no note about interests.
          const supportFirst = support && ranked.some((school) => school.supportMatch)
            ? `Úplně nahoře jsou školy ${supportLabels[support]}${support === "svp" ? " a obory pro ně určené" : ", i když jejich obory neodpovídají všem tvým zájmům"}. `
            : "";
          const mainFirst = ranked.length === 0
            ? ""
            : mainLabel && ranked.some((school) => school.matchesMain)
            ? `Nahoře jsou školy, kde se učí to, co tě baví nejvíc (${mainLabel}). Pod nimi další.`
            : mainLabel
              ? `Na tvůj hlavní zájem (${mainLabel}) jsme tady nic nenašli, tak ukazujeme školy podle dalších zájmů.`
              : "";
          const gymnasiumNote = track === "general"
            ? " Gympl je všeobecný, proto ukazujeme i lycea: taky dají široký základ, ale k tomu zaměření podle toho, co tě baví."
            : "";
          const order = home
            ? ` Když školy sedí stejně, vyhrává ta blíž k: ${home.label}${maxDistance ? ` (max ${maxDistance} km)` : ""}.`
            : " Když vyplníš, odkud dojíždíš, seřadíme školy i podle vzdálenosti.";
          const skipped = withoutLocation > 0
            ? ` ${withoutLocation} ${pluralSchools(withoutLocation)} bez známé polohy jsme v limitu vzdálenosti nemohli započítat.`
            : "";
          resultsNote.textContent = ranked.length === 0
            ? `Tady jsme nic nenašli.${skipped}`
            : `${foundSchools(ranked.length)} ${supportFirst}${mainFirst}${gymnasiumNote}${order}${skipped}`;
        }
        // The chosen kind of school may not teach the main interest at all (music on an apprenticeship, cars at a
        // gymnázium). Say so and offer the same answers with any kind of school.
        const trackHint = document.getElementById("track-hint");
        const trackHintText = document.getElementById("track-hint-text");
        const mainMissing = ranked.length === 0 || (mainLabel !== null && !ranked.some((school) => school.matchesMain));
        if (trackHint && trackHintText) {
          trackHint.hidden = !(mainMissing && track !== "any");
          const trackName = track === "general" ? "Gympl" : track === "vyucni" ? "Učňák" : "Obor s maturitou";
          trackHintText.textContent = mainLabel
            ? `${trackName} na tvůj hlavní zájem (${mainLabel}) nic nemá. Zkus to bez ohledu na typ školy, ať vidíš, kde se to dá studovat.`
            : `${trackName} tady nic nenašel. Zkus to bez ohledu na typ školy.`;
        }
        if (recommendationsList) {
          recommendationsList.innerHTML = ranked.length
            ? ""
            : `<p class="rounded-2xl border border-dashed border-border p-6 text-sm text-muted-foreground">${maxDistance ? "Takhle blízko nic není. Zkus delší dojíždění." : "Nic jsme nenašli. Zkus změnit odpovědi."}</p>`;
        }
        shown = 0;
        renderMore();
        // Render at least as many cards as before, and far enough to include the opened school if it moved.
        const needed = view ? Math.max(view.shown, ranked.findIndex((school) => school.id === view.schoolId) + 1) : 0;
        while (shown < needed && shown < ranked.length) renderMore();
        // Used once: a later reload should not jump back to this school again.
        if (view) clearResultsView();

        quiz.hidden = true;
        // The companion sits outside the quiz card; hide it together with the quiz.
        document.getElementById("step-companions")?.setAttribute("hidden", "");
        results.hidden = false;
        if (!restoring && !rerank) results.scrollIntoView({ behavior: "smooth", block: "start" });
        if (view?.schoolId) {
          recommendationsList?.querySelector(`.school-card[data-school-id="${CSS.escape(view.schoolId)}"]`)?.scrollIntoView({ block: "center" });
        }
        resetResultsButton();
        completed = true;
        persist();
        // The support panel asks for a donation only after the quiz has helped (SupportPanel.astro).
        if (!restoring && !rerank) document.dispatchEvent(new CustomEvent("support:offer"));
      };

      const backToQuiz = () => {
        results.hidden = true;
        quiz.hidden = false;
        document.getElementById("step-companions")?.removeAttribute("hidden");
        showStep(0);
        quiz.scrollIntoView({ behavior: "smooth", block: "start" });
      };

      showResultsButton?.addEventListener("click", () => {
        if (homeIncomplete()) {
          const region = homeRegionSelect?.value ?? "";
          if (homeStatus) {
            homeStatus.textContent = `Vyber ještě ${townWord(region)}${region === "Praha" ? "" : " v kraji"}, jinak nepoznáme, jak daleko to máš. Nebo kraj zruš a pokračuj bez bydliště.`;
          }
          homeSelect?.classList.add("border-error!");
          homeSelect?.focus();
          return;
        }
        void showResults();
      });
      document.getElementById("switch-track")?.addEventListener("click", () => {
        const trackStep = steps.find((step) => step.dataset.question === "track");
        answers.set("track", "any");
        answersVersion += 1;
        completed = false;
        trackStep?.querySelectorAll<HTMLElement>(".quiz-option").forEach((button) => {
          button.setAttribute("aria-pressed", String(button.dataset.value === "any"));
        });
        persist();
        // showResults only runs from the last step of a visible quiz.
        results.hidden = true;
        quiz.hidden = false;
        showStep(totalSteps - 1, false);
        void showResults();
      });
      moreButton?.addEventListener("click", renderMore);
      recommendationsList?.addEventListener("click", (event) => {
        // Only a school opened in this tab: a new tab leaves this list where it is.
        if (!clickedSchoolLink(event) || !(event.target instanceof Element)) return;
        const schoolId = event.target.closest<HTMLElement>(".school-card")?.dataset.schoolId;
        if (schoolId) saveResultsView({ sort: currentSort(), shown, schoolId });
      });
      document.getElementById("edit-answers")?.addEventListener("click", backToQuiz);
      const resetQuiz = () => {
        trackEvent("quiz_reset");
        answers.clear();
        answersVersion += 1;
        completed = false;
        locationRequest += 1;
        quiz.querySelectorAll(".quiz-option").forEach((button) => button.setAttribute("aria-pressed", "false"));
        if (homeRegionSelect) homeRegionSelect.value = "";
        fillTowns("");
        if (maxDistanceSelect) maxDistanceSelect.value = "";
        setHome(null, "");
        clearQuiz();
        backToQuiz();
      };
      document.getElementById("restart")?.addEventListener("click", resetQuiz);
      resetQuizButton?.addEventListener("click", resetQuiz);

      /** Restores the saved quiz: answers, home, commute limit, and the results if they were shown. */
      const restore = () => {
        const saved = loadQuiz();
        if (!saved) return false;
        for (const [questionId, value] of Object.entries(saved.answers)) {
          const step = steps.find((item) => item.dataset.question === questionId);
          if (!step) continue;
          answers.set(questionId, value);
          step.querySelectorAll<HTMLElement>(".quiz-option").forEach((button) => {
            button.setAttribute("aria-pressed", String(button.dataset.value === value));
          });
        }
        if (maxDistanceSelect) maxDistanceSelect.value = saved.maxDistance;
        const savedHome = saved.home;
        if (savedHome?.region && homeRegionSelect && homeSelect) {
          homeRegionSelect.value = savedHome.region;
          fillTowns(homeRegionSelect.value);
          homeSelect.value = savedHome.town;
          // The town list can change between data updates; drop a home that no longer exists.
          setHome(homeSelect.value && homeSelect.value === savedHome.town ? savedHome : null, "");
        } else if (savedHome && !savedHome.region) {
          setHome(savedHome, "✓ Bereme tvoji uloženou polohu.");
        } else {
          setHome(null, "");
        }
        completed = saved.completed;
        offInterests = new Set(saved.offInterests);
        if (completed) {
          showStep(totalSteps - 1, false);
          void showResults(true);
          return true;
        }
        const firstOpen = steps.findIndex((step) => step.dataset.question && !answers.has(step.dataset.question));
        showStep(firstOpen === -1 ? totalSteps - 1 : firstOpen, false);
        return true;
      };

      /**
       * The homepage asks the first question itself and links here with ?zajem=<answer>.
       * The answer replaces a saved one, and the quiz continues with the next question.
       */
      const startFromHomepage = () => {
        const url = new URL(window.location.href);
        const value = url.searchParams.get("zajem");
        if (!value) return false;
        url.searchParams.delete("zajem");
        window.history.replaceState(window.history.state, "", url);
        const firstStep = steps[0];
        const questionId = firstStep?.dataset.question;
        const option = [...(firstStep?.querySelectorAll<HTMLElement>(".quiz-option") ?? [])].find((button) => button.dataset.value === value);
        if (!firstStep || !questionId || !option) return false;
        if (answers.size === 0) trackEvent("quiz_start", { from: "home" });
        answers.set(questionId, value);
        answersVersion += 1;
        completed = false;
        firstStep.querySelectorAll(".quiz-option").forEach((button) => button.setAttribute("aria-pressed", String(button === option)));
        results.hidden = true;
        quiz.hidden = false;
        document.getElementById("step-companions")?.removeAttribute("hidden");
        persist();
        showStep(1, false);
        return true;
      };

      const restored = restore();
      if (!startFromHomepage() && !restored) showStep(0, false);
    });
  </script>
</BaseLayout>
