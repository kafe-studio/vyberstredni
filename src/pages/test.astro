---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import { schools } from "../data/schools";

const metadata = {
  title: "Test zájmů",
  description: "Osm otázek pokrývá 12 oblastí zájmu a propojí tvoje odpovědi s konkrétními středoškolskými obory.",
};

const totalSchoolCount = schools.length;
const questions = [
  {
    id: "interests",
    prompt: "Který obor z nabídky tě nejvíc zajímá?",
    options: [
      { value: "science", label: "Matematika a přírodní vědy (např. Aplikovaná chemie, Přírodovědné lyceum)" },
      { value: "nature", label: "Zvířata a příroda (např. Veterinářství, Chovatelství, Ekologie a životní prostředí)" },
      { value: "digital", label: "Programování a počítače (např. Informační technologie)" },
      { value: "engineering", label: "Stroje a stavby (např. Strojírenství, Elektrotechnika, Stavebnictví)" },
      { value: "health", label: "Zdravotnictví (např. Praktická sestra, Ošetřovatel)" },
      { value: "safety", label: "Bezpečnost a IZS (např. Požární ochrana, Bezpečnostně právní činnost)" },
      { value: "design", label: "Umění a média (např. Multimediální tvorba, Užitá fotografie a média)" },
      { value: "business", label: "Obchod a podnikání (např. Obchodní akademie, Ekonomika a podnikání)" },
      { value: "hospitality", label: "Gastronomie a cestovní ruch (např. Hotelnictví, Kuchař - číšník, Cestovní ruch)" },
      { value: "people", label: "Vzdělávání a sociální práce (např. Pedagogické lyceum, Sociální činnost)" },
      { value: "practical", label: "Řemesla (např. Truhlář, Instalatér, Mechanik opravář motorových vozidel)" },
      { value: "general", label: "Všeobecné studium (např. Gymnázium)" },
    ],
  },
  {
    id: "project",
    prompt: "Který školní projekt by sis nejraději vybral/a?",
    options: [
      { value: "nature", label: "Navrhnout, jak lépe pečovat o zvířata nebo přírodu" },
      { value: "science", label: "Zkoumat vzorky a zjistit, jak se chovají různé látky" },
      { value: "engineering", label: "Postavit nebo opravit stroj, zařízení či model budovy" },
      { value: "safety", label: "Připravit postup pro zásah při požáru nebo nehodě" },
      { value: "health", label: "Vymyslet, jak pomoci pacientovi nebo pečovat o jeho zdraví" },
      { value: "business", label: "Rozjet malý podnik a spočítat jeho rozpočet" },
      { value: "hospitality", label: "Připravit menu, akci nebo plán výletu pro hosty" },
      { value: "people", label: "Vytvořit program, který pomůže dětem učit se a rozvíjet" },
      { value: "practical", label: "Vyrobit užitečný předmět vlastníma rukama" },
      { value: "design", label: "Navrhnout grafiku, video nebo vizuální kampaň" },
    ],
  },
  {
    id: "workplace",
    prompt: "Kde bys chtěl/a nejraději trávit pracovní den?",
    options: [
      { value: "digital", label: "U počítače, kde tvořím programy nebo spravuji sítě" },
      { value: "science", label: "V laboratoři, kde zkoumám vzorky a výsledky pokusů" },
      { value: "engineering", label: "V dílně, na stavbě nebo u dopravní techniky" },
      { value: "nature", label: "Venku, na farmě, v přírodě nebo u zvířat" },
      { value: "health", label: "V nemocnici, ordinaci nebo zdravotnickém zařízení" },
      { value: "safety", label: "V terénu při ochraně lidí a řešení krizových situací" },
      { value: "design", label: "V ateliéru, redakci nebo grafickém studiu" },
      { value: "business", label: "Ve firmě, obchodě nebo při organizování projektů" },
      { value: "hospitality", label: "V kuchyni, hotelu nebo při práci s cestujícími a hosty" },
      { value: "people", label: "Ve škole, poradně nebo sociální službě" },
      { value: "practical", label: "V dílně při výrobě, opravách nebo řemeslné práci" },
    ],
  },
  {
    id: "problem",
    prompt: "Jaký problém by tě nejvíc bavilo vyřešit?",
    options: [
      { value: "digital", label: "Jak vytvořit aplikaci, která lidem usnadní práci" },
      { value: "science", label: "Proč se látka nebo přírodní jev chová určitým způsobem" },
      { value: "nature", label: "Jak zlepšit podmínky pro zvířata a chránit krajinu" },
      { value: "engineering", label: "Jak opravit porouchaný stroj nebo navrhnout bezpečnou stavbu" },
      { value: "safety", label: "Jak rychle a bezpečně pomoci při nehodě nebo požáru" },
      { value: "health", label: "Jak pečovat o člověka, který je nemocný nebo zraněný" },
      { value: "business", label: "Jak naplánovat rozpočet, zásobování nebo prodej" },
      { value: "hospitality", label: "Jak připravit dobré jídlo nebo služby pro hosty" },
      { value: "people", label: "Jak podpořit člověka, který potřebuje pomoc nebo vedení" },
      { value: "practical", label: "Jak něco vyrobit, opravit nebo připravit k použití" },
    ],
  },
  {
    id: "activities",
    prompt: "Která činnost tě dokáže nejvíc vtáhnout?",
    options: [
      { value: "nature", label: "Pozorovat přírodu, pěstovat rostliny nebo pečovat o zvířata" },
      { value: "science", label: "Počítat, dělat pokusy a hledat vysvětlení" },
      { value: "design", label: "Kreslit, fotit, tvořit video nebo navrhovat vzhled věcí" },
      { value: "digital", label: "Zkoušet nové aplikace, programovat nebo skládat techniku" },
      { value: "hospitality", label: "Vařit, připravovat akce nebo plánovat cestování" },
      { value: "business", label: "Vymýšlet, jak něco nabídnout lidem a dobře zorganizovat" },
      { value: "people", label: "Vysvětlovat, učit nebo pomáhat ostatním" },
      { value: "practical", label: "Pracovat s nástroji, materiálem a něco konkrétního dokončit" },
      { value: "safety", label: "Trénovat první pomoc a postupy pro krizové situace" },
    ],
  },
  {
    id: "school-subjects",
    prompt: "Který okruh předmětů by sis vybral/a jako svůj oblíbený?",
    options: [
      { value: "science", label: "Matematika, fyzika, chemie a přírodovědné pokusy" },
      { value: "nature", label: "Biologie, ekologie a život zvířat" },
      { value: "engineering", label: "Technika, elektřina, stroje a konstrukce" },
      { value: "digital", label: "Informatika, programování a digitální tvorba" },
      { value: "health", label: "Biologie člověka, zdraví a péče o pacienty" },
      { value: "safety", label: "Bezpečnost, právo a fungování záchranných složek" },
      { value: "business", label: "Ekonomie, finance, obchod a podnikání" },
      { value: "design", label: "Výtvarná tvorba, média, hudba a design" },
      { value: "people", label: "Pedagogika, psychologie a společenská témata" },
      { value: "hospitality", label: "Cestování, jídlo, hotelnictví a služby hostům" },
    ],
  },
  {
    id: "impact",
    prompt: "S čím bys chtěl/a v budoucnu pomáhat nebo něco zlepšit?",
    options: [
      { value: "nature", label: "Chrání přírodu, zvířata a udržitelné hospodaření" },
      { value: "health", label: "Zdraví, léčbu a každodenní péči o lidi" },
      { value: "safety", label: "Bezpečnost lidí, prevenci a pomoc při mimořádných událostech" },
      { value: "people", label: "Vzdělávání dětí a podporu lidí v náročné situaci" },
      { value: "digital", label: "Užitečné digitální nástroje a dostupnost informací" },
      { value: "engineering", label: "Dopravu, budovy a technická řešení pro okolí" },
      { value: "business", label: "Fungování firem, obchodů a místních služeb" },
      { value: "hospitality", label: "Cestovní ruch, kvalitní služby pro návštěvníky a hosty" },
      { value: "design", label: "Kulturu, média a způsob, jak lidé sdílejí nápady" },
      { value: "practical", label: "Kvalitní výrobky, opravy a poctivé řemeslo" },
    ],
  },
  {
    id: "future",
    prompt: "Když si představíš své budoucí povolání, které zadání tě láká nejvíc?",
    options: [
      { value: "science", label: "Zkoumat vzorky, přírodní jevy nebo nové materiály" },
      { value: "nature", label: "Pracovat se zvířaty, rostlinami nebo ochranou krajiny" },
      { value: "health", label: "Pečovat o zdraví lidí nebo jim pomáhat v léčbě" },
      { value: "safety", label: "Být součástí policie, požární ochrany nebo krizové pomoci" },
      { value: "engineering", label: "Navrhovat, opravovat nebo obsluhovat technická zařízení" },
      { value: "digital", label: "Programovat, spravovat počítače nebo tvořit digitální služby" },
      { value: "business", label: "Vést obchod, finance nebo vlastní podnikání" },
      { value: "hospitality", label: "Vařit, pracovat s hosty nebo organizovat cestovní ruch" },
      { value: "design", label: "Tvořit grafiku, média, hudbu nebo umělecké projekty" },
      { value: "people", label: "Učit, vychovávat nebo podporovat lidi a jejich rozvoj" },
      { value: "practical", label: "Vyrábět, opravovat a každý den vidět konkrétní výsledek práce" },
    ],
  },
];

---

<BaseLayout {metadata}>
  <section class="px-6 py-24">
    <div class="mx-auto max-w-5xl">
      <div class="mb-10 text-center reveal">
        <p class="text-sm font-semibold uppercase tracking-[0.24em] text-muted-foreground">Test zájmů</p>
        <h1 class="mt-4 text-4xl font-black md:text-5xl">Najdi obory, které odpovídají tvým zájmům</h1>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-muted-foreground">
          Osm otázek pokrývá obory od zvířat a přírody přes matematiku a přírodní vědy až po techniku, zdravotnictví, bezpečnost a IZS, umění, podnikání i řemesla.
        </p>
        <p class="mx-auto mt-3 max-w-3xl text-sm text-muted-foreground">
          Každá odpověď se propojuje s konkrétními obory z nabídky škol; doporučení se řadí podle jejich shody se všemi odpověďmi a tvým volitelným zaměřením. Gymnázium se doporučí jen tehdy, když zvolíš všeobecné studium.
          Nejde o odborně validovaný psychologický test, hodnocení školy ani odhad šance na přijetí.
        </p>
      </div>

      <div class="hidden" data-school-count={totalSchoolCount}></div>
      <div class="mb-8 rounded-[2rem] border border-border bg-card p-6 reveal">
        <fieldset class="mb-6 border-b border-border pb-6">
          <legend class="text-lg font-semibold text-foreground">Bydliště: kde bydlíš?</legend>
          <p class="mt-1 text-sm text-muted-foreground">Začni psát ulici, číslo domu a obec. Adresa se vyhledává v Praze a Středočeském kraji; souřadnice se počítají jen v prohlížeči.</p>
          <label for="home-address-input" class="mt-4 block text-sm font-medium text-foreground">Přesná adresa</label>
          <input
            id="home-address-input"
            type="search"
            role="combobox"
            aria-autocomplete="list"
            aria-controls="home-address-options"
            aria-expanded="false"
            aria-describedby="address-search-help"
            autocomplete="off"
            class="mt-2 w-full rounded-xl border border-border bg-background/40 px-3 py-2.5 text-foreground"
            placeholder="Např. Cyrila Boudy 2954, Kladno"
          />
          <ul id="home-address-options" role="listbox" class="mt-1 hidden max-h-64 overflow-y-auto rounded-xl border border-border bg-card shadow-lg"></ul>
          <p id="address-search-help" class="mt-2 text-xs text-muted-foreground">
            Našeptávání využívá <a href="https://photon.komoot.io/" target="_blank" rel="noreferrer" class="underline">Photon</a> nad daty OpenStreetMap. Po zadání alespoň 4 znaků se hledaný text odešle službě Photon; aplikace ho neukládá. <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noreferrer" class="underline">O zdrojových datech</a>.
          </p>
          <div class="mt-4 grid gap-3 sm:grid-cols-[1fr_auto]">
            <label>
              <span class="mb-2 block text-sm font-medium text-foreground">Nebo rychle vyber město</span>
              <select id="home-location-preset" class="w-full rounded-xl border border-border bg-background/40 px-3 py-2.5 text-foreground">
                <option value="">Vyber město…</option>
                <option value="praha-karlin">Praha – Karlín</option>
                <option value="praha-liben">Praha – Libeň</option>
                <option value="praha-cakovice">Praha – Čakovice</option>
                <option value="praha-vinohrady">Praha – Vinohrady</option>
                <option value="kladno">Kladno</option>
                <option value="slany">Slaný</option>
                <option value="benesov">Benešov</option>
                <option value="melnik">Mělník</option>
                <option value="kolin">Kolín</option>
              </select>
            </label>
            <button id="use-geolocation-btn" type="button" class="btn-outline">Použít moji polohu</button>
          </div>
          <p id="home-location-status" class="mt-3 text-sm text-muted-foreground" aria-live="polite">Pro pokračování zvol místo bydliště.</p>
          <details id="home-map-disclosure" class="mt-4 rounded-xl border border-border p-4">
            <summary class="cursor-pointer font-medium text-foreground">Zobrazit mapu pro výběr bydliště</summary>
            <div id="home-map" class="mt-3 h-72 w-full overflow-hidden rounded-xl border border-border"></div>
            <p id="recommendation-map-status" class="mt-2 text-sm text-muted-foreground" aria-live="polite"></p>
            <p class="mt-2 text-xs text-muted-foreground">Po vyhodnocení se zde mohou zobrazit také doporučené školy. Souřadnice využíváme jen pro výpočet v prohlížeči. OpenStreetMap načítá mapové dlaždice; podrobnosti najdeš v jeho zásadách ochrany soukromí.</p>
          </details>
          <label class="mt-4 block max-w-sm">
            <span class="mb-2 block text-sm font-medium text-foreground">Největší vzdálenost od bydliště</span>
            <select id="max-distance" class="w-full rounded-xl border border-border bg-background/40 px-3 py-2.5 text-foreground">
              <option value="">Bez limitu</option>
              <option value="10">Do 10 km</option>
              <option value="20">Do 20 km</option>
              <option value="30">Do 30 km</option>
              <option value="50">Do 50 km</option>
              <option value="100">Do 100 km</option>
            </select>
          </label>
        </fieldset>

        <div class="grid gap-4 md:grid-cols-2">
          <div>
            <label for="student-profile" class="mb-2 block text-sm font-medium text-foreground">Máš už vybranou oblast zájmu? (nepovinné)</label>
            <select id="student-profile" class="w-full rounded-xl border border-border bg-background/40 px-3 py-2.5 text-foreground">
              <option value="balanced">Zatím nemám jednu vybranou</option>
              <option value="digital">Digitální technologie a informatika</option>
              <option value="engineering">Technika, stroje, doprava a stavby</option>
              <option value="science">Matematika, chemie a přírodní vědy</option>
              <option value="nature">Zvířata, zemědělství a životní prostředí</option>
              <option value="health">Zdravotnictví a péče o zdraví</option>
              <option value="safety">Bezpečnost, veřejná správa a IZS</option>
              <option value="design">Umění, média, grafika a design</option>
              <option value="business">Ekonomie, podnikání a obchod</option>
              <option value="hospitality">Gastronomie, hotelnictví a cestovní ruch</option>
              <option value="people">Pedagogika, sociální práce a vzdělávání</option>
              <option value="practical">Řemesla, výroba a praktické služby</option>
              <option value="general">Všeobecné studium</option>
            </select>
          </div>
          <div>
            <label for="priority-profile" class="mb-2 block text-sm font-medium text-foreground">Jaký typ školy preferuješ?</label>
            <select id="priority-profile" class="w-full rounded-xl border border-border bg-background/40 px-3 py-2.5 text-foreground">
              <option value="fit">Bez preference</option>
              <option value="private">Soukromou školu</option>
              <option value="public">Veřejnou školu</option>
              <option value="conservatory">Konzervatoř</option>
              <option value="apprenticeship">Učiliště</option>
            </select>
          </div>
        </div>

        <div class="mt-6">
          <div class="mb-2 flex items-center justify-between text-sm text-muted-foreground">
            <span>Průběh testu</span>
            <span id="progress-text">0/{questions.length}</span>
          </div>
          <div class="h-2.5 overflow-hidden rounded-full bg-muted">
            <div id="progress-bar" class="h-full w-0 rounded-full bg-gradient-to-r from-blue-500 to-cyan-400 transition-all duration-300"></div>
          </div>
        </div>
      </div>

      <form id="quiz-form" class="space-y-8" data-question-count={questions.length}>
        {questions.map((question, index) => (
          <fieldset data-question class="rounded-[2rem] border border-border bg-card p-6 reveal">
            <legend class="mb-5 block text-lg font-semibold">
              {index + 1}. {question.prompt}
            </legend>
            <div class="grid gap-3 md:grid-cols-2">
              {question.options.map((option) => (
                <label class="flex cursor-pointer items-start gap-3 rounded-2xl border border-border bg-background/40 p-4 transition-colors hover:border-primary/50">
                  <input type="radio" name={question.id} value={option.value} required class="mt-1 h-4 w-4 accent-primary" />
                  <span class="text-sm text-foreground">{option.label}</span>
                </label>
              ))}
            </div>
          </fieldset>
        ))}

        <div class="pt-4 text-center">
          <button type="submit" class="btn-primary">Vyhodnotit výsledek</button>
        </div>
      </form>

      <div id="results" class="mt-12 hidden rounded-[2rem] border border-border bg-card p-6 md:p-8 reveal">
        <div class="mb-6 flex items-center justify-between gap-4">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-muted-foreground">Výsledek</p>
            <h2 class="mt-2 text-3xl font-bold">Obory, které odpovídají tvým odpovědím</h2>
          </div>
          <span id="top-pill" class="rounded-full border border-primary/40 bg-primary/10 px-3 py-1.5 text-sm font-medium text-primary"></span>
        </div>

        <div id="result-summary" class="mb-8 text-base text-muted-foreground"></div>
        <button id="show-recommendation-map" type="button" class="btn-outline mb-6 hidden">Zobrazit doporučené školy na mapě</button>

        <div>
          <h3 class="mb-4 text-xl font-semibold">Doporučené obory a školy</h3>
          <div id="recommendations" class="grid gap-4 md:grid-cols-2"></div>
        </div>
      </div>
    </div>
  </section>

  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
    import { withBase } from "../lib/urls";
    import { distanceKm as getDistanceKm, escapeHtml, formatDistance, loadSchoolPrograms, loadSchools } from "../lib/school-data";

    document.addEventListener("astro:page-load", () => {
    if (!document.getElementById("quiz-form")) return;
    /* eslint-disable no-unused-vars */
    type Category = "digital" | "engineering" | "science" | "nature" | "health" | "safety" | "design" | "business" | "hospitality" | "people" | "practical" | "general";
    type StudentProfile = "balanced" | Category;
    type PriorityProfile = "fit" | "private" | "public" | "conservatory" | "apprenticeship";
    type SchoolProgram = { code: string; name: string; isPhasingOut: boolean };
    type HomeLocation = { label: string; latitude: number; longitude: number };
    type PhotonFeature = {
      geometry: { coordinates: [number, number] };
      properties: {
        countrycode?: string;
        state?: string;
        city?: string;
        county?: string;
        district?: string;
        street?: string;
        housenumber?: string;
        postcode?: string;
        name?: string;
        type?: string;
      };
    };
    type PhotonResponse = { features?: PhotonFeature[] };
    type LatLng = { lat: number; lng: number };
    type LeafletMap = {
      setView: (...args: [[number, number], number]) => LeafletMap;
      fitBounds: (...args: [Array<[number, number]>, { padding: [number, number]; maxZoom: number }]) => LeafletMap;
      on: (...args: ["click", (event: { latlng: LatLng }) => void]) => LeafletMap;
      invalidateSize(): void;
    };
    type LeafletMarker = {
      addTo: (...args: [LeafletMap]) => LeafletMarker;
      bindPopup: (...args: [string]) => LeafletMarker;
      remove(): LeafletMarker;
      setLatLng: (...args: [[number, number]]) => LeafletMarker;
    };
    type LeafletApi = {
      map: (...args: [string, { zoomControl: boolean; scrollWheelZoom: boolean }]) => LeafletMap;
      tileLayer: (...args: [string, { attribution: string; maxZoom: number }]) => { addTo: (...args: [LeafletMap]) => void };
      marker: (...args: [[number, number]]) => LeafletMarker;
    };
    type WindowWithLeaflet = Window & { L?: LeafletApi };
    /* eslint-enable no-unused-vars */
    type SchoolRecord = {
      id: string;
      name: string;
      region: string;
      type: string;
      focus: string;
      address: string;
      founder: string;
      founderCode: string;
      officialTypeCode: string;
      izo: string;
      phone: string;
      latitude: number | null;
      longitude: number | null;
      programs: SchoolProgram[];
