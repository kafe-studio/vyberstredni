    const formatPhotonAddress = (feature: PhotonFeature) => {
      const { city, county, district, housenumber, name, postcode, street } = feature.properties;
      const streetAddress = [street, housenumber].filter(Boolean).join(" ");
      const localityParts = [postcode, district, city || county]
        .filter((part): part is string => Boolean(part))
        .filter((part, index, parts) => parts.findIndex((candidate) =>
          candidate.toLocaleLowerCase("cs") === part.toLocaleLowerCase("cs")) === index);
      return [streetAddress || name, localityParts.join(" ")].filter(Boolean).join(", ");
    };

    const isInSupportedRegion = (feature: PhotonFeature) => {
      const { city, countrycode, state } = feature.properties;
      const normalizedCountry = countrycode?.toLocaleLowerCase("cs");
      const normalizedState = state?.toLocaleLowerCase("cs") ?? "";
      const normalizedCity = city?.toLocaleLowerCase("cs") ?? "";
      return normalizedCountry === "cz" &&
        (normalizedState.includes("středočesk") ||
          normalizedState.includes("central bohem") ||
          normalizedState.includes("praha") ||
          normalizedState.includes("prague") ||
          normalizedCity === "praha" ||
          normalizedCity === "prague");
    };

    const selectAddressSuggestion = (index: number) => {
      const suggestion = addressSuggestions[index];
      if (!suggestion) return;
      if (homeAddressInput) homeAddressInput.value = suggestion.label;
      if (homeLocationPreset) homeLocationPreset.value = "";
      cancelAddressSearch();
      applyHomeLocation(suggestion.location);
    };

    const renderAddressSuggestions = (suggestions: typeof addressSuggestions) => {
      if (!homeAddressOptions || !homeAddressInput) return;
      addressSuggestions = suggestions;
      activeAddressSuggestionIndex = -1;
      homeAddressOptions.replaceChildren();

      for (const [index, suggestion] of suggestions.entries()) {
        const item = document.createElement("li");
        item.setAttribute("role", "presentation");
        const option = document.createElement("button");
        option.id = `home-address-option-${index}`;
        option.type = "button";
        option.setAttribute("role", "option");
        option.setAttribute("aria-selected", "false");
        option.className = "w-full px-3 py-2 text-left text-sm text-foreground hover:bg-muted focus:bg-muted";
        option.textContent = suggestion.label;
        option.addEventListener("click", () => selectAddressSuggestion(index));
        item.appendChild(option);
        homeAddressOptions.appendChild(item);
      }

      homeAddressInput.setAttribute("aria-expanded", String(suggestions.length > 0));
      homeAddressOptions.classList.toggle("hidden", suggestions.length === 0);
    };

    const searchAddresses = async (query: string, signal: AbortSignal) => {
      const parameters = new URLSearchParams({
        q: query,
        limit: "10",
        countrycode: "cz",
        bbox: "12.0,49.2,15.7,50.9",
      });
      const response = await fetch(`https://photon.komoot.io/api/?${parameters.toString()}`, { signal });
      if (!response.ok) {
        throw new Error(`Vyhledávání adres skončilo chybou HTTP ${response.status}.`);
      }

      const data = await response.json() as PhotonResponse;
      return (data.features ?? [])
        .filter((feature) =>
          feature.properties.type === "house" &&
          Boolean(feature.properties.housenumber) &&
          Boolean(feature.properties.street) &&
          isInSupportedRegion(feature))
        .map((feature) => {
          const [longitude, latitude] = feature.geometry.coordinates;
          return {
            label: formatPhotonAddress(feature),
            location: {
              label: formatPhotonAddress(feature),
              latitude,
              longitude,
            },
          };
        })
        .filter((suggestion) =>
          suggestion.label.length > 0 &&
          Number.isFinite(suggestion.location.latitude) &&
          Number.isFinite(suggestion.location.longitude));
    };

    const applyHomeLocation = (location: HomeLocation) => {
      activeHomeLocation = location;
      if (homeLocationStatus) {
        homeLocationStatus.textContent = `Zvolené bydliště: ${location.label}. Vzdálenost se počítá vzdušnou čarou.`;
      }
      if (homeMap && homeMarker) {
        homeMarker.setLatLng([location.latitude, location.longitude]);
        homeMap.setView([location.latitude, location.longitude], 10);
      } else if (homeMap) {
        const leaflet = (window as WindowWithLeaflet).L;
        if (leaflet) homeMarker = leaflet.marker([location.latitude, location.longitude]).bindPopup("Zvolené bydliště").addTo(homeMap);
      }
    };

    const leaflet = (window as WindowWithLeaflet).L;
    const renderRecommendationMarkers = (rankedSchools: RankedSchool[]) => {
      if (!homeMap || !leaflet || !activeHomeLocation) return;

      schoolMarkers.forEach((marker) => marker.remove());
      schoolMarkers = [];
      const bounds: Array<[number, number]> = [[activeHomeLocation.latitude, activeHomeLocation.longitude]];

      for (const school of rankedSchools) {
        if (school.latitude === null || school.longitude === null) continue;

        const coordinates: [number, number] = [school.latitude, school.longitude];
        bounds.push(coordinates);
        schoolMarkers.push(
          leaflet.marker(coordinates)
            .bindPopup(escapeHtml(school.name))
            .addTo(homeMap),
        );
      }

      const schoolsWithoutCoordinates = rankedSchools.filter((school) =>
        school.latitude === null || school.longitude === null);
      if (recommendationMapStatus) {
        recommendationMapStatus.textContent = schoolsWithoutCoordinates.length
          ? `Na mapě je ${schoolMarkers.length} z ${rankedSchools.length} doporučených škol. Souřadnice nemají: ${schoolsWithoutCoordinates.map((school) => school.name).join("; ")}.`
          : `Na mapě jsou všechny doporučené školy (${schoolMarkers.length}) a tvoje bydliště.`;
      }

      homeMap.fitBounds(bounds, { padding: [24, 24], maxZoom: 12 });
    };

    const initializeHomeMap = () => {
      if (homeMap || !homeMapElement || !leaflet) return;

      homeMap = leaflet.map("home-map", { zoomControl: true, scrollWheelZoom: true });
      homeMap.setView([50.07, 14.4], 8);
      leaflet.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        maxZoom: 19,
      }).addTo(homeMap);
      homeMap.on("click", ({ latlng }) => {
        if (homeLocationPreset) homeLocationPreset.value = "";
        if (homeAddressInput) homeAddressInput.value = "";
        cancelAddressSearch();
        applyHomeLocation({
          label: "Vybrané místo na mapě",
          latitude: latlng.lat,
          longitude: latlng.lng,
        });
      });

      if (activeHomeLocation) {
        homeMarker = leaflet.marker([activeHomeLocation.latitude, activeHomeLocation.longitude])
          .bindPopup("Zvolené bydliště")
          .addTo(homeMap);
      }
      if (latestRankedSchools.length) renderRecommendationMarkers(latestRankedSchools);
      window.setTimeout(() => homeMap?.invalidateSize(), 0);
    };

    homeMapDisclosure?.addEventListener("toggle", () => {
