---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import Character, { type CharacterName } from "../components/Character.astro";

const metadata = {
  title: "Test zájmů",
  description: "Pět krátkých otázek o tom, co tě baví. Na konci uvidíš obory a školy v Praze a Středočeském kraji, které ti sedí.",
};

type Option = { value: string; label: string; icon: string };
type Question = { id: string; prompt: string; hint?: string; weight: number; options: Option[] };

/** Option values are interest categories (see src/lib/interest-test.ts), except the study track question. */
const questions: Question[] = [
  {
    id: "interest",
    prompt: "Co tě baví nejvíc?",
    hint: "Vyber jednu věc, která tě láká nejvíc.",
    weight: 2,
    options: [
      { value: "digital", label: "Počítače a programování", icon: "💻" },
      { value: "engineering", label: "Technika, stroje a auta", icon: "⚙️" },
      { value: "nature", label: "Příroda a zvířata", icon: "🌿" },
      { value: "health", label: "Péče o zdraví lidí", icon: "🩺" },
      { value: "design", label: "Kreslení, foto a video", icon: "🎨" },
      { value: "business", label: "Obchod a peníze", icon: "💼" },
      { value: "hospitality", label: "Vaření a cestování", icon: "🍳" },
      { value: "people", label: "Práce s dětmi a lidmi", icon: "🤝" },
    ],
  },
  {
    id: "subject",
    prompt: "Který předmět ve škole máš nejradši?",
    weight: 1,
    options: [
      { value: "science", label: "Matematika, fyzika, chemie", icon: "🧪" },
      { value: "nature", label: "Přírodopis", icon: "🐞" },
      { value: "digital", label: "Informatika", icon: "🖱️" },
      { value: "design", label: "Výtvarka nebo hudebka", icon: "🎵" },
      { value: "general", label: "Jazyky, dějepis, společenské vědy", icon: "📚" },
      { value: "practical", label: "Pracovní činnosti a dílny", icon: "🔨" },
      { value: "sport", label: "Tělocvik a sport", icon: "🏃" },
    ],
  },
  {
    id: "workplace",
    prompt: "Kde by sis představil/a svou práci?",
    weight: 1,
    options: [
      { value: "digital", label: "U počítače", icon: "🖥️" },
      { value: "engineering", label: "V dílně nebo na stavbě", icon: "🏗️" },
      { value: "science", label: "V laboratoři", icon: "🔬" },
      { value: "health", label: "V nemocnici", icon: "🏥" },
      { value: "design", label: "V ateliéru nebo studiu", icon: "📸" },
      { value: "business", label: "V kanceláři nebo obchodě", icon: "🏢" },
      { value: "hospitality", label: "V hotelu nebo restauraci", icon: "🏨" },
      { value: "safety", label: "U hasičů nebo policie", icon: "🚒" },
      { value: "people", label: "Ve škole nebo školce", icon: "🏫" },
      { value: "nature", label: "Venku v přírodě", icon: "🌳" },
    ],
  },
  {
    id: "activity",
    prompt: "Co bys dělal/a nejraději?",
    weight: 1,
    options: [
      { value: "practical", label: "Vyrobit něco vlastníma rukama", icon: "🪚" },
      { value: "design", label: "Vymyslet, jak něco bude vypadat", icon: "✏️" },
      { value: "science", label: "Spočítat a vyřešit úlohu", icon: "🧮" },
      { value: "business", label: "Zorganizovat akci", icon: "📋" },
      { value: "people", label: "Pomoct někomu, kdo to potřebuje", icon: "💬" },
      { value: "nature", label: "Postarat se o zvíře", icon: "🐕" },
      { value: "engineering", label: "Opravit rozbitý stroj", icon: "🔧" },
      { value: "digital", label: "Naprogramovat hru nebo aplikaci", icon: "🎮" },
    ],
  },
  {
    id: "track",
    prompt: "Jakou školu chceš?",
    hint: "Nevadí, když ještě nevíš.",
    weight: 0,
    options: [
      { value: "general", label: "Gymnázium – široký základ, pak vysoká škola", icon: "🎓" },
      { value: "maturita", label: "Odborná škola s maturitou", icon: "📘" },
      { value: "vyucni", label: "Učební obor s výučním listem", icon: "🛠️" },
      { value: "any", label: "Ještě nevím", icon: "🤔" },
    ],
  },
];

const towns = [
  {
    group: "Praha",
    items: [
      { id: "praha-centrum", label: "Praha – centrum", latitude: 50.0833, longitude: 14.4254 },
      { id: "praha-sever", label: "Praha – sever (Kobylisy, Prosek)", latitude: 50.1197, longitude: 14.4718 },
      { id: "praha-vychod", label: "Praha – východ (Černý Most, Hostivař)", latitude: 50.0866, longitude: 14.5481 },
      { id: "praha-jih", label: "Praha – jih (Chodov, Jižní Město)", latitude: 50.0313, longitude: 14.5003 },
      { id: "praha-zapad", label: "Praha – západ (Stodůlky, Smíchov)", latitude: 50.0491, longitude: 14.3524 },
      { id: "praha-dejvice", label: "Praha – Dejvice, Břevnov", latitude: 50.1003, longitude: 14.3907 },
    ],
  },
  {
    group: "Středočeský kraj",
    items: [
      { id: "benesov", label: "Benešov", latitude: 49.7816, longitude: 14.687 },
      { id: "beroun", label: "Beroun", latitude: 49.9638, longitude: 14.072 },
      { id: "brandys", label: "Brandýs nad Labem", latitude: 50.1872, longitude: 14.6633 },
      { id: "kladno", label: "Kladno", latitude: 50.1474, longitude: 14.1028 },
      { id: "kolin", label: "Kolín", latitude: 50.0281, longitude: 15.2006 },
      { id: "kutna-hora", label: "Kutná Hora", latitude: 49.9484, longitude: 15.2682 },
      { id: "melnik", label: "Mělník", latitude: 50.3505, longitude: 14.4741 },
      { id: "mlada-boleslav", label: "Mladá Boleslav", latitude: 50.4114, longitude: 14.9032 },
      { id: "nymburk", label: "Nymburk", latitude: 50.1861, longitude: 15.0417 },
      { id: "pribram", label: "Příbram", latitude: 49.6899, longitude: 14.0104 },
      { id: "rakovnik", label: "Rakovník", latitude: 50.1037, longitude: 13.7334 },
      { id: "ricany", label: "Říčany", latitude: 49.9917, longitude: 14.6543 },
      { id: "slany", label: "Slaný", latitude: 50.2305, longitude: 14.0869 },
    ],
  },
];

const totalSteps = questions.length + 1;
/** One companion per step, cycling through the four students (shown next to the quiz on wide screens). */
const companionCycle: CharacterName[] = ["hoodie", "bun", "vest", "cap"];
const backgroundCycle = ["bg-lilac", "bg-peach", "bg-mint", "bg-sky/25", "bg-sun/40", "bg-lime/40"];
const stepCharacters = Array.from({ length: totalSteps }, (_, index) => companionCycle[index % companionCycle.length]);
const stepBackgrounds = Array.from({ length: totalSteps }, (_, index) => backgroundCycle[index % backgroundCycle.length]);
---

<BaseLayout {metadata} showQuizBanner={false}>
  <section class="px-6 pb-20 pt-28 md:pt-32">
    <div class="mx-auto max-w-2xl">
      <header class="mb-8 text-center">
        <span class="sticker-note -rotate-2 bg-lime">Test zájmů · 2 minuty</span>
        <h1 class="mt-4 text-4xl font-extrabold md:text-5xl">Co ti sedí?</h1>
        <p class="mt-3 text-muted-foreground">{questions.length} krátkých otázek. Klikni na to, co tě nejvíc láká.</p>
      </header>

      <div class="relative">
      <div id="step-companions" class="pointer-events-none absolute -right-60 bottom-0 hidden w-52 xl:block" aria-hidden="true">
        {stepCharacters.map((name, index) => (
          <div class="step-character relative isolate" data-step-character={index} hidden={index !== 0}>
            <div class:list={["blob inset-x-2 bottom-0 top-16", stepBackgrounds[index]]}></div>
            <Character name={name} class="character-float relative w-full" />
          </div>
        ))}
      </div>

      <div id="quiz" class="track-card scroll-mt-24 p-6 md:p-8" data-question-count={questions.length}>
        <div class="mb-6">
          <div class="mb-2 flex items-center justify-between text-sm text-muted-foreground">
            <span id="step-label" aria-live="polite">Otázka 1 z {questions.length}</span>
            <span class="flex gap-4">
              <button id="back-button" type="button" class="font-semibold text-primary hover:underline disabled:invisible" disabled>← Zpět</button>
              <button id="next-button" type="button" class="font-semibold text-primary hover:underline disabled:invisible" disabled>Další →</button>
            </span>
          </div>
          <div class="h-3 overflow-hidden rounded-full border-2 border-ink bg-white">
            <div id="progress-bar" class="h-full rounded-full bg-primary transition-all duration-300" style={`width: ${100 / totalSteps}%`}></div>
          </div>
        </div>

        {questions.map((question, index) => (
          <section class="quiz-step" data-question={question.id} data-weight={question.weight} hidden={index !== 0}>
            <h2 class="text-2xl font-bold" tabindex="-1">{question.prompt}</h2>
            {question.hint && <p class="mt-1 text-sm text-muted-foreground">{question.hint}</p>}
            <div class="mt-5 grid gap-3 sm:grid-cols-2">
              {question.options.map((option) => (
                <button
                  type="button"
                  class="quiz-option flex items-center gap-3 rounded-2xl border-2 border-ink bg-white p-4 text-left shadow-[3px_3px_0_var(--ink)] transition hover:-translate-x-0.5 hover:-translate-y-0.5 hover:bg-lilac hover:shadow-[5px_5px_0_var(--ink)] aria-pressed:bg-sun"
                  data-value={option.value}
                  aria-pressed="false"
                >
                  <span class="text-2xl" aria-hidden="true">{option.icon}</span>
                  <span class="font-semibold text-ink">{option.label}</span>
                </button>
              ))}
            </div>
          </section>
        ))}

        <section class="quiz-step" hidden>
          <h2 class="text-2xl font-bold" tabindex="-1">Kde bydlíš?</h2>
          <p class="mt-1 text-sm text-muted-foreground">Nepovinné. Pomůže seřadit školy podle vzdálenosti.</p>
          <div class="mt-5 space-y-4">
            <label class="block">
              <span class="mb-2 block text-sm font-medium">Nejbližší místo</span>
              <select id="home-select" class="w-full rounded-xl border-2 border-ink bg-white px-3 py-3 text-ink">
                <option value="">Vyber místo…</option>
                {towns.map((town) => (
                  <optgroup label={town.group}>
                    {town.items.map((item) => (
                      <option value={item.id} data-latitude={item.latitude} data-longitude={item.longitude}>{item.label}</option>
                    ))}
                  </optgroup>
                ))}
              </select>
            </label>
            <button id="geolocation-button" type="button" class="btn-outline w-full">📍 Použít moji polohu</button>
            <p id="home-status" class="text-sm text-muted-foreground" aria-live="polite"></p>
            <label id="distance-field" class="block" hidden>
              <span class="mb-2 block text-sm font-medium">Jak daleko můžeš dojíždět?</span>
              <select id="max-distance" class="w-full rounded-xl border-2 border-ink bg-white px-3 py-3 text-ink">
                <option value="">Nezáleží</option>
                <option value="10">Do 10 km</option>
                <option value="20">Do 20 km</option>
                <option value="30">Do 30 km</option>
                <option value="50">Do 50 km</option>
              </select>
            </label>
          </div>
          <button id="show-results" type="button" class="btn-primary mt-6 w-full">Zobrazit výsledky 🎉</button>
        </section>
      </div>
      </div>

      <div id="results" class="scroll-mt-24" hidden>
        <div class="track-card relative overflow-hidden bg-lilac p-6 md:p-8 md:pr-56">
          <div class="pointer-events-none absolute -bottom-6 -right-6 hidden w-56 md:block" aria-hidden="true">
            <Character name="duo-hoodie-bun" class="w-full" />
          </div>
          <span class="sticker-note -rotate-2 bg-sun">Tvůj výsledek 🎉</span>
          <h2 class="mt-3 text-3xl font-extrabold">Nejvíc tě táhne</h2>
          <div id="top-interests" class="mt-4 flex flex-wrap gap-2"></div>
          <p id="results-note" class="mt-4 text-sm text-muted-foreground"></p>
          <div class="mt-5 flex flex-wrap gap-3">
            <button id="edit-answers" type="button" class="btn-outline">Upravit odpovědi</button>
            <button id="restart" type="button" class="btn-outline">Začít znovu</button>
          </div>
        </div>

        <h2 class="mb-4 mt-10 text-2xl font-extrabold">Školy, které by ti mohly sednout</h2>
        <div id="recommendations" class="space-y-4"></div>
        <button id="more-results" type="button" class="btn-outline mt-6 w-full" hidden>Zobrazit další školy</button>
        <p class="mt-8 text-xs leading-5 text-muted-foreground">
          Orientační doporučení podle oborů zapsaných v rejstříku MŠMT, nejde o psychologický test ani odhad šance na přijetí.
          Vzdálenost je vzdušnou čarou. Otevření oboru a přijímací podmínky si ověř na webu školy.
        </p>
      </div>
    </div>
  </section>

  <script>
    import { withBase } from "../lib/urls";
    import { escapeHtml, formatDistance, loadSchoolPrograms, loadSchools } from "../lib/school-data";
    import {
      categoryLabels,
      emptyTotals,
      isCategory,
      isStudyTrack,
      rankSchools,
      type HomeLocation,
      type Recommendation,
    } from "../lib/interest-test";

    const PAGE_SIZE = 6;
    const ADVANCE_DELAY_MS = 220;

    document.addEventListener("astro:page-load", () => {
      const quiz = document.getElementById("quiz");
      const results = document.getElementById("results");
      if (!quiz || !results) return;

      const steps = [...quiz.querySelectorAll<HTMLElement>(".quiz-step")];
      const totalSteps = steps.length;
      const questionCount = Number(quiz.dataset.questionCount) || totalSteps - 1;
      const stepLabel = document.getElementById("step-label");
      const progressBar = document.getElementById("progress-bar");
      const backButton = document.getElementById("back-button") as HTMLButtonElement | null;
      const nextButton = document.getElementById("next-button") as HTMLButtonElement | null;
      const homeSelect = document.getElementById("home-select") as HTMLSelectElement | null;
      const geolocationButton = document.getElementById("geolocation-button") as HTMLButtonElement | null;
      const homeStatus = document.getElementById("home-status");
      const distanceField = document.getElementById("distance-field");
      const maxDistanceSelect = document.getElementById("max-distance") as HTMLSelectElement | null;
      const showResultsButton = document.getElementById("show-results") as HTMLButtonElement | null;
      const topInterests = document.getElementById("top-interests");
      const resultsNote = document.getElementById("results-note");
      const recommendationsList = document.getElementById("recommendations");
      const moreButton = document.getElementById("more-results") as HTMLButtonElement | null;

      const answers = new Map<string, string>();
      let currentStep = 0;
      let home: HomeLocation | null = null;
      let ranked: Recommendation[] = [];
      let shown = 0;
      let advanceTimer: number | null = null;
      let answersVersion = 0;
      // Bumped on every location change, so a late geolocation answer cannot override a newer choice.
      let locationRequest = 0;

      const cancelAdvance = () => {
        if (advanceTimer !== null) window.clearTimeout(advanceTimer);
        advanceTimer = null;
      };

      // Loads are cached in school-data; start downloading while the user answers.
      const loadData = () => Promise.all([loadSchools(), loadSchoolPrograms()]);
      void loadData().catch(() => undefined);

      const showStep = (index: number, moveFocus = true) => {
        cancelAdvance();
        currentStep = Math.max(0, Math.min(index, totalSteps - 1));
        steps.forEach((step, stepIndex) => { step.hidden = stepIndex !== currentStep; });
        if (stepLabel) {
          stepLabel.textContent = currentStep >= questionCount
            ? "Poslední krok: bydliště"
            : `Otázka ${currentStep + 1} z ${questionCount}`;
        }
        if (progressBar) progressBar.style.width = `${((currentStep + 1) / totalSteps) * 100}%`;
        document.querySelectorAll<HTMLElement>("[data-step-character]").forEach((element) => {
          element.hidden = Number(element.dataset.stepCharacter) !== currentStep;
        });
        if (backButton) backButton.disabled = currentStep === 0;
        if (nextButton) {
          const questionId = steps[currentStep]?.dataset.question;
          nextButton.disabled = !questionId || !answers.has(questionId);
        }
        if (!moveFocus) return;
        steps[currentStep]?.querySelector<HTMLElement>("h2")?.focus({ preventScroll: true });
        // On phones the option list is long; bring the start of the next question back into view.
        const navbarHeight = document.querySelector("nav")?.getBoundingClientRect().height ?? 0;
        if (quiz.getBoundingClientRect().top < navbarHeight) quiz.scrollIntoView({ behavior: "smooth", block: "start" });
      };

      const setHome = (location: HomeLocation | null, message: string) => {
        home = location;
        if (homeStatus) homeStatus.textContent = message;
        if (distanceField) distanceField.hidden = location === null;
      };

      const resetResultsButton = () => {
        if (!showResultsButton) return;
        showResultsButton.disabled = false;
        showResultsButton.textContent = "Zobrazit výsledky";
      };

      quiz.addEventListener("click", (event) => {
        const target = event.target;
        const option = target instanceof Element ? target.closest<HTMLButtonElement>(".quiz-option") : null;
        const step = option?.closest<HTMLElement>(".quiz-step");
        const questionId = step?.dataset.question;
        const value = option?.dataset.value;
        if (!option || !step || !questionId || !value) return;

        answers.set(questionId, value);
        answersVersion += 1;
        step.querySelectorAll(".quiz-option").forEach((button) => {
          button.setAttribute("aria-pressed", String(button === option));
        });
        cancelAdvance();
        const nextStep = currentStep + 1;
        advanceTimer = window.setTimeout(() => showStep(nextStep), ADVANCE_DELAY_MS);
      });

      backButton?.addEventListener("click", () => showStep(currentStep - 1));
      nextButton?.addEventListener("click", () => showStep(currentStep + 1));

      homeSelect?.addEventListener("change", () => {
        locationRequest += 1;
        const option = homeSelect.selectedOptions[0];
        const latitude = Number(option?.dataset.latitude);
        const longitude = Number(option?.dataset.longitude);
        if (!option?.value || !Number.isFinite(latitude) || !Number.isFinite(longitude)) {
          setHome(null, "");
          return;
        }
        setHome({ label: option.textContent ?? "", latitude, longitude }, "");
      });

      geolocationButton?.addEventListener("click", () => {
        if (!navigator.geolocation) {
          if (homeStatus) homeStatus.textContent = "Tento prohlížeč polohu nepodporuje. Vyber místo ze seznamu.";
          return;
        }
        if (homeStatus) homeStatus.textContent = "Zjišťuji polohu…";
        locationRequest += 1;
        const request = locationRequest;
        navigator.geolocation.getCurrentPosition(
          ({ coords }) => {
            if (request !== locationRequest) return;
            if (!isInSupportedRegion(coords.latitude, coords.longitude)) {
              if (homeStatus) homeStatus.textContent = "Tvoje poloha je mimo Prahu a Středočeský kraj. Vyber místo ze seznamu.";
              return;
            }
            if (homeSelect) homeSelect.value = "";
            setHome({ label: "tvoje poloha", latitude: coords.latitude, longitude: coords.longitude }, "✓ Použijeme tvoji aktuální polohu.");
          },
          () => {
            // Keep whatever location was chosen before; only explain what happened.
            if (request !== locationRequest || !homeStatus) return;
            homeStatus.textContent = "Polohu se nepodařilo zjistit. Vyber místo ze seznamu.";
          },
          { timeout: 10000, maximumAge: 300000 },
        );
      });

      /** Rough bounding box of Praha and Středočeský kraj. */
      const isInSupportedRegion = (latitude: number, longitude: number) =>
        latitude >= 49.45 && latitude <= 50.8 && longitude >= 13.35 && longitude <= 15.6;

      const pluralPrograms = (count: number) => count === 1 ? "další obor" : count < 5 ? "další obory" : "dalších oborů";
      const pluralSchools = (count: number) => count === 1 ? "škola" : count > 1 && count < 5 ? "školy" : "škol";

      const renderCard = (school: Recommendation) => {
        const programs = school.programs.slice(0, 2);
        const more = school.programs.length - programs.length;
        const href = withBase(`/skoly/${encodeURIComponent(school.id)}/`);
        const meta = [school.region, school.distanceKm === null ? "" : `${formatDistance(school.distanceKm)} od tebe`]
          .filter(Boolean)
          .map(escapeHtml)
          .join(" · ");
        return `
          <article class="school-card p-5">
            <a class="text-lg font-semibold text-foreground hover:text-primary" href="${href}">${escapeHtml(school.name)}</a>
            <p class="mt-1 text-sm text-muted-foreground">${meta}</p>
            <ul class="mt-3 space-y-1 text-sm">
              ${programs.map((program) => `<li class="flex gap-2"><span class="text-primary" aria-hidden="true">✓</span><span>${escapeHtml(program.name)}</span></li>`).join("")}
            </ul>
            ${more > 0 ? `<p class="mt-1 text-xs text-muted-foreground">+ ${more} ${pluralPrograms(more)}</p>` : ""}
            <a class="mt-3 inline-block text-sm font-medium text-primary hover:underline" href="${href}">Detail školy →</a>
          </article>`;
      };

      const renderMore = () => {
        if (!recommendationsList) return;
        const next = ranked.slice(shown, shown + PAGE_SIZE);
        recommendationsList.insertAdjacentHTML("beforeend", next.map(renderCard).join(""));
        shown += next.length;
        if (moreButton) {
          const remaining = ranked.length - shown;
          moreButton.hidden = remaining <= 0;
          moreButton.textContent = `Zobrazit další školy (${remaining})`;
        }
      };

      const showResults = async () => {
        if (showResultsButton) {
          showResultsButton.disabled = true;
          showResultsButton.textContent = "Hledám školy…";
        }

        const totals = emptyTotals();
        steps.forEach((step) => {
          const questionId = step.dataset.question;
          const value = questionId ? answers.get(questionId) : undefined;
          if (value && isCategory(value)) totals[value] += Number(step.dataset.weight) || 0;
        });
        const trackAnswer = answers.get("track") ?? "any";
        const track = isStudyTrack(trackAnswer) ? trackAnswer : "any";
        const maxDistance = home && maxDistanceSelect?.value ? Number(maxDistanceSelect.value) : null;
        const requestedVersion = answersVersion;
        let withoutLocation: number;

        try {
          const [schools, programsById] = await loadData();
          if (requestedVersion !== answersVersion || currentStep !== totalSteps - 1 || quiz.hidden) {
            resetResultsButton();
            return;
          }
          const result = rankSchools(schools, programsById, totals, track, home, maxDistance);
          ranked = result.schools;
          withoutLocation = result.withoutLocation;
        } catch {
          if (homeStatus) homeStatus.textContent = "Data škol se nepodařilo načíst. Zkontroluj připojení a zkus to znovu.";
          resetResultsButton();
          return;
        }

        const top = Object.entries(totals)
          .filter(([, count]) => count > 0)
          .sort((left, right) => right[1] - left[1])
          .slice(0, 3)
          .map(([category]) => (isCategory(category) ? categoryLabels[category] : category));
        if (topInterests) {
          topInterests.innerHTML = (top.length ? top : ["Zatím bez jasného směru"])
            .map((label, index) => `<span class="rounded-full border-2 border-ink px-4 py-2 text-sm font-bold shadow-[2px_2px_0_var(--ink)] ${["bg-primary text-white", "bg-sun text-ink", "bg-mint text-ink"][index] ?? "bg-white text-ink"}">${escapeHtml(label)}</span>`)
            .join("");
        }
        if (resultsNote) {
          const order = home
            ? `Seřazeno podle shody, pak podle vzdálenosti od: ${home.label}${maxDistance ? ` (do ${maxDistance} km)` : ""}.`
            : "Seřazeno podle toho, jak obory odpovídají tvým odpovědím.";
          const skipped = withoutLocation > 0
            ? ` ${withoutLocation} ${pluralSchools(withoutLocation)} bez známé polohy jsme v limitu vzdálenosti nemohli započítat.`
            : "";
          resultsNote.textContent = `${ranked.length} ${pluralSchools(ranked.length)} s vhodným oborem. ${order}${skipped}`;
        }
        if (recommendationsList) {
          recommendationsList.innerHTML = ranked.length
            ? ""
            : `<p class="rounded-2xl border border-dashed border-border p-6 text-sm text-muted-foreground">${maxDistance ? "V této vzdálenosti jsme nenašli školu s vhodným oborem. Zkus delší dojezd." : "Nenašli jsme školu s vhodným oborem. Zkus upravit odpovědi."}</p>`;
        }
        shown = 0;
        renderMore();

        quiz.hidden = true;
        // The companion sits outside the quiz card; hide it together with the quiz.
        document.getElementById("step-companions")?.setAttribute("hidden", "");
        results.hidden = false;
        results.scrollIntoView({ behavior: "smooth", block: "start" });
        resetResultsButton();
      };

      const backToQuiz = () => {
        results.hidden = true;
        quiz.hidden = false;
        document.getElementById("step-companions")?.removeAttribute("hidden");
        showStep(0);
        quiz.scrollIntoView({ behavior: "smooth", block: "start" });
      };

      showResultsButton?.addEventListener("click", () => void showResults());
      moreButton?.addEventListener("click", renderMore);
      document.getElementById("edit-answers")?.addEventListener("click", backToQuiz);
      document.getElementById("restart")?.addEventListener("click", () => {
        answers.clear();
        locationRequest += 1;
        quiz.querySelectorAll(".quiz-option").forEach((button) => button.setAttribute("aria-pressed", "false"));
        if (homeSelect) homeSelect.value = "";
        if (maxDistanceSelect) maxDistanceSelect.value = "";
        setHome(null, "");
        backToQuiz();
      });

      showStep(0, false);
    });
  </script>
</BaseLayout>
