    type RankedSchool = SchoolRecord & { score: number; distanceKm: number | null; reasons: string[]; matchedPrograms: RankedProgram[] };

    // Only currently registered programs are relevant for recommendations.
    // Loads are cached in school-data; a failed load is retried on the next call.
    const getSchoolData = (): Promise<SchoolRecord[] | null> => Promise.all([loadSchools(), loadSchoolPrograms()])
      .then(([schools, programsById]) => schools.map((school) => ({
        ...school,
        programs: (programsById[school.id] ?? []).filter((program) => !program.isPhasingOut),
      })))
      .catch(() => null);
    void getSchoolData();

    const getFitReasons = (school: SchoolRecord, program: SchoolProgram, priorityValue: PriorityProfile) => {
      const reasons: string[] = [];

      if (priorityValue === "private" && school.founderCode === "5") reasons.push("Soukromý zřizovatel");
      if (priorityValue === "public" && !["5", "6"].includes(school.founderCode)) reasons.push("Veřejný zřizovatel");
      if (priorityValue === "conservatory" && school.officialTypeCode === "D00") reasons.push("Konzervatoř");
      if (priorityValue === "apprenticeship" && /-[EH]\//.test(program.code)) reasons.push("Učební obor");

      return reasons.slice(0, 2);
    };

