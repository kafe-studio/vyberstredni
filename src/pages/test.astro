      homeMapDisclosure?.scrollIntoView({ behavior: "smooth", block: "center" });
      window.setTimeout(() => homeMap?.invalidateSize(), 0);
    });

    const programCategories = (program: SchoolProgram): Category[] => {
      const codeGroup = program.code.slice(0, 2);
      const name = program.name.toLocaleLowerCase("cs");
      if (codeGroup === "79") return ["general"];

      const categoryByCodeGroup: Partial<Record<string, Category[]>> = {
        "16": ["science", "nature"],
        "18": ["digital"],
        "21": ["engineering", "science"],
        "23": ["engineering"],
        "26": ["engineering", "science"],
        "29": ["practical"],
        "31": ["design", "practical"],
        "32": ["design", "practical"],
        "33": ["design", "practical"],
        "34": ["design", "practical"],
        "36": ["engineering"],
        "37": ["engineering", "business"],
        "41": ["nature", "practical"],
        "43": ["nature"],
        "53": ["health"],
        "63": ["business"],
        "64": ["business"],
        "65": ["hospitality"],
        "68": ["safety"],
        "69": ["practical"],
        "72": ["people"],
        "75": ["people"],
        "82": ["design"],
      };
      const categoriesForProgram = new Set(categoryByCodeGroup[codeGroup] ?? []);

      if (codeGroup === "28") {
        categoriesForProgram.add(/keram/.test(name) ? "design" : "science");
        if (/keram/.test(name)) categoriesForProgram.add("practical");
      }
      if (codeGroup === "29") {
        if (/analýza|technologie potravin/.test(name)) categoriesForProgram.add("science");
        if (/kuchař|číšník|cukrář|pekař|řezník|gastronom/.test(name)) categoriesForProgram.add("hospitality");
      }
      if (codeGroup === "39") {
        if (/požární ochrana|bezpečnost/.test(name)) {
          categoriesForProgram.add("safety");
        } else if (/malíř|lakýr/.test(name)) {
          categoriesForProgram.add("practical");
        } else {
          categoriesForProgram.add("engineering");
        }
      }
      if (codeGroup === "41") {
        if (/opravář|mechanizátor|strojů/.test(name)) categoriesForProgram.add("engineering");
      }
      if (codeGroup === "65" && /hotelnictví|cestovní ruch/.test(name)) categoriesForProgram.add("business");
      if (codeGroup === "66") {
        categoriesForProgram.add(/aranžér|propagace/.test(name) ? "design" : "business");
      }
      if (codeGroup === "68" && /veřejnospráv|sociální/.test(name)) categoriesForProgram.add("people");
      if (codeGroup === "69") {
        if (/kadeřník|kosmetik|vlasov/.test(name)) categoriesForProgram.add("design");
        if (/masér/.test(name)) categoriesForProgram.add("health");
      }

      if (codeGroup === "78") {
        if (program.code.startsWith("78-62-C")) {
          categoriesForProgram.add("practical");
          categoriesForProgram.add("people");
        } else if (program.code === "78-42-M/01") {
          categoriesForProgram.add("engineering");
          categoriesForProgram.add("science");
        } else if (program.code === "78-42-M/02") {
          categoriesForProgram.add("business");
        } else if (program.code === "78-42-M/03") {
          categoriesForProgram.add("people");
        } else if (program.code === "78-42-M/04") {
          categoriesForProgram.add("health");
        } else if (program.code === "78-42-M/05") {
          categoriesForProgram.add("science");
          categoriesForProgram.add("nature");
        } else if (program.code === "78-42-M/06") {
          categoriesForProgram.add("general");
          categoriesForProgram.add("people");
        } else {
          categoriesForProgram.add("general");
        }
      }

      if (/-[EH]\//.test(program.code) && codeGroup !== "78") categoriesForProgram.add("practical");
      return [...categoriesForProgram];
    };

    const updateProgress = () => {
      const answered = document.querySelectorAll('input[type="radio"]:checked').length;
      const total = Number(form?.dataset.questionCount ?? 0);
      const percent = (answered / total) * 100;

      if (progressText) {
        progressText.textContent = `${answered}/${total}`;
      }

      if (progressBar) {
        progressBar.style.width = `${percent}%`;
      }
    };

    document.querySelectorAll<HTMLButtonElement>(".reset-quiz").forEach((resetButton) => {
      resetButton.addEventListener("click", () => {
        form?.reset();
        if (studentProfileSelect) studentProfileSelect.value = "balanced";
        if (priorityProfileSelect) priorityProfileSelect.value = "fit";
        if (maxDistanceSelect) maxDistanceSelect.value = "";
        activeHomeLocation = null;
        cancelAddressSearch();
        if (homeAddressInput) homeAddressInput.value = "";
        if (homeLocationPreset) homeLocationPreset.value = "";
        if (homeLocationStatus) homeLocationStatus.textContent = "Pro pokračování zvol místo bydliště.";
        homeMarker?.remove();
        homeMarker = null;
        schoolMarkers.forEach((marker) => marker.remove());
        schoolMarkers = [];
        latestRankedSchools = [];
        homeMap?.setView([50.07, 14.4], 8);
        if (homeMapDisclosure) homeMapDisclosure.open = false;
        if (recommendationMapStatus) recommendationMapStatus.textContent = "";
