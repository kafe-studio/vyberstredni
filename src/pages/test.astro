        document.getElementById("menu-icon-open")?.classList.add("hidden");
      });
    });

    document.querySelectorAll('input[type="radio"]').forEach((input) => {
      input.addEventListener('change', updateProgress);
    });

    homeLocationPreset?.addEventListener("change", () => {
      const location = homeLocations[homeLocationPreset.value];
      if (homeAddressInput) homeAddressInput.value = "";
      cancelAddressSearch();
      if (location) {
        applyHomeLocation(location);
      } else {
        activeHomeLocation = null;
        if (homeMarker) {
          homeMarker.remove();
          homeMarker = null;
        }
        if (homeLocationStatus) homeLocationStatus.textContent = "Pro pokračování zvol místo bydliště.";
      }
    });

    homeAddressInput?.addEventListener("input", () => {
      activeHomeLocation = null;
      if (homeMarker) {
        homeMarker.remove();
        homeMarker = null;
      }
      if (homeLocationPreset) homeLocationPreset.value = "";
      cancelAddressSearch();

      const query = homeAddressInput.value.trim();
      if (query.length < 4) {
        if (homeLocationStatus) homeLocationStatus.textContent = "Zadej alespoň 4 znaky adresy.";
        return;
      }
      if (homeLocationStatus) homeLocationStatus.textContent = "Hledám přesné adresy…";

      addressSearchTimer = window.setTimeout(() => {
        addressSearchTimer = null;
        const request = new AbortController();
        addressRequest = request;
        void searchAddresses(query, request.signal).then((suggestions) => {
          if (addressRequest !== request || homeAddressInput.value.trim() !== query) return;
          renderAddressSuggestions(suggestions);
          if (homeLocationStatus) {
            homeLocationStatus.textContent = suggestions.length
              ? `Vyber adresu z nabídky (${suggestions.length} ${suggestions.length === 1 ? "možnost" : suggestions.length < 5 ? "možnosti" : "možností"}).`
              : "Přesnou adresu se nepodařilo najít. Zkus ulici, číslo domu a obec, nebo vyber místo na mapě.";
          }
        }).catch((error: unknown) => {
          if (error instanceof DOMException && error.name === "AbortError") return;
          if (addressRequest !== request) return;
          if (homeLocationStatus) {
            homeLocationStatus.textContent = "Vyhledávání adres teď není dostupné. Zkus to znovu, vyber město nebo klikni do mapy.";
          }
        });
      }, 500);
    });

    homeAddressInput?.addEventListener("keydown", (event) => {
      if (!addressSuggestions.length) return;

      if (event.key === "ArrowDown" || event.key === "ArrowUp") {
        event.preventDefault();
        const direction = event.key === "ArrowDown" ? 1 : -1;
        activeAddressSuggestionIndex = activeAddressSuggestionIndex === -1
          ? direction > 0 ? 0 : addressSuggestions.length - 1
          : (activeAddressSuggestionIndex + direction + addressSuggestions.length) % addressSuggestions.length;
        const activeOption = homeAddressOptions?.querySelectorAll('[role="option"]')[activeAddressSuggestionIndex];
        homeAddressInput.setAttribute("aria-activedescendant", activeOption?.id ?? "");
        homeAddressOptions?.querySelectorAll('[role="option"]').forEach((option, index) => {
          option.setAttribute("aria-selected", String(index === activeAddressSuggestionIndex));
        });
      } else if (event.key === "Enter") {
        event.preventDefault();
        selectAddressSuggestion(Math.max(activeAddressSuggestionIndex, 0));
      } else if (event.key === "Escape") {
        closeAddressSuggestions();
      }
    });

    geolocationButton?.addEventListener("click", () => {
      if (!navigator.geolocation) {
        if (homeLocationStatus) homeLocationStatus.textContent = "Tento prohlížeč geolokaci nepodporuje. Vyber město nebo klikni do mapy.";
        return;
      }
      if (homeLocationStatus) homeLocationStatus.textContent = "Získávám tvoji polohu…";
      if (homeAddressInput) homeAddressInput.value = "";
      if (homeLocationPreset) homeLocationPreset.value = "";
      cancelAddressSearch();
      navigator.geolocation.getCurrentPosition(
        ({ coords }) => {
          applyHomeLocation({ label: "Moje poloha", latitude: coords.latitude, longitude: coords.longitude });
        },
        () => {
          if (homeLocationStatus) homeLocationStatus.textContent = "Polohu se nepodařilo získat. Zkontroluj oprávnění prohlížeče, nebo vyber město či bod na mapě.";
        },
        { enableHighAccuracy: true, timeout: 10000, maximumAge: 60000 },
      );
    });

    if (!leaflet && homeLocationStatus) {
      homeLocationStatus.textContent = "Mapu se nepodařilo načíst. Vyber město nebo povol přístup k poloze.";
    }

    form?.addEventListener("submit", (event) => {
      event.preventDefault();

      if (!activeHomeLocation) {
        if (homeLocationStatus) homeLocationStatus.textContent = "Nejdřív vyber bydliště, svou polohu nebo bod na mapě.";
        homeLocationPreset?.focus();
        return;
      }
      const homeLocation = activeHomeLocation;
      const formData = new FormData(form);
      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submitButton) submitButton.disabled = true;

      void getSchoolData().then((schoolData) => {
      if (submitButton) submitButton.disabled = false;
      if (!schoolData) {
        if (summary) summary.textContent = "Data škol se nepodařilo načíst. Zkontroluj připojení a zkus to znovu.";
        if (recommendations) recommendations.replaceChildren();
        results?.classList.remove("hidden");
        return;
      }

      const totals: Record<Category, number> = {
        digital: 0,
        engineering: 0,
        science: 0,
        nature: 0,
        health: 0,
        safety: 0,
        design: 0,
        business: 0,
        hospitality: 0,
        people: 0,
        practical: 0,
        general: 0,
      };

      for (const value of formData.values()) {
        const selected = String(value);
        if (selected in totals) {
          totals[selected as Category] += 1;
        }
      }

      const profileValue = (studentProfileSelect?.value ?? "balanced") as StudentProfile;
      const priorityValue = (priorityProfileSelect?.value ?? "fit") as PriorityProfile;
      const profileCategory = profileCategories[profileValue];

      if (profileCategory) totals[profileCategory] += 2;

      const sorted = Object.entries(totals).sort((a, b) => b[1] - a[1]) as Array<[Category, number]>;
      const selectedCategories = sorted.filter(([, count]) => count > 0).map(([category]) => category);

      const allRecommendedSchools: RankedSchool[] = schoolData
        .map((school: SchoolRecord): RankedSchool => {
          const matchingPrograms = school.programs
            .map((program): RankedProgram => {
              const matchingCategories = programCategories(program)
                .filter((category) => totals[category] > 0);
              const score = matchingCategories.reduce((total, category) => total + totals[category], 0);
              return { ...program, categories: matchingCategories, score };
            })
            .filter((program) => program.score > 0)
            .sort((left, right) => right.score - left.score || left.name.localeCompare(right.name, "cs") || left.code.localeCompare(right.code, "cs"));
          const preferredProgram = matchingPrograms.find((program) =>
            getFitReasons(school, program, priorityValue).length > 0);

          return {
            ...school,
            score: matchingPrograms[0]?.score ?? 0,
            distanceKm: school.latitude !== null && school.longitude !== null
              ? getDistanceKm(homeLocation.latitude, homeLocation.longitude, school.latitude, school.longitude)
              : null,
            reasons: preferredProgram ? getFitReasons(school, preferredProgram, priorityValue) : [],
            matchedPrograms: matchingPrograms.slice(0, 4),
          };
        })
        .filter((school) => school.matchedPrograms.length > 0 &&
          (priorityValue !== "conservatory" || school.officialTypeCode === "D00") &&
          (!maxDistanceSelect?.value ||
            (school.distanceKm !== null && school.distanceKm <= Number(maxDistanceSelect.value))))
        .sort((a: RankedSchool, b: RankedSchool) =>
          b.score - a.score ||
          Number(b.reasons.length > 0) - Number(a.reasons.length > 0) ||
          (a.distanceKm ?? Number.POSITIVE_INFINITY) - (b.distanceKm ?? Number.POSITIVE_INFINITY) ||
          a.name.localeCompare(b.name, "cs"));

      const rankedSchools = allRecommendedSchools.slice(0, 6);

      latestRankedSchools = allRecommendedSchools;
      if (recommendationMapButton) {
        recommendationMapButton.classList.toggle("hidden", allRecommendedSchools.length === 0);
        recommendationMapButton.textContent = `Mapa všech doporučených škol (${allRecommendedSchools.length})`;
      }
      renderRecommendationMarkers(allRecommendedSchools);

      if (summary) {
        const categorySummary = selectedCategories
          .sort((left, right) => totals[right] - totals[left])
          .map((category) => categoryLabels[category])
          .join(", ");
        const profileSummary = profileValue === "balanced"
          ? "to, že zatím nemáš jednu oblast vybranou"
          : profileValue === "general"
            ? "volbu všeobecného studia"
            : `zvolené zaměření <strong>${profileLabels[profileValue]}</strong>`;
        summary.innerHTML = `Zohlednili jsme všechny tvoje odpovědi (${categorySummary}) i ${profileSummary}. Nejprve řadíme podle shody konkrétních oborů, při stejné shodě rozhoduje vzdálenost. U každé školy jsou vypsané pouze obory, které odpovídají alespoň jednomu z těchto zaměření. Všeobecné gymnázium se objeví jen při volbě všeobecného studia. Vzdálenost je vzdušnou čarou; nabídku otevřených oborů ověř přímo u školy.`;
      }

      if (topPill) {
        const schoolCountLabel = rankedSchools.length === 1
          ? "1 doporučená škola"
          : rankedSchools.length < 5
            ? `${rankedSchools.length} doporučené školy`
            : `${rankedSchools.length} doporučených škol`;
        topPill.textContent = rankedSchools.length
          ? schoolCountLabel
          : maxDistanceSelect?.value ? "V dosahu žádná shoda" : "Bez shody v katalogu";
      }

      if (recommendations) {
        recommendations.innerHTML = rankedSchools.length ? rankedSchools
          .map((school: RankedSchool) => `
            <article class="rounded-2xl border border-border bg-background/40 p-5">
              <div class="mb-2 flex items-center justify-between gap-3">
                <p class="text-sm font-semibold uppercase tracking-[0.15em] text-primary">${escapeHtml(school.region)}</p>
                <span class="rounded-full border border-border bg-card px-2 py-1 text-[10px] uppercase tracking-[0.14em] text-muted-foreground">Orientačně: ${escapeHtml(school.type)}</span>
              </div>
              <div class="mb-3">
                <h4 class="text-xl font-semibold">${escapeHtml(school.name)}</h4>
              </div>
              <p class="mt-2 text-sm text-muted-foreground">${escapeHtml(school.address)}</p>
              <p class="mt-2 text-sm font-medium text-primary">${school.distanceKm === null ? "Vzdálenost není k dispozici" : `${formatDistance(school.distanceKm)} vzdušnou čarou`}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                ${school.reasons.map((reason) => `<span class="rounded-full border border-primary/20 bg-primary/5 px-2 py-1 text-[10px] font-semibold uppercase tracking-[0.12em] text-primary">${escapeHtml(reason)}</span>`).join("")}
              </div>
              <div class="mt-4">
                <p class="text-sm font-semibold text-foreground">Obory odpovídající tvým odpovědím</p>
                <ul class="mt-2 space-y-1 text-sm text-muted-foreground">
                  ${school.matchedPrograms.map((program) => `<li>${escapeHtml(program.name)} <span class="text-xs">(${escapeHtml(program.code)})</span><span class="block text-xs text-muted-foreground">Zaměření: ${program.categories.map((category) => escapeHtml(categoryLabels[category])).join(", ")}</span></li>`).join("")}
                </ul>
              </div>
              <ul class="mt-4 space-y-2 text-sm text-muted-foreground">
                <li><span class="font-semibold text-foreground">Zřizovatel:</span> ${escapeHtml(school.founder)}</li>
                <li><span class="font-semibold text-foreground">IZO:</span> ${escapeHtml(school.izo)}</li>
                <li><span class="font-semibold text-foreground">Telefon:</span> ${escapeHtml(school.phone || "V rejstříku neuveden")}</li>
              </ul>
              <a href="${withBase(`/skoly/${encodeURIComponent(school.id)}/`)}" class="mt-4 inline-flex items-center text-sm font-medium text-primary hover:underline">Detail školy →</a>
            </article>
          `)
          .join("") : `<p class="rounded-xl border border-border p-5 text-sm text-muted-foreground">${maxDistanceSelect?.value ? "V tomto dosahu se nepodařilo najít školu s odpovídajícím oborem. Zkus větší vzdálenost nebo ji nastav bez limitu." : "V aktuálním výběru se nepodařilo najít odpovídající evidovaný obor. Zkus jiné odpovědi nebo prohledej celý katalog oborů."}</p>`;
      }

      if (results) {
        results.classList.remove("hidden");
        results.scrollIntoView({ behavior: "smooth", block: "start" });
      }
      });
    });
    });
  </script>
</BaseLayout>
