---
export const prerender = true;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/urls";

const metadata = {
  title: "Odhlášené a nedoručené e-maily",
  description: "Odhlášení a nedoručené e-maily rozesílky z jaknaskolu.cz.",
};
---

<BaseLayout {metadata} showQuizBanner={false}>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <section class="px-4 pb-24 pt-24 sm:px-6">
    <div class="mx-auto max-w-5xl">
      <a href={withBase("/admin/")} class="text-sm font-semibold text-primary hover:underline">← Administrace</a>
      <h1 class="mt-2 text-3xl font-extrabold md:text-4xl">Odhlášené a nedoručené e-maily</h1>
      <p class="mt-1 text-sm text-muted-foreground">
        Rozesílací skript obojí před každou dávkou stáhne a tyto školy přeskočí (nedoručené jen trvale).
      </p>

      <p id="mail-login" class="mt-8 hidden rounded-[3px] bg-card p-6 shadow-paper">
        Pro zobrazení se nejdřív <a class="font-bold text-primary underline" href={withBase("/admin/")}>přihlas do administrace</a>.
      </p>

      <div id="mail-body" class="hidden">
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <button id="mail-refresh" type="button" class="btn-outline px-4 py-2 text-sm">Obnovit</button>
          <p id="mail-status" class="text-sm text-muted-foreground" aria-live="polite"></p>
        </div>

        <section class="mt-6" aria-labelledby="bounce-heading">
          <div class="flex flex-wrap items-center gap-3">
            <h2 id="bounce-heading" class="text-xl font-extrabold">Nedoručené</h2>
            <p id="bounce-count" class="rounded-[3px] bg-card px-3 py-1 text-sm font-bold shadow-paper"></p>
            <button type="button" class="mail-copy btn-outline px-3 py-1 text-sm" data-list="bounces">Kopírovat adresy</button>
          </div>
          <div id="bounce-reasons" class="mt-3 flex flex-wrap gap-2 text-xs"></div>
          <div class="mt-3 overflow-x-auto rounded-[3px] bg-card shadow-paper">
            <table class="w-full text-left text-sm">
              <thead class="border-b border-border text-xs uppercase tracking-wide text-muted-foreground">
                <tr>
                  <th scope="col" class="px-4 py-3">E-mail</th>
                  <th scope="col" class="px-4 py-3">Proč</th>
                  <th scope="col" class="px-4 py-3">Kdy</th>
                </tr>
              </thead>
              <tbody id="bounce-rows"></tbody>
            </table>
          </div>
        </section>

        <section class="mt-10" aria-labelledby="unsub-heading">
          <div class="flex flex-wrap items-center gap-3">
            <h2 id="unsub-heading" class="text-xl font-extrabold">Odhlášené</h2>
            <p id="unsub-count" class="rounded-[3px] bg-card px-3 py-1 text-sm font-bold shadow-paper"></p>
            <button type="button" class="mail-copy btn-outline px-3 py-1 text-sm" data-list="unsubscribes">Kopírovat adresy</button>
          </div>
          <div class="mt-3 overflow-x-auto rounded-[3px] bg-card shadow-paper">
            <table class="w-full text-left text-sm">
              <thead class="border-b border-border text-xs uppercase tracking-wide text-muted-foreground">
                <tr>
                  <th scope="col" class="px-4 py-3">E-mail</th>
                  <th scope="col" class="px-4 py-3">Jak</th>
                  <th scope="col" class="px-4 py-3">Kdy</th>
                </tr>
              </thead>
              <tbody id="unsub-rows"></tbody>
            </table>
          </div>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { withBase } from "../../lib/urls";
  import { escapeHtml } from "../../lib/school-data";

  type Unsubscribe = { email: string; ts: number; source: string };
  type Bounce = {
    email: string;
    ts: number;
    status: string;
    kind: "hard" | "soft";
    reason: string;
    diagnostic: string;
    source: string;
  };

  const SOURCE_LABELS: Record<string, string> = {
    page: "Tlačítko v e-mailu",
    "one-click": "Tlačítko v poštovním programu",
  };
  const when = (ts: number) => escapeHtml(new Date(ts).toLocaleString("cs-CZ"));
  const empty = (text: string) => `<tr><td colspan="3" class="px-4 py-6 text-center text-muted-foreground">${text}</td></tr>`;

  document.addEventListener("astro:page-load", () => {
    const body = document.getElementById("mail-body");
    if (!body) return;
    const login = document.getElementById("mail-login");
    const status = document.getElementById("mail-status");
    const lists: Record<string, string[]> = { bounces: [], unsubscribes: [] };

    const renderBounces = (all: Bounce[]) => {
      // One row per address: the latest notice wins (a later hard bounce replaces an earlier delay notice).
      const latest = new Map<string, Bounce>();
      all.forEach((bounce) => latest.set(bounce.email, bounce));
      const rows = [...latest.values()].sort((a, b) => b.ts - a.ts);
      const hard = rows.filter((row) => row.kind === "hard");
      lists.bounces = hard.map((row) => row.email);
      const count = document.getElementById("bounce-count");
      if (count) count.textContent = `${hard.length} trvale · ${rows.length - hard.length} dočasně`;

      const reasons = new Map<string, number>();
      rows.forEach((row) => reasons.set(row.reason, (reasons.get(row.reason) ?? 0) + 1));
      const reasonsEl = document.getElementById("bounce-reasons");
      if (reasonsEl) {
        reasonsEl.innerHTML = [...reasons.entries()]
          .sort((a, b) => b[1] - a[1])
          .map(([reason, n]) => `<span class="rounded-full bg-card px-3 py-1 font-semibold shadow-paper">${escapeHtml(reason)}: ${n}</span>`)
          .join("");
      }

      const tbody = document.getElementById("bounce-rows");
      if (!tbody) return;
      tbody.innerHTML = rows.length
        ? rows
            .map(
              (row) => `<tr class="border-b border-border align-top last:border-0">
                <td class="px-4 py-2 font-medium">${escapeHtml(row.email)}</td>
                <td class="px-4 py-2">
                  <span class="font-semibold">${escapeHtml(row.reason)}</span>${row.kind === "soft" ? ' <span class="text-xs text-muted-foreground">(dočasné)</span>' : ""}
                  ${row.diagnostic ? `<div class="mt-0.5 max-w-xl break-words text-xs text-muted-foreground">${escapeHtml(row.status ? `${row.status} – ` : "")}${escapeHtml(row.diagnostic)}</div>` : ""}
                </td>
                <td class="px-4 py-2 whitespace-nowrap">${when(row.ts)}</td>
              </tr>`,
            )
            .join("")
        : empty("Zatím žádné nedoručené e-maily.");
    };

    const renderUnsubscribes = (rows: Unsubscribe[]) => {
      lists.unsubscribes = rows.map((row) => row.email);
      const count = document.getElementById("unsub-count");
      if (count) count.textContent = String(rows.length);
      const tbody = document.getElementById("unsub-rows");
      if (!tbody) return;
      tbody.innerHTML = rows.length
        ? [...rows]
            .reverse()
            .map(
              (row) => `<tr class="border-b border-border last:border-0">
                <td class="px-4 py-2 font-medium">${escapeHtml(row.email)}</td>
                <td class="px-4 py-2">${escapeHtml(SOURCE_LABELS[row.source] ?? row.source)}</td>
                <td class="px-4 py-2 whitespace-nowrap">${when(row.ts)}</td>
              </tr>`,
            )
            .join("")
        : empty("Zatím se nikdo neodhlásil.");
    };

    const load = async () => {
      if (status) status.textContent = "Načítám…";
      try {
        const response = await fetch(withBase("/api/admin/emails/"), { credentials: "same-origin" });
        if (response.status === 401) {
          body.classList.add("hidden");
          login?.classList.remove("hidden");
          if (status) status.textContent = "";
          return;
        }
        if (!response.ok) throw new Error(String(response.status));
        const data: { rows: Unsubscribe[]; bounces: Bounce[] } = await response.json();
        login?.classList.add("hidden");
        body.classList.remove("hidden");
        renderBounces(data.bounces);
        renderUnsubscribes(data.rows);
        if (status) status.textContent = `Aktualizováno ${new Date().toLocaleTimeString("cs-CZ")}`;
      } catch {
        body.classList.remove("hidden");
        if (status) status.textContent = "Data se nepodařilo načíst. Zkus to znovu.";
      }
    };

    document.getElementById("mail-refresh")?.addEventListener("click", () => void load());
    document.querySelectorAll<HTMLButtonElement>(".mail-copy").forEach((button) => {
      button.addEventListener("click", () => {
        const emails = lists[button.dataset.list ?? ""] ?? [];
        void navigator.clipboard.writeText(emails.join("\n")).then(
          () => {
            if (status) status.textContent = `Zkopírováno ${emails.length} adres.`;
          },
          () => {
            if (status) status.textContent = "Kopírování se nepovedlo.";
          },
        );
      });
    });
    void load();
  });
</script>
