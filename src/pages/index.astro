---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import Character from "../components/Character.astro";
import { siteConfig } from "../config/site";
import { withBase } from "../lib/urls";
import { currentProgramGroups, schools } from "../data/schools";

const metadata = {
  title: siteConfig.name,
  description: siteConfig.description,
  ignoreTitleTemplate: true,
};

const programCount = currentProgramGroups().size;

const steps = [
  {
    character: "bun" as const,
    background: "bg-peach",
    title: "Udělej test zájmů",
    text: "Pár krátkých otázek o tom, co tě baví. Hned uvidíš obory, které ti sedí.",
    href: "/test/",
    link: "Spustit test",
  },
  {
    character: "vest" as const,
    background: "bg-mint",
    title: "Projdi školy a obory",
    text: "Hledej podle oboru nebo města a podívej se, kde se co učí.",
    href: "/skoly/",
    link: "Otevřít katalog",
  },
  {
    character: "cap" as const,
    background: "bg-lilac",
    title: "Ulož si favority",
    text: "Srdíčkem si ulož školy, které tě zaujaly, a porovnej je.",
    href: "/oblibene/",
    link: "Moje oblíbené",
  },
];

/** Shortcuts into the catalog search; the query matches program names. */
const interests = [
  { icon: "💻", label: "IT a programování", query: "informační technologie", color: "bg-sky/20 hover:bg-sky/35" },
  { icon: "🎨", label: "Design a média", query: "design", color: "bg-pink/15 hover:bg-pink/30" },
  { icon: "⚙️", label: "Technika a stroje", query: "strojírenství", color: "bg-orange/15 hover:bg-orange/30" },
  { icon: "🩺", label: "Zdravotnictví", query: "zdravotnick", color: "bg-mint hover:bg-lime/40" },
  { icon: "🍳", label: "Gastro a hotely", query: "kuchař", color: "bg-sun/30 hover:bg-sun/50" },
  { icon: "💼", label: "Ekonomika", query: "ekonomika", color: "bg-lilac hover:bg-primary/20" },
  { icon: "🐾", label: "Zvířata a příroda", query: "veterin", color: "bg-lime/25 hover:bg-lime/45" },
  { icon: "🤝", label: "Pedagogika", query: "pedagog", color: "bg-peach hover:bg-orange/25" },
];
---

<BaseLayout {metadata}>
  <section class="relative overflow-hidden px-6 pb-16 pt-28 md:pt-32">
    <div class="mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-[1fr_1.1fr]">
      <div>
        <span class="sticker-note -rotate-2 bg-lime">Pro deváťáky z celého Česka</span>
        <h1 class="mt-6 text-5xl font-extrabold leading-[1.02] md:text-7xl">
          Najdi střední, <span class="relative inline-block text-primary">která ti sedí<svg class="absolute -bottom-2 left-0 w-full" viewBox="0 0 300 12" fill="none" aria-hidden="true"><path d="M2 9c60-6 160-8 296-3" stroke="var(--orange)" stroke-width="5" stroke-linecap="round" /></svg></span>.
        </h1>
        <p class="mt-6 max-w-lg text-lg text-muted-foreground">
          Zjisti, co tě baví, a podívej se, které školy to učí. Bez registrace a zadarmo.
        </p>
        <div class="mt-8 flex flex-col gap-4 sm:flex-row">
          <a href={withBase("/test/")} class="btn-primary">✨ Udělat test zájmů</a>
          <a href={withBase("/skoly/")} class="btn-outline">Prohlédnout školy</a>
        </div>
        <ul class="mt-8 flex flex-wrap gap-3 text-sm font-semibold">
          <li class="rounded-full border-2 border-ink bg-white px-4 py-2">🏫 {schools.length} škol</li>
          <li class="rounded-full border-2 border-ink bg-white px-4 py-2">📚 {programCount} oborů</li>
          <li class="rounded-full border-2 border-ink bg-white px-4 py-2">✅ oficiální data MŠMT</li>
        </ul>
      </div>

      <div class="relative isolate">
        <div class="blob left-[6%] top-[8%] h-[78%] w-[88%] bg-mint"></div>
        <div class="blob blob-alt -right-4 top-0 h-40 w-40 bg-sun/70"></div>
        <div class="blob bottom-2 left-0 h-28 w-28 bg-pink/30"></div>
        <Character name="group" class="character-float relative w-full" eager />
        <span class="sticker-note absolute right-2 top-2 rotate-6 bg-sun" aria-hidden="true">Tvoje cesta ✦</span>
        <span class="sticker-note absolute bottom-4 left-4 -rotate-3 bg-sky text-ink" aria-hidden="true">Najdi svůj směr ↗</span>
      </div>
    </div>
  </section>

  <section class="px-6 py-16" aria-labelledby="how-heading">
    <div class="mx-auto max-w-6xl">
      <h2 id="how-heading" class="text-center text-3xl font-extrabold md:text-4xl">Jak to funguje</h2>
      <div class="mt-10 grid gap-8 md:grid-cols-3">
        {steps.map((step, index) => (
          <a href={withBase(step.href)} class="school-card group flex flex-col overflow-hidden">
            <div class:list={["relative flex h-56 items-end justify-center overflow-hidden border-b-2 border-ink pt-4", step.background]}>
              <span class="absolute left-4 top-4 grid h-10 w-10 place-items-center rounded-full border-2 border-ink bg-white font-display text-lg font-extrabold">{index + 1}</span>
              <Character name={step.character} class="h-52 w-auto transition-transform duration-300 group-hover:-translate-y-2" />
            </div>
            <div class="flex flex-1 flex-col p-6">
              <h3 class="text-xl font-extrabold">{step.title}</h3>
              <p class="mt-2 flex-1 text-muted-foreground">{step.text}</p>
              <span class="mt-4 font-semibold text-primary">{step.link} →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="px-6 py-16" aria-labelledby="interests-heading">
    <div class="mx-auto max-w-6xl">
      <h2 id="interests-heading" class="text-3xl font-extrabold md:text-4xl">Co tě baví?</h2>
      <p class="mt-2 text-muted-foreground">Klikni a uvidíš školy, které to učí.</p>
      <div class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-4">
        {interests.map((interest) => (
          <a
            href={`${withBase("/skoly/")}?q=${encodeURIComponent(interest.query)}`}
            class:list={["flex items-center gap-2 rounded-2xl border-2 border-ink p-3 text-sm font-semibold leading-tight shadow-[3px_3px_0_var(--ink)] transition hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[5px_5px_0_var(--ink)] sm:gap-3 sm:p-4 sm:text-base", interest.color]}
          >
            <span class="shrink-0 text-xl sm:text-2xl" aria-hidden="true">{interest.icon}</span>
            <span class="min-w-0 hyphens-auto break-words">{interest.label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="px-6 py-16">
    <div class="track-card relative mx-auto grid max-w-5xl items-center gap-6 overflow-hidden bg-sun/40 p-8 md:grid-cols-[1fr_14rem] md:p-12">
      <div>
        <h2 class="text-3xl font-extrabold md:text-4xl">Školy si můžeš uložit</h2>
        <p class="mt-3 max-w-md text-muted-foreground">
          U každé školy klikni na srdíčko ♡. Všechny uložené najdeš pohromadě v Oblíbených, i když přijdeš zítra.
        </p>
        <a href={withBase("/skoly/")} class="btn-outline mt-6">Vybrat školy</a>
      </div>
      <Character name="hoodie" class="character-float-delay mx-auto w-48 md:w-full" />
    </div>
  </section>
</BaseLayout>
