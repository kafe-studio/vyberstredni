---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import Character from "../components/Character.astro";
import { siteConfig } from "../config/site";
import { withBase } from "../lib/urls";
import { currentProgramGroups, schools } from "../data/schools";
import { PRIMARY_QUESTION_ID, QUESTIONS } from "../lib/quiz-questions";

const metadata = {
  title: siteConfig.name,
  description: siteConfig.description,
  ignoreTitleTemplate: true,
};

const programCount = currentProgramGroups().size;

const steps = [
  {
    character: "bun" as const,
    background: "bg-peach",
    title: "Udělej si test podle zájmů",
    text: "Pár krátkých otázek o tom, co tě baví. Na konci uvidíš obory, které odpovídají tvým zájmům.",
    href: "/test/",
    link: "Spustit test",
  },
  {
    character: "vest" as const,
    background: "bg-mint",
    title: "Projdi školy a obory",
    text: "Hledej podle oboru nebo města a podívej se, kde se co učí.",
    href: "/skoly/",
    link: "Otevřít katalog",
  },
  {
    character: "cap" as const,
    background: "bg-lilac",
    title: "Ulož si favority",
    text: "Srdíčkem si ulož školy, které tě zaujaly, a porovnej je.",
    href: "/oblibene/",
    link: "Moje oblíbené",
  },
];

/** The quiz starts right on the homepage: its first question, answered here, opens the quiz at question 2. */
const firstQuestion = QUESTIONS.find((question) => question.id === PRIMARY_QUESTION_ID);
const remainingQuestions = QUESTIONS.length - 1;
---

<BaseLayout {metadata}>
  <section class="relative overflow-hidden px-6 pb-16 pt-28 md:pt-32">
    <div class="mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-[1fr_1.1fr]">
      <div>
        <span class="font-hand inline-block -rotate-2 text-3xl font-bold text-primary">Pro žáky 9. tříd a jejich rodiče</span>
        <h1 class="mt-4 text-5xl font-extrabold leading-[1.02] md:text-7xl">
          Vyber střední školu podle <span class="hl">toho, co tě baví.</span>
        </h1>
        <p class="mt-6 max-w-lg text-lg text-muted-foreground">
          Zjisti, co tě baví, a podívej se, které školy to učí. Bez registrace a zadarmo.
        </p>
        <div class="mt-8 flex flex-col gap-4 sm:flex-row">
          <a href={withBase("/test/")} class="btn-primary btn-cta">Udělej si test podle zájmů <span class="cta-arrow" aria-hidden="true">→</span></a>
          <a href={withBase("/skoly/")} class="btn-outline">Prohlédnout školy</a>
        </div>
        <ul class="mt-8 flex flex-wrap gap-3 text-sm font-semibold">
          <li class="rounded-[3px] bg-card px-4 py-2 shadow-paper">🏫 {schools.length} škol</li>
          <li class="rounded-[3px] bg-card px-4 py-2 shadow-paper">📚 {programCount} oborů</li>
          <li class="rounded-[3px] bg-card px-4 py-2 shadow-paper">✅ oficiální data MŠMT</li>
        </ul>
      </div>

      <div class="relative isolate">
        <div class="blob left-[6%] top-[8%] h-[78%] w-[88%] bg-mint"></div>
        <div class="blob blob-alt -right-4 top-0 h-40 w-40 bg-sun/70"></div>
        <div class="blob bottom-2 left-0 h-28 w-28 bg-pink/30"></div>
        <Character name="group" class="character-float relative w-full" eager />
        <span class="font-hand absolute -bottom-2 left-2 -rotate-3 text-2xl font-bold" aria-hidden="true">↑ ty a parta za rok</span>
      </div>
    </div>
  </section>

  {firstQuestion && (
    <section class="px-4 py-12 sm:px-6" aria-labelledby="quiz-start-heading">
      <div class="track-card relative mx-auto max-w-3xl px-5 pb-6 pt-8 sm:px-8 sm:pb-8">
        <span class="absolute -top-3 left-8 h-6 w-24 -rotate-3 bg-sun/80" aria-hidden="true"></span>
        <span class="absolute -top-3 right-10 h-6 w-20 rotate-3 bg-pink/70" aria-hidden="true"></span>
        <p class="text-sm font-bold text-muted-foreground">Test podle zájmů · otázka 1 z {QUESTIONS.length}</p>
        <div class="mt-2 h-3 overflow-hidden rounded-full border-2 border-ink bg-white" aria-hidden="true">
          <div class="h-full rounded-full" style={`width: ${100 / (QUESTIONS.length + 1)}%; background: repeating-linear-gradient(-45deg, var(--primary) 0 10px, #d9493f 10px 20px)`}></div>
        </div>
        <h2 id="quiz-start-heading" class="mt-5 text-2xl font-extrabold sm:text-3xl">{firstQuestion.prompt}</h2>
        <p class="mt-1 text-sm text-muted-foreground">Klikni na odpověď a test pokračuje. Zbývá {remainingQuestions} krátkých otázek.</p>
        <div class="mt-5 grid gap-3 sm:grid-cols-2">
          {firstQuestion.options.map((option) => (
            <a
              href={`${withBase("/test/")}?zajem=${encodeURIComponent(option.value)}`}
              class="flex min-h-14 items-center gap-3 rounded-[4px] border border-border bg-card p-4 font-semibold text-ink shadow-paper transition hover:-translate-y-0.5 hover:bg-sun hover:shadow-paper-lift"
            >
              <span class="text-2xl" aria-hidden="true">{option.icon}</span>
              <span>{option.label}</span>
              <span class="ml-auto text-primary" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="px-6 py-16" aria-labelledby="how-heading">
    <div class="mx-auto max-w-6xl">
      <h2 id="how-heading" class="font-hand text-center text-5xl font-bold md:text-6xl">Jak to funguje</h2>
      <div class="mt-10 grid gap-8 md:grid-cols-3">
        {steps.map((step, index) => (
          <a href={withBase(step.href)} class="school-card group flex flex-col overflow-hidden">
            <div class:list={["relative flex h-56 items-end justify-center overflow-hidden pt-4", step.background]}>
              <span class="absolute left-4 top-4 font-hand text-5xl font-bold leading-none text-primary">{index + 1}</span>
              <Character name={step.character} class="h-52 w-auto transition-transform duration-300 group-hover:-translate-y-2" />
            </div>
            <div class="flex flex-1 flex-col p-6">
              <h3 class="text-xl font-extrabold">{step.title}</h3>
              <p class="mt-2 flex-1 text-muted-foreground">{step.text}</p>
              <span class="mt-4 font-semibold text-primary">{step.link} →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>


  <section class="px-6 py-16">
    <div class="track-card lined-paper relative mx-auto grid max-w-5xl items-center gap-6 overflow-hidden p-8 md:grid-cols-[1fr_14rem] md:p-12">
      <div>
        <h2 class="text-3xl font-extrabold md:text-4xl">Školy si můžeš uložit</h2>
        <p class="mt-3 max-w-md text-muted-foreground">
          U každé školy klikni na srdíčko ♡. Všechny uložené najdeš pohromadě v Oblíbených, i když přijdeš zítra.
        </p>
        <a href={withBase("/skoly/")} class="btn-outline mt-6">Vybrat školy</a>
      </div>
      <Character name="hoodie" class="character-float-delay mx-auto w-48 md:w-full" />
    </div>
  </section>
</BaseLayout>
