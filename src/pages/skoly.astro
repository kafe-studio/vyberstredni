---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import Character from "../components/Character.astro";
import { withBase } from "../lib/urls";
import { schoolSnapshotDate, schoolSource, schools, schoolsByName, uniqueSchoolPrograms } from "../data/schools";
import { REGIONS } from "../lib/regions";
import { SUPPORT_TYPES, supportLabels } from "../lib/special-needs";

/** Cards rendered into the HTML; the rest is rendered on demand from /data/*.json. */
const PAGE_SIZE = 24;
const PROGRAMS_ON_CARD = 3;

const founderBadge = (founderCode: string) =>
  founderCode === "5" ? "soukromá" : founderCode === "6" ? "církevní" : "";

/** Current program names without duplicates (the same name can exist under several codes). */
const programNames = (school: (typeof schools)[number]) => [
  ...new Set(uniqueSchoolPrograms(school.programs.filter((program) => !program.isPhasingOut)).map((program) => program.name)),
];

const initialSchools = schoolsByName.slice(0, PAGE_SIZE).map((school) => ({
  ...school,
  badge: founderBadge(school.founderCode),
  names: programNames(school),
}));

const metadata = {
  title: "Katalog škol",
  description: "Střední školy a konzervatoře v celém Česku. Hledej podle názvu, oboru, města nebo kraje.",
};
---

<BaseLayout {metadata}>
  <section class="px-6 pb-16 pt-28 md:pt-32">
    <div class="mx-auto max-w-6xl">
      <header class="relative mb-8 flex items-end justify-between gap-6">
        <div>
          <span class="sticker-note -rotate-2 bg-sky text-ink">{schools.length} škol</span>
          <h1 class="mt-4 text-4xl font-extrabold md:text-6xl">Katalog škol</h1>
          <p class="mt-3 text-lg text-muted-foreground">
            Střední školy a konzervatoře v celém Česku.
          </p>
        </div>
        <div class="relative isolate hidden w-36 shrink-0 sm:block md:w-44">
          <div class="blob inset-x-0 bottom-0 top-8 bg-lime/50"></div>
          <Character name="cap" class="character-float relative w-full" />
        </div>
      </header>

      <div class="mb-6 track-card p-4 md:p-5">
        <label class="block">
          <span class="sr-only">Hledat</span>
          <input
            id="school-search"
            type="search"
            placeholder="🔍 Hledej školu, obor nebo město…"
            class="w-full rounded-xl border-2 border-ink bg-white px-4 py-3 text-lg text-foreground placeholder:text-muted-foreground"
          />
        </label>
        <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          <label class="block">
            <span class="mb-1 block text-xs font-medium text-muted-foreground">Kraj</span>
            <select id="filter-region" class="w-full rounded-xl border-2 border-ink bg-white px-3 py-2.5 text-foreground">
              <option value="">Celé Česko</option>
              {REGIONS.map((region) => <option value={region}>{region}</option>)}
            </select>
          </label>
          <label class="block">
            <span class="mb-1 block text-xs font-medium text-muted-foreground">Typ studia</span>
            <select id="filter-track" class="w-full rounded-xl border-2 border-ink bg-white px-3 py-2.5 text-foreground">
              <option value="">Všechny</option>
              <option value="general">Gymnázium</option>
              <option value="maturita">Odborná škola s maturitou</option>
              <option value="vyucni">Učební obor (výuční list)</option>
            </select>
          </label>
          <label class="block">
            <span class="mb-1 block text-xs font-medium text-muted-foreground">Zřizovatel</span>
            <select id="filter-founder" class="w-full rounded-xl border-2 border-ink bg-white px-3 py-2.5 text-foreground">
              <option value="">Všechny</option>
              <option value="public">Veřejné</option>
              <option value="private">Soukromé</option>
              <option value="church">Církevní</option>
            </select>
          </label>
          <label class="block">
            <span class="mb-1 block text-xs font-medium text-muted-foreground">Podpora</span>
            <select id="filter-support" class="w-full rounded-xl border-2 border-ink bg-white px-3 py-2.5 text-foreground">
              <option value="">Všechny školy</option>
              <option value="mainstream">Běžné školy</option>
              {SUPPORT_TYPES.map((support) => <option value={support}>Školy {supportLabels[support]}</option>)}
            </select>
          </label>
        </div>
      </div>

      <div class="mb-4 flex items-center justify-between gap-4 text-sm text-muted-foreground">
        <p aria-live="polite"><span id="school-count" class="font-semibold text-foreground">{schools.length}</span> škol</p>
        <button id="reset-filters" type="button" class="font-medium text-primary hover:underline" hidden>Zrušit filtry</button>
      </div>

      <p id="catalog-status" class="mb-4 rounded-xl border border-border p-4 text-sm text-muted-foreground" role="status" hidden></p>

      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3" id="school-grid" data-page-size={PAGE_SIZE} data-programs-on-card={PROGRAMS_ON_CARD}>
        {initialSchools.map((school) => (
          <article class="school-card flex flex-col p-5">
            <div class="flex items-start justify-between gap-3">
              <div class="flex flex-wrap gap-2 text-xs">
                <span class="rounded-full bg-muted px-2.5 py-1 text-muted-foreground">{school.region}</span>
                {school.badge && <span class="rounded-full bg-primary/10 px-2.5 py-1 text-primary">{school.badge}</span>}
                {school.support && <span class="rounded-full bg-sky/25 px-2.5 py-1 text-ink">{supportLabels[school.support]}</span>}
              </div>
              <button type="button" class="favorite-toggle -m-1 p-1 text-xl leading-none text-muted-foreground transition hover:text-primary" data-school-id={school.id} aria-pressed="false" aria-label={`Přidat do oblíbených: ${school.name}`}>
                <span class="favorite-icon" aria-hidden="true">♡</span>
              </button>
            </div>
            <a href={withBase(`/skoly/${school.id}/`)} class="mt-3 text-lg font-semibold leading-snug text-foreground hover:text-primary">{school.name}</a>
            <p class="mt-1 text-sm text-muted-foreground">{school.address}</p>
            {school.names.length > 0 && (
              <p class="mt-3 text-sm text-foreground/80">
                {school.names.slice(0, PROGRAMS_ON_CARD).join(" · ")}
                {school.names.length > PROGRAMS_ON_CARD && <span class="text-muted-foreground"> · +{school.names.length - PROGRAMS_ON_CARD}</span>}
              </p>
            )}
          </article>
        ))}
      </div>
      <div id="empty-results" class="rounded-2xl border border-dashed border-border p-8 text-center text-muted-foreground" hidden>
        Nic jsme nenašli. Zkus jiné slovo nebo zruš filtry.
      </div>
      <button id="load-more" type="button" class="btn-outline mt-8 w-full" disabled>Zobrazit další školy</button>

      <p class="mt-10 text-xs leading-5 text-muted-foreground">
        Zdroj: <a class="underline" href={schoolSource} target="_blank" rel="noreferrer">Rejstřík škol MŠMT</a>, stav k {schoolSnapshotDate}.
        Obory odpovídají zápisu v rejstříku; jestli škola obor letos otevírá, si ověř na jejím webu.
      </p>
    </div>
  </section>

  <script>
    import { withBase } from "../lib/urls";
    import { escapeHtml, getFavorites, loadSchoolPrograms, loadSchools, toggleFavorite, type SchoolSummary } from "../lib/school-data";
    import { supportLabels } from "../lib/special-needs";
    import { isNotForNinthGraders, isStudyTrack, matchesTrack, type StudyTrack } from "../lib/interest-test";

    type CatalogSchool = SchoolSummary & { programNames: string[]; tracks: Set<StudyTrack>; searchText: string };

    const FILTER_TRACKS: StudyTrack[] = ["general", "maturita", "vyucni"];

    document.addEventListener("astro:page-load", () => {
      const schoolGrid = document.getElementById("school-grid");
      const searchInput = document.getElementById("school-search") as HTMLInputElement | null;
      if (!schoolGrid || !searchInput) return;

      const pageSize = Number(schoolGrid.dataset.pageSize) || 24;
      const programsOnCard = Number(schoolGrid.dataset.programsOnCard) || 3;
      const regionSelect = document.getElementById("filter-region") as HTMLSelectElement | null;
      const trackSelect = document.getElementById("filter-track") as HTMLSelectElement | null;
      const founderSelect = document.getElementById("filter-founder") as HTMLSelectElement | null;
      const supportSelect = document.getElementById("filter-support") as HTMLSelectElement | null;
      const resetButton = document.getElementById("reset-filters") as HTMLButtonElement | null;
      const schoolCount = document.getElementById("school-count");
      const emptyResults = document.getElementById("empty-results");
      const catalogStatus = document.getElementById("catalog-status");
      const loadMoreButton = document.getElementById("load-more") as HTMLButtonElement | null;

      let entries: CatalogSchool[] = [];
      let visibleLimit = pageSize;

      const updateFavoriteButtons = () => {
        const favorites = new Set(getFavorites());
        schoolGrid.querySelectorAll<HTMLButtonElement>(".favorite-toggle").forEach((button) => {
          const active = favorites.has(button.dataset.schoolId ?? "");
          button.setAttribute("aria-pressed", String(active));
          button.classList.toggle("text-primary", active);
          const icon = button.querySelector(".favorite-icon");
          if (icon) icon.textContent = active ? "♥" : "♡";
        });
      };

      const getFilteredItems = () => {
        const query = searchInput.value.trim().toLocaleLowerCase("cs");
        const region = regionSelect?.value ?? "";
        const trackValue = trackSelect?.value ?? "";
        const track = isStudyTrack(trackValue) ? trackValue : null;
        const founder = founderSelect?.value ?? "";
        const support = supportSelect?.value ?? "";
        return entries.filter((school) =>
          (!region || school.region === region) &&
          (!support || (support === "mainstream" ? school.support === null : school.support === support)) &&
          (!track || school.tracks.has(track)) &&
          (!founder ||
            (founder === "private" && school.founderCode === "5") ||
            (founder === "church" && school.founderCode === "6") ||
            (founder === "public" && !["5", "6"].includes(school.founderCode))) &&
          school.searchText.includes(query));
      };

      const renderCard = (school: CatalogSchool) => {
        const badge = school.founderCode === "5" ? "soukromá" : school.founderCode === "6" ? "církevní" : "";
        const names = school.programNames;
        const extra = names.length > programsOnCard ? `<span class="text-muted-foreground"> · +${names.length - programsOnCard}</span>` : "";
        return `
          <article class="school-card flex flex-col p-5">
            <div class="flex items-start justify-between gap-3">
              <div class="flex flex-wrap gap-2 text-xs">
                <span class="rounded-full bg-muted px-2.5 py-1 text-muted-foreground">${escapeHtml(school.region)}</span>
                ${badge ? `<span class="rounded-full bg-primary/10 px-2.5 py-1 text-primary">${badge}</span>` : ""}
                ${school.support ? `<span class="rounded-full bg-sky/25 px-2.5 py-1 text-ink">${escapeHtml(supportLabels[school.support])}</span>` : ""}
              </div>
              <button type="button" class="favorite-toggle -m-1 p-1 text-xl leading-none text-muted-foreground transition hover:text-primary" data-school-id="${escapeHtml(school.id)}" aria-pressed="false" aria-label="Přidat do oblíbených: ${escapeHtml(school.name)}">
                <span class="favorite-icon" aria-hidden="true">♡</span>
              </button>
            </div>
            <a href="${withBase(`/skoly/${encodeURIComponent(school.id)}/`)}" class="mt-3 text-lg font-semibold leading-snug text-foreground hover:text-primary">${escapeHtml(school.name)}</a>
            <p class="mt-1 text-sm text-muted-foreground">${escapeHtml(school.address)}</p>
            ${names.length ? `<p class="mt-3 text-sm text-foreground/80">${names.slice(0, programsOnCard).map(escapeHtml).join(" · ")}${extra}</p>` : ""}
          </article>`;
      };

      const render = () => {
        if (!entries.length) return;
        const items = getFilteredItems();
        const visible = items.slice(0, visibleLimit);
        if (schoolCount) schoolCount.textContent = String(items.length);
        if (emptyResults) emptyResults.hidden = items.length > 0;
        if (loadMoreButton) {
          const remaining = items.length - visible.length;
          loadMoreButton.hidden = remaining <= 0;
          loadMoreButton.disabled = remaining <= 0;
          loadMoreButton.textContent = `Zobrazit další školy (${remaining})`;
        }
        if (resetButton) {
          resetButton.hidden = !searchInput.value && !regionSelect?.value && !trackSelect?.value && !founderSelect?.value && !supportSelect?.value;
        }
        schoolGrid.innerHTML = visible.map(renderCard).join("");
        updateFavoriteButtons();
      };

      const syncQueryParam = () => {
        const url = new URL(window.location.href);
        const query = searchInput.value.trim();
        if (query) url.searchParams.set("q", query);
        else url.searchParams.delete("q");
        if (url.href !== window.location.href) window.history.replaceState(window.history.state, "", url);
      };

      const resetAndRender = () => {
        visibleLimit = pageSize;
        syncQueryParam();
        render();
      };

      schoolGrid.addEventListener("click", (event) => {
        const target = event.target;
        const button = target instanceof Element ? target.closest<HTMLButtonElement>(".favorite-toggle") : null;
        const id = button?.dataset.schoolId;
        if (!id) return;
        toggleFavorite(id);
        updateFavoriteButtons();
      });
      searchInput.addEventListener("input", resetAndRender);
      [regionSelect, trackSelect, founderSelect, supportSelect].forEach((select) => select?.addEventListener("change", resetAndRender));
      resetButton?.addEventListener("click", () => {
        searchInput.value = "";
        [regionSelect, trackSelect, founderSelect, supportSelect].forEach((select) => { if (select) select.value = ""; });
        resetAndRender();
      });
      loadMoreButton?.addEventListener("click", () => {
        visibleLimit += pageSize;
        render();
      });

      // Pre-fill the search from links like /skoly/?q=kuchař (interest shortcuts on the home page).
      const initialQuery = new URLSearchParams(window.location.search).get("q");
      if (initialQuery) searchInput.value = initialQuery;

      updateFavoriteButtons();

      Promise.all([loadSchools(), loadSchoolPrograms()])
        .then(([schoolList, programsById]) => {
          entries = schoolList.map((school) => {
            const programs = (programsById[school.id] ?? []).filter((program) => !program.isPhasingOut);
            const programNames = [...new Set(programs.map((program) => program.name))];
            const searchText = [
              school.name, school.region, school.town, school.founder, school.address, school.izo,
              ...programs.flatMap((program) => [program.name, program.code]),
            ].join(" ").toLocaleLowerCase("cs");
            // Same rules as the quiz: only programs a 9th grader can apply to count for the study-type filter.
            const tracks = new Set(FILTER_TRACKS.filter((filterTrack) =>
              programs.some((program) => !isNotForNinthGraders(program.code) && matchesTrack(program.code, filterTrack))));
            return { ...school, programNames, tracks, searchText };
          });
          render();
        })
        .catch(() => {
          if (catalogStatus) {
            catalogStatus.textContent = "Data katalogu se nepodařilo načíst, hledání a filtry proto nefungují. Zkus stránku obnovit.";
            catalogStatus.hidden = false;
          }
        });
    });
  </script>
</BaseLayout>
