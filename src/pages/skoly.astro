---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config/site";
import { withBase } from "../lib/urls";
import { schoolSnapshotDate, schoolSource, schools, uniqueSchoolPrograms } from "../data/schools";

const privateCount = schools.filter((school) => school.founderCode === "5").length;
const pragueCount = schools.filter((school) => school.region === "Praha").length;
const centralBohemiaCount = schools.length - pragueCount;
const currentPrograms = (school: (typeof schools)[number]) =>
  uniqueSchoolPrograms(school.programs.filter((program) => !program.isPhasingOut));
const catalogPrograms = (programs: (typeof schools)[number]["programs"]) => {
  const uniquePrograms = uniqueSchoolPrograms(programs);
  const currentKeys = new Set(
    uniquePrograms
      .filter((program) => !program.isPhasingOut)
      .map((program) => JSON.stringify([program.code, program.name])),
  );
  return uniquePrograms.filter((program) =>
    !program.isPhasingOut || !currentKeys.has(JSON.stringify([program.code, program.name])));
};
const catalogSchools = schools.map(({ id, name, region, type, focus, founder, founderCode, address, izo, redIzo, ico, officialTypeCode, capacity, phone, email, website, tags, programs }) => ({
  id, name, region, type, focus, founder, founderCode, address, izo, redIzo, ico, officialTypeCode, capacity, phone, email, website, tags,
  programs: catalogPrograms(programs).map(({ code, name, isPhasingOut }) => ({ code, name, isPhasingOut })),
}));

const metadata = {
  title: "Katalog škol | " + siteConfig.name,
  description: "Oficiální katalog středních škol a konzervatoří v Praze a Středočeském kraji včetně evidovaných studijních oborů.",
};
---

<BaseLayout {metadata}>
  <section class="px-6 pb-16 pt-28 md:pt-32">
    <div class="mx-auto max-w-6xl">
      <div class="mb-10 text-center reveal">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-muted-foreground">Oficiální katalog MŠMT</p>
        <h1 class="mt-4 text-4xl font-black md:text-5xl">Střední školy a konzervatoře</h1>
        <p class="mx-auto mt-4 max-w-3xl text-lg text-muted-foreground">
          {schools.length} aktivních záznamů pro Prahu a Středočeský kraj, včetně soukromých a církevních škol.
        </p>
        <p class="mx-auto mt-3 max-w-3xl text-sm text-muted-foreground">
          Zdroj: <a class="text-primary underline" href={schoolSource} target="_blank" rel="noreferrer">Rejstřík škol MŠMT</a>.
          Export: {schoolSnapshotDate}. Praha: {pragueCount}, Středočeský kraj: {centralBohemiaCount},
          soukromé: {privateCount}.
        </p>
        <p class="mx-auto mt-2 max-w-3xl text-sm text-muted-foreground">
          V katalogu je {schools.reduce((count, school) => count + school.programs.length, 0)} záznamů oborů evidovaných u škol podle IZO.
          Jde o zápis v rejstříku, nikoli potvrzení, že škola obor otevře v nejbližším přijímacím řízení.
        </p>
      </div>

      <div class="mb-6 flex items-center justify-between gap-4 reveal">
        <p class="text-sm text-muted-foreground">Oblíbené školy: <span id="favorites-count">0</span></p>
        <p class="text-sm text-muted-foreground"><span id="school-count">{schools.length}</span> škol zobrazeno</p>
      </div>

      <div class="mb-8 flex flex-wrap gap-3 reveal" data-filter-group>
        <button type="button" class="filter-pill is-active" data-filter="all">Vše</button>
        <button type="button" class="filter-pill" data-filter="Praha">Praha</button>
        <button type="button" class="filter-pill" data-filter="Středočeský kraj">Středočeský kraj</button>
        <button type="button" class="filter-pill" data-filter="soukromé">Soukromé</button>
        <button type="button" class="filter-pill" data-filter="církevní">Církevní</button>
        <button type="button" class="filter-pill" data-filter="veřejné">Veřejné</button>
        <button type="button" class="filter-pill" data-filter="technologie">Technologie*</button>
        <button type="button" class="filter-pill" data-filter="design">Umění a design*</button>
        <button type="button" class="filter-pill" data-filter="ekonomie">Ekonomie*</button>
        <button type="button" class="filter-pill" data-filter="zdravotnictví">Zdravotnictví*</button>
        <button type="button" class="filter-pill" data-filter="společnost">Ostatní*</button>
      </div>

      <div class="mb-4 grid gap-4 md:grid-cols-[1fr_220px] reveal">
        <label class="block">
          <span class="mb-2 block text-sm font-medium text-foreground">Hledat školu nebo obor</span>
          <input id="school-search" type="search" placeholder="Název školy či oboru, kód oboru, adresa, IZO..." class="w-full rounded-xl border border-border bg-background/40 px-3 py-2.5 text-foreground placeholder:text-muted-foreground" />
        </label>
        <label class="block">
          <span class="mb-2 block text-sm font-medium text-foreground">Řazení</span>
          <select id="school-sort" class="w-full rounded-xl border border-border bg-background/40 px-3 py-2.5 text-foreground">
            <option value="name">Název A–Z</option>
            <option value="region">Region</option>
            <option value="founder">Zřizovatel</option>
            <option value="type">Typ školy</option>
          </select>
        </label>
      </div>
      <p class="mb-8 text-xs text-muted-foreground">
        * Tematická oblast je pouze orientační zařazení podle názvu školy. Nabízené obory jsou převzaty z regionálního exportu MŠMT a ověřeny podle IZO.
        Rejstříková kapacita je kapacita celé školy, ne počet míst v prvním ročníku.
      </p>

      <div class="track-card reveal mb-8 p-6">
        <div class="mb-5">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-muted-foreground">Porovnání škol</p>
          <h2 class="mt-2 text-2xl font-bold">Vyber dvě školy a srovnej jejich údaje v rejstříku</h2>
        </div>
        <div class="grid gap-4 md:grid-cols-2">
          <label class="block">
            <span class="mb-2 block text-sm font-medium text-foreground">První škola</span>
            <select id="school-compare-a" class="w-full rounded-xl border border-border bg-background/40 px-3 py-2.5 text-foreground">
              {schools.map((school) => <option value={school.id}>{school.name}</option>)}
            </select>
          </label>
          <label class="block">
            <span class="mb-2 block text-sm font-medium text-foreground">Druhá škola</span>
            <select id="school-compare-b" class="w-full rounded-xl border border-border bg-background/40 px-3 py-2.5 text-foreground">
              {schools.map((school, index) => <option value={school.id} selected={index === 1}>{school.name}</option>)}
            </select>
          </label>
        </div>
        <div id="compare-results" class="mt-6 grid gap-4 md:grid-cols-2"></div>
      </div>

      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3" id="school-grid">
        {schools.map((school) => (
          <article class="school-card reveal flex h-full flex-col p-6">
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground">{school.officialTypeCode === "D00" ? "Konzervatoř" : "Střední škola"}</p>
                <h2 class="mt-2 text-xl font-semibold">{school.name}</h2>
              </div>
              <span class="rounded-full border border-border bg-card px-2.5 py-1 text-xs text-muted-foreground">{school.region}</span>
            </div>
            <p class="mt-4 flex-1 text-sm leading-6 text-muted-foreground">{school.address}</p>
            <div class="mt-4">
              <p class="text-xs font-semibold uppercase tracking-[0.12em] text-muted-foreground">Evidované obory</p>
              <ul class="mt-2 space-y-1 text-sm text-foreground">
                {currentPrograms(school).slice(0, 3).map((program) => (
                  <li>{program.name} <span class="text-xs text-muted-foreground">({program.code})</span></li>
                ))}
              </ul>
              {currentPrograms(school).length > 3 && (
                <p class="mt-1 text-xs text-muted-foreground">+ {currentPrograms(school).length - 3} dalších oborů</p>
              )}
            </div>
            <div class="mt-4 flex flex-wrap gap-2">
              <span class="rounded-full border border-border bg-background/40 px-2.5 py-1 text-[11px] text-muted-foreground">{school.founder}</span>
              <span class="rounded-full border border-border bg-background/40 px-2.5 py-1 text-[11px] text-muted-foreground">IZO {school.izo}</span>
            </div>
            <div class="mt-5 flex items-center justify-between gap-3 border-t border-border pt-4">
              <button type="button" class="favorite-toggle inline-flex items-center gap-2 rounded-full border border-border bg-background/40 px-3 py-1.5 text-[10px] font-semibold uppercase tracking-[0.12em] text-muted-foreground transition hover:border-primary/50 hover:text-primary" data-school-id={school.id} aria-pressed="false">
                <span class="favorite-icon text-sm">♡</span><span>Oblíbené</span>
              </button>
              <a href={withBase(`/skoly/${school.id}/`)} class="btn-outline">Detail</a>
            </div>
          </article>
        ))}
      </div>
      <div id="empty-results" class="hidden rounded-2xl border border-dashed border-border p-8 text-center text-muted-foreground">
        Žádné školy neodpovídají zadanému hledání.
      </div>
      <p class="mt-8 rounded-2xl border border-border bg-card p-5 text-sm leading-6 text-muted-foreground">
        Seznam oborů zachycuje zápis v rejstříku MŠMT k datu exportu; aktuální přijímací řízení, otevření oboru a školné si ověř přímo u školy.
        Souřadnice na detailu jsou z adresních míst RÚIAN; vzdálenost se počítá vzdušnou čarou.
      </p>
    </div>
  </section>

  <div id="school-data" data-schools={JSON.stringify(catalogSchools)} hidden></div>
  <script>
    import { withBase } from "../lib/urls";

    document.addEventListener("astro:page-load", () => {
    type SchoolRecord = {
      id: string;
      name: string;
      region: string;
      type: string;
      focus: string;
      founder: string;
      founderCode: string;
      address: string;
      izo: string;
      redIzo: string;
      ico: string;
      officialTypeCode: string;
      capacity: string;
      programs: Array<{ code: string; name: string; isPhasingOut: boolean }>;
      phone: string;
      email: string;
      website: string;
      latitude: number | null;
      longitude: number | null;
      tags: string[];
    };

    const FAVORITES_KEY = "vyberstredni-favorites";
    const schoolPayload = document.getElementById("school-data") as HTMLElement | null;
    const schoolEntries: SchoolRecord[] = schoolPayload?.dataset.schools
      ? JSON.parse(schoolPayload.dataset.schools)
      : [];
    const schoolGrid = document.getElementById("school-grid");
    const schoolCount = document.getElementById("school-count");
    const emptyResults = document.getElementById("empty-results");
    const searchInput = document.getElementById("school-search") as HTMLInputElement | null;
    const sortSelect = document.getElementById("school-sort") as HTMLSelectElement | null;
    const selectA = document.getElementById("school-compare-a") as HTMLSelectElement | null;
    const selectB = document.getElementById("school-compare-b") as HTMLSelectElement | null;
    const compareResults = document.getElementById("compare-results");
    const favoritesCount = document.getElementById("favorites-count");

    const escapeHtml = (value: string) =>
      value.replace(/[&<>"']/g, (character) => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      })[character] ?? character);

    const getCardPrograms = (school: SchoolRecord, query: string) => {
      const currentPrograms = school.programs.filter((program) => !program.isPhasingOut);
      const matchingPrograms = query
        ? school.programs.filter((program) =>
          `${program.name} ${program.code}`.toLocaleLowerCase("cs").includes(query))
        : [];
      return matchingPrograms.length ? matchingPrograms : currentPrograms;
    };

    const getFavorites = (): string[] => {
      try {
        const value = localStorage.getItem(FAVORITES_KEY);
        return value ? JSON.parse(value) : [];
      } catch {
        return [];
      }
    };

    const setFavorites = (favorites: string[]) => {
      localStorage.setItem(FAVORITES_KEY, JSON.stringify(favorites));
      if (favoritesCount) favoritesCount.textContent = String(favorites.length);
    };

    const updateFavoriteButtons = () => {
      const favorites = new Set(getFavorites());
      document.querySelectorAll<HTMLButtonElement>(".favorite-toggle").forEach((button) => {
        const active = favorites.has(button.dataset.schoolId ?? "");
        button.classList.toggle("is-favorite", active);
        button.setAttribute("aria-pressed", String(active));
        button.classList.toggle("border-primary/50", active);
        button.classList.toggle("bg-primary/10", active);
        button.classList.toggle("text-primary", active);
        const icon = button.querySelector(".favorite-icon");
        if (icon) icon.textContent = active ? "♥" : "♡";
      });
    };

    const bindFavoriteButtons = () => {
      schoolGrid?.querySelectorAll<HTMLButtonElement>(".favorite-toggle").forEach((button) => {
        button.addEventListener("click", () => {
          const id = button.dataset.schoolId;
          if (!id) return;
          const favorites = getFavorites();
          setFavorites(favorites.includes(id) ? favorites.filter((item) => item !== id) : [...favorites, id]);
          updateFavoriteButtons();
        });
      });
    };

    const getFilteredItems = () => {
      const filter = document.querySelector<HTMLButtonElement>("[data-filter].is-active")?.dataset.filter ?? "all";
      const query = searchInput?.value.trim().toLocaleLowerCase("cs") ?? "";
      const items = schoolEntries.filter((school) => {
        const matchesFilter =
          filter === "all" ||
          school.region === filter ||
          school.focus === filter ||
          (filter === "soukromé" && school.founderCode === "5") ||
          (filter === "církevní" && school.founderCode === "6") ||
          (filter === "veřejné" && !["5", "6"].includes(school.founderCode));
        const searchable = [
          school.name, school.region, school.type, school.founder, school.address,
          `IZO ${school.izo}`, `RED-IZO ${school.redIzo}`, `IČO ${school.ico}`,
          school.phone, school.email, school.website, ...school.tags,
          ...school.programs.flatMap((program) => [program.name, program.code]),
        ].join(" ").toLocaleLowerCase("cs");
        return matchesFilter && searchable.includes(query);
      });

      const mode = sortSelect?.value ?? "name";
      items.sort((a, b) => {
        if (mode === "region") return a.region.localeCompare(b.region, "cs") || a.name.localeCompare(b.name, "cs");
        if (mode === "founder") return a.founder.localeCompare(b.founder, "cs") || a.name.localeCompare(b.name, "cs");
        if (mode === "type") return a.type.localeCompare(b.type, "cs") || a.name.localeCompare(b.name, "cs");
        return a.name.localeCompare(b.name, "cs");
      });
      return items;
    };

    const renderSchoolCards = () => {
      if (!schoolGrid) return;
      const items = getFilteredItems();
      const query = searchInput?.value.trim().toLocaleLowerCase("cs") ?? "";
      if (schoolCount) schoolCount.textContent = String(items.length);
      if (emptyResults) emptyResults.classList.toggle("hidden", items.length > 0);

      schoolGrid.innerHTML = items.map((school) => `
        <article class="school-card reveal flex h-full flex-col p-6">
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground">${school.officialTypeCode === "D00" ? "Konzervatoř" : "Střední škola"}</p>
              <h2 class="mt-2 text-xl font-semibold">${escapeHtml(school.name)}</h2>
            </div>
            <span class="rounded-full border border-border bg-card px-2.5 py-1 text-xs text-muted-foreground">${escapeHtml(school.region)}</span>
          </div>
          <p class="mt-4 flex-1 text-sm leading-6 text-muted-foreground">${escapeHtml(school.address)}</p>
          <div class="mt-4">
            <p class="text-xs font-semibold uppercase tracking-[0.12em] text-muted-foreground">Evidované obory</p>
            <ul class="mt-2 space-y-1 text-sm text-foreground">
              ${getCardPrograms(school, query).slice(0, 3).map((program) => `<li>${escapeHtml(program.name)} <span class="text-xs text-muted-foreground">(${escapeHtml(program.code)}${program.isPhasingOut ? " · dobíhající" : ""})</span></li>`).join("")}
            </ul>
            ${getCardPrograms(school, query).length > 3 ? `<p class="mt-1 text-xs text-muted-foreground">+ ${getCardPrograms(school, query).length - 3} dalších oborů</p>` : ""}
          </div>
          <div class="mt-4 flex flex-wrap gap-2">
            <span class="rounded-full border border-border bg-background/40 px-2.5 py-1 text-[11px] text-muted-foreground">${escapeHtml(school.founder)}</span>
            <span class="rounded-full border border-border bg-background/40 px-2.5 py-1 text-[11px] text-muted-foreground">IZO ${escapeHtml(school.izo)}</span>
          </div>
          <div class="mt-5 flex items-center justify-between gap-3 border-t border-border pt-4">
            <button type="button" class="favorite-toggle inline-flex items-center gap-2 rounded-full border border-border bg-background/40 px-3 py-1.5 text-[10px] font-semibold uppercase tracking-[0.12em] text-muted-foreground transition hover:border-primary/50 hover:text-primary" data-school-id="${escapeHtml(school.id)}" aria-pressed="false">
              <span class="favorite-icon text-sm">♡</span><span>Oblíbené</span>
            </button>
            <a href="${withBase(`/skoly/${encodeURIComponent(school.id)}/`)}" class="btn-outline">Detail</a>
          </div>
        </article>
      `).join("");
      updateFavoriteButtons();
      bindFavoriteButtons();
    };

    const renderComparison = () => {
      if (!compareResults) return;
      const ids = [selectA?.value, selectB?.value];
      compareResults.innerHTML = ids.map((id) => {
        const school = schoolEntries.find((entry) => entry.id === id);
        if (!school) return "";
        const rows = [
          ["Typ v rejstříku", school.officialTypeCode === "D00" ? "Konzervatoř" : "Střední škola"],
          ["Zřizovatel", school.founder],
          ["Adresa", school.address],
          ["IZO", school.izo],
          ["RED-IZO", school.redIzo],
          ["IČO", school.ico],
          ["Kapacita školy", school.capacity || "V rejstříku neuvedena"],
          ["Telefon", school.phone || "Neuveden"],
          ["E-mail", school.email || "Neuveden"],
        ];
        return `<article class="rounded-2xl border border-border bg-background/40 p-5">
          <h3 class="text-lg font-semibold">${escapeHtml(school.name)}</h3>
          <dl class="mt-4 space-y-3 text-sm">${rows.map(([label, value]) => `<div><dt class="font-semibold text-foreground">${escapeHtml(label)}</dt><dd class="text-muted-foreground">${escapeHtml(value)}</dd></div>`).join("")}</dl>
        </article>`;
      }).join("");
    };

    document.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach((button) => {
      button.addEventListener("click", () => {
        document.querySelector("[data-filter].is-active")?.classList.remove("is-active");
        button.classList.add("is-active");
        renderSchoolCards();
      });
    });
    searchInput?.addEventListener("input", renderSchoolCards);
    sortSelect?.addEventListener("change", renderSchoolCards);
    selectA?.addEventListener("change", renderComparison);
    selectB?.addEventListener("change", renderComparison);

    setFavorites(getFavorites());
    renderSchoolCards();
    renderComparison();
    });
  </script>
</BaseLayout>
