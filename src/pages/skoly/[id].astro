---
export const prerender = true;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { inspectionSource, schoolProgramSources, schoolProgramsSnapshotDate, schoolSnapshotDate, schoolSource, schools, uniqueSchoolPrograms } from "../../data/schools";
import towns from "../../data/towns.json";
import { cermatFor, cermatInfo } from "../../data/cermat";
import { REGIONS } from "../../lib/regions";
import { supportLabels } from "../../lib/special-needs";
import { withBase } from "../../lib/urls";

const typeLabels = {
  gymnázium: "Gymnázium",
  "střední škola": "Střední škola",
  "odborné lyceum": "Odborné lyceum",
  učiliště: "Učiliště",
  konzervatoř: "Konzervatoř",
} as const;

export function getStaticPaths() {
  return schools.map((school) => ({ params: { id: school.id } }));
}

const school = schools.find((item) => item.id === Astro.params.id);
if (!school) throw new Error("Škola nebyla nalezena.");

const activePrograms = uniqueSchoolPrograms(school.programs.filter((program) => !program.isPhasingOut))
  .sort((left, right) => left.name.localeCompare(right.name, "cs") || left.code.localeCompare(right.code, "cs"));
const phasingOutPrograms = uniqueSchoolPrograms(school.programs.filter((program) => program.isPhasingOut))
  .sort((left, right) => left.name.localeCompare(right.name, "cs") || left.code.localeCompare(right.code, "cs"));
const programSource = schoolProgramSources[0];
/** Home locations offered on the map: towns of the school's region, starting at the school's own town. */
const regionTowns = towns
  .filter((town) => town.region === school.region)
  .sort((left, right) => left.name.localeCompare(right.name, "cs", { numeric: true }));
const defaultTown = regionTowns.find((town) => town.name === school.town) ?? regionTowns[0];
const inspection = school.inspection;
const cermat = cermatFor(school.id);
const maturita = cermat?.maturita ?? null;
const admissionOf = (code: string) => cermat?.admission[code] ?? null;
/** Percentiles below 1 would read as "lepší než 0 %". */
const percentileText = (value: number) => (value < 1 ? "méně než 1 %" : `${value} %`);
const programRows = activePrograms.map((program) => ({ ...program, admission: admissionOf(program.code) }));
const percent = (value: number | null | undefined, digits = 0) =>
  value === null || value === undefined
    ? "—"
    : `${value.toLocaleString("cs-CZ", { minimumFractionDigits: digits, maximumFractionDigits: digits })} %`;
const demand = (applications: number, capacity: number) =>
  capacity > 0 ? (applications / capacity).toLocaleString("cs-CZ", { maximumFractionDigits: 1 }) : null;
const inspectionDate = inspection?.date
  ? new Date(`${inspection.date}T00:00:00`).toLocaleDateString("cs-CZ", { day: "numeric", month: "long", year: "numeric" })
  : null;
const hasCoordinates = school.latitude !== null && school.longitude !== null;
const metadata = {
  title: school.name,
  description: `${school.name}, ${school.address}. Oficiálně evidované studijní obory podle MŠMT.`,
};
---

<BaseLayout {metadata}>
  <section class="px-6 pb-20 pt-28 md:pt-32">
    <div class="mx-auto max-w-4xl">
      <a href={withBase("/skoly/")} class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:underline">← Zpět na katalog škol</a>
      <article class="track-card reveal mt-6 p-8 md:p-10">
        <div class="flex flex-col gap-5 md:flex-row md:items-start md:justify-between">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">Orientační označení: {typeLabels[school.type]}</p>
            <h1 class="mt-3 text-3xl font-extrabold md:text-5xl">{school.name}</h1>
          </div>
          <div class="flex flex-wrap items-center gap-3">
            <span class="inline-flex rounded-full border border-border bg-card px-3 py-1.5 text-sm font-medium text-muted-foreground">{school.region}</span>
            {school.support && (
              <span class="inline-flex rounded-full bg-sky/25 px-3 py-1.5 text-sm font-medium text-ink">Škola {supportLabels[school.support]}</span>
            )}
            <button id="favorite-school-btn" type="button" class="favorite-toggle inline-flex items-center gap-2 rounded-full border-2 border-ink bg-white px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.12em] text-muted-foreground transition hover:border-primary/50 hover:text-primary" data-school-id={school.id} aria-pressed="false">
              <span class="favorite-icon text-sm">♡</span><span>Oblíbené</span>
            </button>
          </div>
        </div>

        <p class="mt-6 max-w-3xl text-lg leading-8 text-muted-foreground">{school.address}</p>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          <div class="rounded-2xl border-2 border-ink bg-white p-4">
            <p class="text-sm text-muted-foreground">Typ v rejstříku</p>
            <p class="mt-2 text-lg font-semibold text-foreground">{school.officialTypeCode === "D00" ? "Konzervatoř" : "Střední škola"}</p>
          </div>
          <div class="rounded-2xl border-2 border-ink bg-white p-4">
            <p class="text-sm text-muted-foreground">Zřizovatel</p>
            <p class="mt-2 text-lg font-semibold text-foreground">{school.founder}</p>
          </div>
          <div class="rounded-2xl border-2 border-ink bg-white p-4">
            <p class="text-sm text-muted-foreground">Kapacita celé školy</p>
            <p class="mt-2 text-lg font-semibold text-foreground">{school.capacity || "V rejstříku neuvedena"}</p>
          </div>
          <div class="rounded-2xl border-2 border-ink bg-white p-4">
            <p class="text-sm text-muted-foreground">Tematická oblast*</p>
            <p class="mt-2 text-lg font-semibold text-foreground">{school.focus}</p>
          </div>
        </div>

        <div class="mt-8 rounded-2xl border-2 border-ink bg-white p-5">
          <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-muted-foreground">Kontaktní údaje</h2>
          <dl class="mt-4 grid gap-4 sm:grid-cols-2">
            <div><dt class="text-xs text-muted-foreground">Telefon</dt><dd class="mt-1 text-sm font-medium">{school.phone || "V rejstříku neuveden"}</dd></div>
            <div><dt class="text-xs text-muted-foreground">E-mail</dt><dd class="mt-1 text-sm font-medium">{school.email || "V rejstříku neuveden"}</dd></div>
            <div><dt class="text-xs text-muted-foreground">IZO</dt><dd class="mt-1 text-sm font-medium">{school.izo}</dd></div>
            <div><dt class="text-xs text-muted-foreground">RED-IZO</dt><dd class="mt-1 text-sm font-medium">{school.redIzo}</dd></div>
            <div><dt class="text-xs text-muted-foreground">IČO</dt><dd class="mt-1 text-sm font-medium">{school.ico}</dd></div>
            <div><dt class="text-xs text-muted-foreground">Web školy</dt><dd class="mt-1 text-sm font-medium">
              {school.website ? <a class="text-primary underline" href={school.website.startsWith("http") ? school.website : `https://${school.website}`} target="_blank" rel="noreferrer">{school.website}</a> : "V rejstříku neuveden"}
            </dd></div>
          </dl>
        </div>

        <section class="mt-8 rounded-2xl border-2 border-ink bg-white p-5" aria-labelledby="programs-heading">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 id="programs-heading" class="text-sm font-semibold uppercase tracking-[0.18em] text-muted-foreground">Obory evidované v rejstříku MŠMT</h2>
            <span class="text-xs text-muted-foreground">{activePrograms.length} aktuálně evidovaných · {phasingOutPrograms.length} dobíhajících</span>
          </div>
          <p class="mt-2 text-sm leading-6 text-muted-foreground">
            Kódy a názvy podle exportu Rejstříku škol MŠMT z {schoolProgramsSnapshotDate}. Zápis oboru v rejstříku nepotvrzuje jeho otevření v konkrétním přijímacím řízení.
          </p>
          {activePrograms.length > 0 ? (
            <ul class="mt-4 grid gap-3 sm:grid-cols-2">
              {programRows.map((program) => (
                <li class="rounded-xl border border-border bg-card p-4">
                  <span class="text-xs font-semibold tracking-wide text-primary">{program.code}</span>
                  <p class="mt-1 font-medium text-foreground">{program.name}</p>
                  {program.admission && program.admission.capacity > 0 && (
                    <dl class="mt-3 space-y-1 border-t border-border pt-3 text-xs text-muted-foreground">
                      <div class="flex justify-between gap-2">
                        <dt>Přijímačky {cermatInfo.year}, 1. kolo</dt>
                        <dd class="font-semibold text-foreground">{program.admission.capacity} míst</dd>
                      </div>
                      <div class="flex justify-between gap-2">
                        <dt>Přihlášky / přijato</dt>
                        <dd class="font-semibold text-foreground">
                          {program.admission.applications} / {program.admission.admitted}
                          {demand(program.admission.applications, program.admission.capacity) && (
                            <span class="font-normal"> ({demand(program.admission.applications, program.admission.capacity)} na místo)</span>
                          )}
                        </dd>
                      </div>
                      {program.admission.percentileAvg !== null && (
                        <div class="flex justify-between gap-2">
                          <dt>Přijatí byli v průměru lepší než</dt>
                          <dd class="font-semibold text-foreground">{percentileText(program.admission.percentileAvg)} uchazečů</dd>
                        </div>
                      )}
                      {program.admission.percentileMin !== null && (
                        <div class="flex justify-between gap-2">
                          <dt>Nejslabší přijatý byl lepší než</dt>
                          <dd class="font-semibold text-foreground">{percentileText(program.admission.percentileMin)} uchazečů</dd>
                        </div>
                      )}
                      {!program.admission.entranceExam && <p>Bez jednotné přijímací zkoušky.</p>}
                    </dl>
                  )}
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-4 text-sm text-muted-foreground">V exportu není uveden žádný aktuálně evidovaný obor. Ověř nabídku přímo u školy.</p>
          )}
          {phasingOutPrograms.length > 0 && (
            <details class="mt-4 rounded-xl border border-border p-4">
              <summary class="cursor-pointer text-sm font-medium text-foreground">Zobrazit dobíhající obory ({phasingOutPrograms.length})</summary>
              <ul class="mt-3 grid gap-2 sm:grid-cols-2">
                {phasingOutPrograms.map((program) => (
                  <li class="rounded-lg bg-card p-3">
                    <span class="text-xs font-semibold tracking-wide text-muted-foreground">{program.code} · dobíhající</span>
                    <p class="mt-1 text-sm font-medium text-foreground">{program.name}</p>
                  </li>
                ))}
              </ul>
            </details>
          )}
          <p class="mt-4 text-xs leading-5 text-muted-foreground">
            Zdroj oborů: <a class="text-primary underline" href={programSource} target="_blank" rel="noreferrer">export Rejstříku škol MŠMT</a>, párování školy přes IZO {school.izo}.
            Přijímačky: <a class="text-primary underline" href={cermatInfo.admissionSource} target="_blank" rel="noopener">CERMAT</a>, jednotná přijímací zkouška
            z češtiny a matematiky v 1. kole. „Lepší než X % uchazečů“ znamená, že horší nebo stejný výsledek mělo X % všech uchazečů v ČR.
            Školní část přijímaček (pohovory, talentovky, známky) v datech není, proto to není přesná hranice pro přijetí.
          </p>
        </section>

        <div class="mt-5 rounded-2xl border border-dashed border-border bg-background/40 p-5 text-sm leading-6 text-muted-foreground">
          * Tematická oblast je orientační zařazení podle názvu školy.
          Rejstříková kapacita se vztahuje na celou školu, ne na počet míst v prvním ročníku.
          Aktuální přijímací podmínky, skutečné otevření oboru a školné ověř přímo u školy.
          <p class="mt-2">Zdroj údajů: <a class="text-primary underline" href={schoolSource} target="_blank" rel="noreferrer">Rejstřík škol MŠMT</a>, export {schoolSnapshotDate}.</p>
        </div>

        <section class="mt-8 rounded-2xl border-2 border-ink bg-lilac/60 p-5" aria-labelledby="inspection-heading">
          <h2 id="inspection-heading" class="text-sm font-semibold uppercase tracking-[0.18em] text-muted-foreground">Hodnocení školy</h2>

          {maturita && maturita.registered > 0 && (
            <div class="mt-4 rounded-xl border-2 border-ink bg-white p-4">
              <h3 class="font-display text-lg font-extrabold">Maturita {cermatInfo.year} (společná část)</h3>
              {cermat?.maturitaSharedByComponents && (
                <p class="mt-1 text-xs text-muted-foreground">Údaje jsou za celou školu jako právnickou osobu, včetně jejích dalších součástí.</p>
              )}
              <p class="mt-2 text-foreground">
                Úspěšně odmaturovalo <strong>{percent(maturita.successRate, 1)}</strong> z {maturita.registered} přihlášených žáků.
                Průměr celé ČR je {percent(cermatInfo.nationalMaturitaSuccessRate, 1)}.
              </p>
              {maturita.groups.length > 0 && (
                <table class="mt-3 w-full text-sm">
                  <thead>
                    <tr class="text-left text-xs text-muted-foreground">
                      <th class="py-1 font-medium">Skupina oborů</th>
                      <th class="py-1 text-right font-medium">Škola</th>
                      <th class="py-1 text-right font-medium">Průměr ČR</th>
                    </tr>
                  </thead>
                  <tbody>
                    {maturita.groups.map((group) => (
                      <tr class="border-t border-border">
                        <td class="py-1.5">{group.label} <span class="text-xs text-muted-foreground">({group.registered} žáků)</span></td>
                        <td class="py-1.5 text-right font-semibold">{percent(group.successRate, 1)}</td>
                        <td class="py-1.5 text-right text-muted-foreground">{percent(group.nationalSuccessRate, 1)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              )}
              <p class="mt-3 text-xs text-muted-foreground">
                Průměrný výsledek testu: čeština {percent(maturita.czechScore)}
                {maturita.mathScore !== null && <>, matematika {percent(maturita.mathScore)} (maturovalo z ní {percent(maturita.mathShare)} žáků)</>}.
                Srovnávej se stejnou skupinou oborů – gymnázia mají přirozeně vyšší úspěšnost než učiliště.
              </p>
            </div>
          )}

          {inspection && inspectionDate ? (
            <>
              <p class="mt-3 text-foreground">
                Česká školní inspekce školu naposledy navštívila <strong>{inspectionDate}</strong>
                {inspection.count > 1 && <> (celkem {inspection.count} {inspection.count < 5 ? "inspekční zprávy" : "inspekčních zpráv"})</>}.
              </p>
              <div class="mt-4 flex flex-wrap gap-3">
                {inspection.reportUrl && (
                  <a class="btn-outline px-4 py-2 text-sm" href={inspection.reportUrl} target="_blank" rel="noopener">📄 Inspekční zpráva (PDF)</a>
                )}
                {inspection.portalUrl && (
                  <a class="btn-outline px-4 py-2 text-sm" href={inspection.portalUrl} target="_blank" rel="noopener">Profil školy na portálu ČŠI</a>
                )}
              </div>
            </>
          ) : (
            <p class="mt-3 text-foreground">K této škole jsme v otevřených datech České školní inspekce nenašli žádnou inspekční zprávu.</p>
          )}
          <p class="mt-4 text-xs leading-5 text-muted-foreground">
            Inspekční zprávy jsou slovní hodnocení školy od státní inspekce, bez bodů či hvězdiček. Recenze žáků a rodičů
            nejsou k dispozici v žádném otevřeném zdroji, proto je neuvádíme.
            Zdroje: <a class="underline" href={inspectionSource} target="_blank" rel="noopener">otevřená data ČŠI</a>,
            <a class="underline" href={cermatInfo.maturitaSource} target="_blank" rel="noopener">CERMAT – výsledky maturit</a>
            (podíl úspěšných = žáci, kteří uspěli, ze všech přihlášených).
          </p>
        </section>

        {hasCoordinates ? (
          <section class="mt-8 rounded-2xl border-2 border-ink bg-white p-5" aria-labelledby="location-heading">
            <h2 id="location-heading" class="text-sm font-semibold uppercase tracking-[0.18em] text-muted-foreground">Mapa a vzdálenost</h2>
            <p class="mt-2 text-sm text-muted-foreground">Vzdálenost je vzdušnou čarou od zvoleného místa, nejde o délku ani čas cesty.</p>
            <div class="mt-4 flex flex-wrap gap-3">
              <label class="sr-only" for="home-region">Kraj, kde bydlíš</label>
              <select id="home-region" class="min-w-44 rounded-xl border-2 border-ink bg-white px-3 py-2.5 text-foreground">
                {REGIONS.map((region) => <option value={region} selected={region === school.region}>{region}</option>)}
              </select>
              <label class="sr-only" for="home-location-preset">Obec, kde bydlíš</label>
              <select id="home-location-preset" class="min-w-44 rounded-xl border-2 border-ink bg-white px-3 py-2.5 text-foreground">
                {regionTowns.map((town) => (
                  <option value={town.name} data-latitude={town.latitude} data-longitude={town.longitude} selected={town === defaultTown}>{town.name}</option>
                ))}
              </select>
              <button id="use-geolocation-btn" type="button" class="btn-outline">Použít moji polohu</button>
              <button id="open-map-location-btn" type="button" class="btn-outline">Zvolit místo na mapě</button>
            </div>
            <p id="location-status" class="mt-3 text-xs text-muted-foreground" aria-live="polite">Vyber obec, kde bydlíš, použij svou polohu nebo klikni do mapy.</p>
            <div class="mt-4 grid gap-4 md:grid-cols-[1fr_2fr]">
              <div class="rounded-2xl border border-primary/20 bg-primary/5 p-4">
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">Vzdušná vzdálenost</p>
                <p id="distance-output" class="mt-3 text-2xl font-extrabold text-foreground">—</p>
              </div>
              <div class="overflow-hidden rounded-2xl border border-border bg-card">
                <div id="home-map" class="h-80 w-full"></div>
              </div>
            </div>
            <div class="mt-5">
              <h3 class="text-sm font-semibold text-foreground">Další školy v okolí zvoleného místa</h3>
              <div id="nearby-schools-output" class="mt-3 grid gap-2 sm:grid-cols-2"></div>
            </div>
            <p class="mt-4 text-xs text-muted-foreground">Mapa používá OpenStreetMap. Souřadnice školy pocházejí z adresního místa RÚIAN.</p>
          </section>
        ) : (
          <section class="mt-8 rounded-2xl border-2 border-ink bg-white p-5">
            <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-muted-foreground">Poloha školy</h2>
            <p class="mt-2 text-sm text-muted-foreground">K této adrese se nepodařilo přiřadit souřadnice adresního místa RÚIAN, proto zde nelze spolehlivě zobrazit mapu ani vzdálenost.</p>
            <a class="mt-3 inline-block text-primary underline" href={`https://www.openstreetmap.org/search?query=${encodeURIComponent(school.address)}`} target="_blank" rel="noreferrer">Vyhledat adresu v OpenStreetMap</a>
          </section>
        )}

        <section class="mt-8 track-card p-5">
          <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-muted-foreground">Porovnat s jinou školou</h2>
          <div class="mt-4 grid gap-4 md:grid-cols-2">
            <label class="block">
              <span class="mb-2 block text-sm font-medium">První škola</span>
              <select id="compare-school-a" class="w-full rounded-xl border-2 border-ink bg-white px-3 py-2.5 text-foreground" disabled>
                <option value={school.id}>{school.name}</option>
              </select>
            </label>
            <label class="block">
              <span class="mb-2 block text-sm font-medium">Druhá škola</span>
              <select id="compare-school-b" class="w-full rounded-xl border-2 border-ink bg-white px-3 py-2.5 text-foreground" disabled>
                <option value="">Načítám školy…</option>
              </select>
            </label>
          </div>
          <div id="compare-details" class="mt-6 grid gap-4 md:grid-cols-2"></div>
        </section>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href={withBase("/test/")} class="btn-primary">Zkusit test zájmů</a>
          <a href={withBase("/skoly/")} class="btn-outline">Přejít na katalog</a>
          <a href={withBase("/oblibene/")} class="btn-outline">Moje oblíbené</a>
        </div>
      </article>
    </div>
  </section>

  {hasCoordinates && (
    <>
      <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
      <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    </>
  )}
  <div
    id="school-position-data"
    data-school-name={school.name}
    data-latitude={school.latitude ?? ""}
    data-longitude={school.longitude ?? ""}
    data-school-id={school.id}
    data-has-coordinates={String(hasCoordinates)}
    hidden
  ></div>
  <script>
    import { withBase } from "../../lib/urls";
    import {
      distanceKm,
      escapeHtml,
      formatDistance,
      getFavorites,
      loadSchools,
      toggleFavorite,
      type SchoolSummary,
    } from "../../lib/school-data";
    import towns from "../../data/towns.json";

    type GeolocatedSchool = SchoolSummary & { latitude: number; longitude: number };
    /* eslint-disable no-unused-vars */
    type LatLng = { lat: number; lng: number };
    type LeafletMap = {
      setView: (...args: [[number, number], number]) => LeafletMap;
      fitBounds: (...args: [[number, number][]]) => LeafletMap;
      on: (...args: ["click", (event: { latlng: LatLng }) => void]) => LeafletMap;
      invalidateSize(): void;
    };
    type LeafletMarker = {
      addTo: (...args: [LeafletMap]) => LeafletMarker;
      setLatLng: (...args: [[number, number]]) => LeafletMarker;
      bindPopup: (...args: [string]) => LeafletMarker;
      on: (...args: ["dragend", () => void]) => LeafletMarker;
      getLatLng(): LatLng;
    };
    type LeafletApi = {
      map: (...args: [string, { zoomControl: boolean; scrollWheelZoom: boolean }]) => LeafletMap;
      tileLayer: (...args: [string, { attribution: string; maxZoom: number }]) => { addTo: (...args: [LeafletMap]) => void };
      marker: (...args: [[number, number], { draggable: boolean }?]) => LeafletMarker;
    };
    /* eslint-enable no-unused-vars */
    type WindowWithLeaflet = Window & { L?: LeafletApi };


    document.addEventListener("astro:page-load", () => {
      const positionElement = document.getElementById("school-position-data") as HTMLElement | null;
      if (!positionElement) return;

      const schoolName = positionElement.dataset.schoolName ?? "Škola";
      const schoolId = positionElement.dataset.schoolId ?? "";
      const hasCoordinates = positionElement.dataset.hasCoordinates === "true";
      const schoolLatitude = Number(positionElement.dataset.latitude);
      const schoolLongitude = Number(positionElement.dataset.longitude);
      const selectA = document.getElementById("compare-school-a") as HTMLSelectElement | null;
      const selectB = document.getElementById("compare-school-b") as HTMLSelectElement | null;
      const compareOutput = document.getElementById("compare-details");
      const favoriteButton = document.getElementById("favorite-school-btn") as HTMLButtonElement | null;
      const distanceOutput = document.getElementById("distance-output");
      const nearbyOutput = document.getElementById("nearby-schools-output");
      const locationStatus = document.getElementById("location-status");
      const presetSelect = document.getElementById("home-location-preset") as HTMLSelectElement | null;
      const regionSelect = document.getElementById("home-region") as HTMLSelectElement | null;
      const geolocationButton = document.getElementById("use-geolocation-btn") as HTMLButtonElement | null;
      const mapLocationButton = document.getElementById("open-map-location-btn") as HTMLButtonElement | null;
      const mapElement = document.getElementById("home-map");

      let schoolList: SchoolSummary[] = [];
      const presetFrom = (option: HTMLOptionElement | undefined) => {
        const latitude = Number(option?.dataset.latitude);
        const longitude = Number(option?.dataset.longitude);
        return option && Number.isFinite(latitude) && Number.isFinite(longitude)
          ? { label: option.textContent ?? "", latitude, longitude }
          : null;
      };
      // Start at the school's own town (or the school itself) until the student picks a home.
      let activeHome = presetFrom(presetSelect?.selectedOptions[0]) ?? { label: schoolName, latitude: schoolLatitude, longitude: schoolLongitude };
      let map: LeafletMap | null = null;
      let homeMarker: LeafletMarker | null = null;
      const leaflet = (window as WindowWithLeaflet).L;

      const updateFavoriteButton = () => {
        if (!favoriteButton) return;
        const active = getFavorites().includes(schoolId);
        favoriteButton.classList.toggle("is-favorite", active);
        favoriteButton.setAttribute("aria-pressed", String(active));
        favoriteButton.classList.toggle("border-primary/50", active);
        favoriteButton.classList.toggle("bg-primary/10", active);
        favoriteButton.classList.toggle("text-primary", active);
        const icon = favoriteButton.querySelector(".favorite-icon");
        if (icon) icon.textContent = active ? "♥" : "♡";
      };

      const renderComparison = () => {
        if (!selectA || !selectB || !compareOutput || schoolList.length < 2) return;
        if (selectA.value === selectB.value) {
          selectB.value = schoolList.find((item) => item.id !== selectA.value)?.id ?? "";
        }
        const selectedSchools = [selectA.value, selectB.value]
          .map((id) => schoolList.find((item) => item.id === id))
          .filter((item): item is SchoolSummary => Boolean(item));
        compareOutput.innerHTML = selectedSchools.map((item) => {
          const rows: Array<[string, string]> = [
            ["Region", item.region],
            ["Typ v rejstříku", item.officialTypeCode === "D00" ? "Konzervatoř" : "Střední škola"],
            ["Zřizovatel", item.founder],
            ["Adresa", item.address],
            ["Kapacita celé školy", item.capacity || "V rejstříku neuvedena"],
            ["IZO", item.izo],
            ["RED-IZO", item.redIzo],
            ["IČO", item.ico],
            ["Telefon", item.phone || "Neuveden"],
            ["E-mail", item.email || "Neuveden"],
          ];
          return `<article class="rounded-2xl border-2 border-ink bg-white p-4">
            <h3 class="text-lg font-semibold">${escapeHtml(item.name)}</h3>
            <dl class="mt-4 space-y-3 text-sm">${rows.map(([label, value]) => `<div><dt class="font-medium text-foreground">${escapeHtml(label)}</dt><dd class="text-muted-foreground">${escapeHtml(value)}</dd></div>`).join("")}</dl>
          </article>`;
        }).join("");
      };

      const renderNearby = () => {
        if (!hasCoordinates || !nearbyOutput || !schoolList.length) return;
        const nearby = schoolList
          .filter((item): item is GeolocatedSchool =>
            item.id !== schoolId && item.latitude !== null && item.longitude !== null)
          .map((item) => ({
            id: item.id,
            name: item.name,
            distance: distanceKm(activeHome.latitude, activeHome.longitude, item.latitude, item.longitude),
          }))
          .sort((left, right) => left.distance - right.distance)
          .slice(0, 3);
        nearbyOutput.innerHTML = nearby.map((item) => `
          <a class="rounded-lg border-2 border-ink bg-white px-3 py-2 text-sm hover:border-primary/50" href="${withBase(`/skoly/${encodeURIComponent(item.id)}/`)}">
            <span class="font-medium">${escapeHtml(item.name)}</span>
            <span class="ml-1 text-muted-foreground">${formatDistance(item.distance)}</span>
          </a>`).join("") || '<span class="text-muted-foreground">V okolí nejsou další geolokované školy.</span>';
      };

      const renderDistance = () => {
        if (!hasCoordinates || !distanceOutput) return;
        distanceOutput.textContent = formatDistance(distanceKm(activeHome.latitude, activeHome.longitude, schoolLatitude, schoolLongitude));
        renderNearby();
      };

      /** Shows home and school; when they (almost) coincide, a fixed zoom instead of zero-size bounds. */
      const frameMap = () => {
        if (!map) return;
        if (distanceKm(activeHome.latitude, activeHome.longitude, schoolLatitude, schoolLongitude) < 0.3) {
          map.setView([schoolLatitude, schoolLongitude], 14);
        } else {
          map.fitBounds([[activeHome.latitude, activeHome.longitude], [schoolLatitude, schoolLongitude]]);
        }
      };

      const applyHomeLocation = (label: string, latitude: number, longitude: number) => {
        activeHome = { label, latitude, longitude };
        if (locationStatus) locationStatus.textContent = `Zvolené místo: ${label}. Vzdálenost je vzdušnou čarou.`;
        if (homeMarker && map) {
          homeMarker.setLatLng([latitude, longitude]);
          frameMap();
        }
        renderDistance();
      };

      // Students often commute from another region (Kladno -> Prague): any region's towns can be picked.
      regionSelect?.addEventListener("change", () => {
        if (!presetSelect) return;
        const regionTowns = towns
          .filter((town) => town.region === regionSelect.value)
          .sort((left, right) => left.name.localeCompare(right.name, "cs", { numeric: true }));
        presetSelect.replaceChildren(new Option("Vyber obec…", ""), ...regionTowns.map((town) => {
          const option = new Option(town.name, town.name);
          option.dataset.latitude = String(town.latitude);
          option.dataset.longitude = String(town.longitude);
          return option;
        }));
      });

      favoriteButton?.addEventListener("click", () => {
        toggleFavorite(schoolId);
        updateFavoriteButton();
      });
      selectA?.addEventListener("change", renderComparison);
      selectB?.addEventListener("change", renderComparison);
      presetSelect?.addEventListener("change", () => {
        const preset = presetFrom(presetSelect.selectedOptions[0]);
        if (preset) applyHomeLocation(preset.label, preset.latitude, preset.longitude);
      });
      geolocationButton?.addEventListener("click", () => {
        if (!navigator.geolocation) {
          if (locationStatus) locationStatus.textContent = "Tento prohlížeč geolokaci nepodporuje.";
          return;
        }
        if (locationStatus) locationStatus.textContent = "Získávám vaši polohu…";
        navigator.geolocation.getCurrentPosition(
          ({ coords }) => applyHomeLocation("Moje poloha", coords.latitude, coords.longitude),
          () => {
            if (locationStatus) locationStatus.textContent = "Polohu se nepodařilo získat. Zvol místo z nabídky nebo kliknutím do mapy.";
          },
          { enableHighAccuracy: true, timeout: 10000, maximumAge: 60000 },
        );
      });
      mapLocationButton?.addEventListener("click", () => {
        mapElement?.scrollIntoView({ behavior: "smooth", block: "center" });
        if (locationStatus) locationStatus.textContent = "Kliknutím do mapy nastav místo bydliště.";
      });

      if (hasCoordinates && mapElement && leaflet) {
        map = leaflet.map("home-map", { zoomControl: true, scrollWheelZoom: true });
        map.setView([activeHome.latitude, activeHome.longitude], 9);
        leaflet.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
          maxZoom: 19,
        }).addTo(map);
        leaflet.marker([schoolLatitude, schoolLongitude]).addTo(map).bindPopup(escapeHtml(schoolName));
        homeMarker = leaflet.marker([activeHome.latitude, activeHome.longitude], { draggable: true }).addTo(map);
        homeMarker.on("dragend", () => {
          const position = homeMarker?.getLatLng();
          if (position) applyHomeLocation("Vybrané místo na mapě", position.lat, position.lng);
        });
        map.on("click", ({ latlng }) => applyHomeLocation("Vybrané místo na mapě", latlng.lat, latlng.lng));
        frameMap();
        window.setTimeout(() => map?.invalidateSize(), 0);
      } else if (hasCoordinates && locationStatus) {
        locationStatus.textContent = "Mapu se nepodařilo načíst. Zkontroluj připojení a zkus stránku obnovit.";
      }

      updateFavoriteButton();
      renderDistance();

      loadSchools()
        .then((schools) => {
          schoolList = schools; // already sorted by name
          [selectA, selectB].forEach((select) => {
            if (!select) return;
            select.replaceChildren(...schoolList.map((item) => new Option(item.name, item.id)));
            select.disabled = false;
          });
          if (selectA) selectA.value = schoolId;
          if (selectB) selectB.value = schoolList.find((item) => item.id !== schoolId)?.id ?? "";
          renderComparison();
          renderNearby();
        })
        .catch(() => {
          if (compareOutput) compareOutput.innerHTML = '<p class="text-sm text-muted-foreground">Seznam škol pro porovnání se nepodařilo načíst. Zkus stránku obnovit.</p>';
          if (nearbyOutput) nearbyOutput.innerHTML = '<span class="text-muted-foreground">Okolní školy se nepodařilo načíst.</span>';
        });
    });
  </script>
</BaseLayout>
